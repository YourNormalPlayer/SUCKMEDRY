Quests:CreateSection("Auto quests")

Odyssey.questToggle = Quests:CreateToggle({
    Name = "Auto Quests",
    Description = "Takes and turns in quests from every NPC you can reach",
    Flag = "AutoQuests",
    Callback = function(on)
        QQ.on = on
        if not on then
            QuestField.name = nil Odyssey.fieldLock = nil
            QQ.mobNeed = {}
            QQ.firstPass = false
            F.drive("Quests", false)
            if Toggles.mobDrive then Toggles.mobDrive("Quests", false) end
            return
        end
        QQ.waitUntil, QQ.tries, QQ.firstPass = {}, {}, true
        task.spawn(function()
            while running and QQ.on do
                local msg = "Waiting for quests"
                local okQ, errQ = pcall(function()
                    if not QuestsMod or not NPCsMod then msg = "Loading the game's quest data..." return end
                    if not Odyssey:OdysseyMyHive() then msg = "Claim a hive first" return end
                    local todo = {}
                    for _, npc in ipairs(QUEST_NPCS) do
                        local picked = QQ.all or QQ.pick[npc]
                        if picked and not Odyssey:OdysseyNpcOpen(npc) then
                            QQ.skipped[npc] = "zone not unlocked (" .. tostring(NPC_BEES[npc]) .. " bees)"
                        elseif picked and TRANSLATOR[npc] and not Odyssey:OdysseyHasFlag(TRANSLATOR[npc]) then
                            QQ.skipped[npc] = "needs a translator"
                        elseif picked and npc == "Dapper Bear" and not Odyssey:OdysseyDapperShopOpen() then
                            QQ.skipped[npc] = select(2, Odyssey:OdysseyDapperShopOpen())
                        elseif picked then
                            local act, arg, why = Odyssey:OdysseyNpcAction(npc)
                            QQ.skipped[npc] = why
                            if act and arg then
                                if (QQ.waitUntil[npc] or 0) > os.clock() then
                                    QQ.skipped[npc] = "game didn't accept " .. act .. " - trying again in a few minutes"
                                else
                                    table.insert(todo, {npc = npc, act = act, arg = arg, first = act:find("Complete") and 0 or 1})
                                end
                            end
                        end
                    end
                    table.sort(todo, function(x, y) return x.first < y.first end)
                    QQ.pending = #todo > 0
                    local wasFirst = QQ.firstPass
                    if wasFirst then pcall(function() Odyssey.questToggle:SetDescription("Getting every quest you're allowed to (" .. #todo .. " NPCs)") end) end
                    for _, job in ipairs(todo) do
                        if not (running and QQ.on) then break end
                        if Toggles.mobOn and Toggles.mobOn() and Toggles.mobWaiting and os.clock() - Toggles.mobWaiting < 8 and not wasFirst then
                            msg = "Letting Auto Mobs kill a ready mob first"
                            break
                        end
                        local npc, act, arg = job.npc, job.act, job.arg
                        local key = act .. "|" .. tostring(arg)
                        local tr = QQ.tries[npc]
                        if tr and tr.key == key and tr.n >= 2 then
                            QQ.waitUntil[npc] = os.clock() + 300
                            QQ.tries[npc] = nil
                        else
                            local words = {}
                            local function visit()
                                for _ = 1, 6 do
                                    Odyssey:OdysseyFire(act, arg)
                                    table.insert(words, (act == "SelectNPCOption" and "Talked: " or (act:find("Complete") and "Turned in " or "Took ")) .. tostring(arg))
                                    -- after turning in, stay at the NPC until the next quest is ready to take (up to 8s)
                                    local wait = act:find("Complete") and 8 or 2.5
                                    local a2, g2
                                    local t0 = os.clock()
                                    repeat
                                        task.wait(0.5)
                                        a2, g2 = Odyssey:OdysseyNpcAction(npc)
                                    until (a2 and g2 and not (a2 == act and g2 == arg)) or os.clock() - t0 > wait or not (running and QQ.on)
                                    if not (a2 and g2) or (a2 == act and g2 == arg) then
                                        local _, _, why2 = Odyssey:OdysseyNpcAction(npc)
                                        QQ.log = QQ.log or {}
                                        table.insert(QQ.log, 1, os.date("%H:%M") .. " " .. npc .. ": " .. ((a2 == act and g2 == arg) and ("game didn't take " .. tostring(arg) .. " yet") or ("left - " .. tostring(why2 or "nothing else to take right now"))))
                                        while #QQ.log > 8 do table.remove(QQ.log) end
                                        break
                                    end
                                    act, arg = a2, g2
                                end
                                return true
                            end
                            -- in a quest field: only go turn in finished quests, take new ones after the field is done
                            Odyssey.questTurnIn = act:find("Complete") ~= nil
                            local done
                            if Odyssey.fieldLock and not Odyssey.questTurnIn then
                                done = false
                            else
                                done = Odyssey:OdysseyGoDo("Quests", Odyssey:OdysseyNpcSpot(npc), visit)
                            end
                            Odyssey.questTurnIn = false
                            if not done and QQ.firstPass and not Odyssey.fieldLock then
                                -- first run after turning it on: wait for whatever is busy, so no NPC gets skipped
                                local tWait = os.clock()
                                while not done and running and QQ.on and os.clock() - tWait < 90 do
                                    pcall(function() Odyssey.questToggle:SetDescription("Getting every quest · waiting for " .. tostring(Busy.who) .. " to finish") end)
                                    task.wait(1)
                                    done = Odyssey:OdysseyGoDo("Quests", Odyssey:OdysseyNpcSpot(npc), visit)
                                end
                            end
                            if done then
                                if tr and tr.key == key then tr.n += 1 else QQ.tries[npc] = {key = key, n = 1} end
                                for _, w in ipairs(words) do Window:Notify({Type = "Success", Title = npc, Content = w}) end
                                if Hook.quests and #words > 0 then Hook.send(npc, table.concat(words, "\n"), 0x3AD17A) end
                                msg = words[#words] or msg
                                local a3, g3 = Odyssey:OdysseyNpcAction(npc)
                                if not (a3 == job.act and g3 == job.arg) then QQ.tries[npc] = nil end
                            else
                                msg = "Waiting to go to " .. npc .. " (" .. tostring(Busy.who) .. ")"
                            end
                            task.wait(0.3)
                        end
                    end
                    QQ.pending = false
                    if wasFirst and QQ.on then
                        QQ.firstPass = false
                        Window:Notify({Type = "Success", Title = "Auto Quests", Content = "Went to every NPC you can reach and took all the quests you're allowed"})
                    end
                    if QQ.tasks then
                        local did = Odyssey:OdysseyDoItemTasks()
                        if #did > 0 then
                            msg = table.concat(did, ", ")
                            Window:Notify({Title = "Quest items", Content = msg})
                        end
                        local field, mobs, farm = Odyssey:OdysseyQuestNeeds()
                        QuestField.name = field
                        -- quest fields go one after another until every quest field task is done, then back to mobs
                        if Odyssey.fieldLock and Odyssey.fieldLock.field ~= field then
                            if field then Odyssey.fieldLock = {field = field, since = os.clock()} else Odyssey.fieldLock = nil end
                        end
                        QQ.mobNeed = mobs
                        F.drive("Quests", farm)
                        if Toggles.mobDrive then Toggles.mobDrive("Quests", next(mobs) ~= nil) end
                        local bits = {}
                        if field then table.insert(bits, "farming " .. field .. (QQ.itemFarm and (" leaves for " .. QQ.itemFarm) or "")) end
                        if QQ.easiest then table.insert(bits, "easiest first: " .. tostring(QQ.easiest)) end
                        if (QQ.questFields or 0) > 1 then table.insert(bits, QQ.questFields .. " quest fields left") end
                        for m in pairs(mobs) do table.insert(bits, "needs " .. m) end
                        if QQ.beeQueuedAt then table.insert(bits, "bee tasks on the next honey trip") end
                        if #bits > 0 then msg = table.concat(bits, " · ") end
                    else
                        QuestField.name = nil Odyssey.fieldLock = nil
                        QQ.mobNeed = {}
                        F.drive("Quests", false)
                        if Toggles.mobDrive then Toggles.mobDrive("Quests", false) end
                    end
                end)
                if not okQ then msg = "error: " .. tostring(errQ):sub(1, 80) end
                pcall(function() Odyssey.questToggle:SetDescription(msg) end)
                local t = os.clock()
                while running and QQ.on and os.clock() - t < 3 do task.wait(0.25) end
            end
            QuestField.name = nil Odyssey.fieldLock = nil
        end)
    end,
})

