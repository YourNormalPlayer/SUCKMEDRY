    FF.status = t
    pcall(function() Odyssey.ffToggle:SetDescription(t) end)
end

-- Chase fireflies: walks up to each landed firefly, then grabs the token they leave in the middle
function Odyssey:OdysseyChaseFireflies()
    if not (running and FF.on) or Odyssey.isHiveHub then return end
    local landed = Odyssey:OdysseyLandedFireflies()
    if #landed == 0 then
        if Odyssey:OdysseyIsNight() then Odyssey:OdysseyFireflyStatus("Night · waiting for fireflies to land") else Odyssey:OdysseyFireflyStatus("Waiting for night") end
        return
    end
    -- take over from everything else
    FF.run = true
    Busy.who, Busy.at = "Fireflies", os.clock()
    local ok, err = pcall(function()
        local center
        local t0 = os.clock()
        while running and FF.on and os.clock() - t0 < 120 do
            landed = Odyssey:OdysseyLandedFireflies()
            if #landed == 0 then break end
            local sum = Vector3.new()
            for _, f in ipairs(landed) do sum += f.pos end
            center = sum / #landed
            local r = Odyssey:OdysseyRoot()
            if not r then break end
            table.sort(landed, function(a, b) return (a.pos - r.Position).Magnitude < (b.pos - r.Position).Magnitude end)
            local f = landed[1]
            Odyssey:OdysseyFireflyStatus("Chasing fireflies in " .. f.field .. " · " .. #landed .. " left")
            Busy.at = os.clock()
            Odyssey:OdysseyTpTo(f.pos, true)
            task.wait(0.6)
        end
        -- the token they leave in the middle
        if center then
            Odyssey:OdysseyFireflyStatus("Grabbing the firefly token")
            local t1 = os.clock()
            while running and FF.on and os.clock() - t1 < 6 do
                local toks = Odyssey:OdysseyTokensIn(nil, center, 30)
                if #toks == 0 then task.wait(0.5) else
                    Odyssey:OdysseyTpTo(toks[1].part.Position, true)
                    task.wait(0.4)
                end
            end
        end
    end)
    FF.run = false
    if Busy.who == "Fireflies" then Busy.who = nil end
    FF.lastSeen = os.clock()
    Odyssey:OdysseyFireflyStatus(ok and "Done · waiting for the next landing" or ("Error: " .. tostring(err)))
end

