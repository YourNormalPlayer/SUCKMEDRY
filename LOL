serverHop = function()
    local ok, err = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
        local data = HS:JSONDecode(game:HttpGet(url))
        local pick = {}
        for _, sv in ipairs(data.data or {}) do
            if sv.id ~= game.JobId and (sv.playing or 0) < (sv.maxPlayers or 0) then table.insert(pick, sv.id) end
        end
        if #pick == 0 then error("no other servers with space") end
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, pick[math.random(1, #pick)], LP)
    end)
    if not ok then
        local ok2 = pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end)
        if not ok2 then Window:Notify({Type = "Error", Content = "Server hop: " .. tostring(err):sub(1, 80)}) end
    end
end
