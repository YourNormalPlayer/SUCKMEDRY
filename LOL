                        msg = "Collected " .. tostring(s.Recipe)
                        return
                    end
                    local needs = {}
                    for slot, it in pairs(SH.nextGear()) do
                        for _, c in ipairs(it.cost or {}) do
                            if c.Category == "Eggs" and c.Type then
                                local short_ = (tonumber(c.Amount) or 1) - Odyssey:OdysseyItemCount(tostring(c.Type))
                                if short_ > 0 then table.insert(needs, {item = tostring(c.Type), n = short_, gear = it.name}) end
                            end
                        end
                    end
                    if #needs == 0 then msg = "Your next gear doesn't need craftable items (or you have them)" return end
                    for _, nd in ipairs(needs) do
                        local n = Odyssey:OdysseyMaxCraft(nd.item, nd.n)
                        if n > 0 then
                            Odyssey:OdysseyGoDo("Blender", Odyssey:OdysseyToySpot("Blender"), function()
                                Odyssey:OdysseyFire("BlenderCommand", "PlaceOrder", {Recipe = nd.item, Count = n})
                                task.wait(1)
                                return true
                            end)
                            msg = "Crafting " .. n .. "x " .. nd.item .. " for " .. nd.gear
                            return
                        end
                    end
                    local nd = needs[1]
                    msg = nd.gear .. " needs " .. nd.n .. " more " .. nd.item .. " (can't craft it yet)"
                end)
                pcall(function() Odyssey.cToggle:SetDescription(msg) end)
                local t = os.clock()
                while running and S.craft and os.clock() - t < 30 do task.wait(0.5) end
            end
        end)
    end,
})

