-- Has flag
function Odyssey:OdysseyHasFlag(flag)
    StatToolsMod = StatToolsMod or Odyssey:OdysseyMod("StatTools")
    local st = Stats.all()
    if StatToolsMod and type(StatToolsMod.CheckReqs) == "function" then
        local ok, res = pcall(StatToolsMod.CheckReqs, st, {{Type = "Have Flags", Flags = {flag}}})
        if ok and type(res) == "boolean" then return res end
    end
    local fl = st.Flags
    if type(fl) ~= "table" then return false end
    if fl[flag] then return true end
    for _, v in pairs(fl) do if v == flag then return true end end
    return false
end

-- Dapper Bear's shop only lets you in wearing a Propeller Hat (or better) and Hiking Boots (or better),
-- and his quests need that shop - so his quests wait until you can get in
function Odyssey:OdysseyDapperShopOpen()
    if not Odyssey:OdysseyShopOpen("DapperItemShop") then return false, "his zone isn't unlocked" end
    local eq = Stats.all().EquippedAccessories
    local hat, boots
    for k, v in pairs(type(eq) == "table" and eq or {}) do
        if type(v) == "string" then
