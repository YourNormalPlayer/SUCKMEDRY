        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("GuiButton") and not (myGui and g:IsDescendantOf(myGui)) then
                local sg = g:FindFirstAncestorOfClass("ScreenGui")
                local sz = g.AbsoluteSize
                if sg and sz.X >= 25 and sz.X <= 100 and sz.Y >= 25 and sz.Y <= 100 and math.abs(sz.X - sz.Y) <= 20 then
                    local off = sg.IgnoreGuiInset and Vector2.zero or inset
                    local pos = g.AbsolutePosition + off
                    if pos.Y + sz.Y / 2 < inset.Y + 80 and pos.X < half and shown(g) then
                        local r = pos.X + sz.X
                        if not right or r > right then right, midY = r, pos.Y + sz.Y / 2 end
                    end
                end
            end
        end
        if not right then return false end
        local myOff = (myGui and myGui.IgnoreGuiInset) and Vector2.zero or inset
        local h = orb.AbsoluteSize.Y > 0 and orb.AbsoluteSize.Y or 50
        orb.Position = UDim2.fromOffset(right + 8 - myOff.X, midY - h / 2 - myOff.Y)
        return true
    end
    -- the game's menu loads in after joining, so keep trying for a bit
    for _ = 1, 30 do
        if place() then break end
        task.wait(2)
    end
    local cam = workspace.CurrentCamera
    if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() task.wait(0.5) pcall(place) end) end
end)

