-- Claim hive
function Odyssey:OdysseyClaimHive()
    if Odyssey:OdysseyMyHive() then return true, "You already have a hive" end
    local hc = workspace:FindFirstChild("Honeycombs")
    if not hc then return false, "Hives not found" end
    -- closest free hive first: in the Hive Hub only the hub's hives can be claimed, not the ones on the main map
    local list = hc:GetChildren()
    local r = Odyssey:OdysseyRoot()
    local function dist(h) local ok, p = pcall(function() return h:GetPivot().Position end) return (ok and p and r) and (p - r.Position).Magnitude or math.huge end
    table.sort(list, function(a, b) return dist(a) < dist(b) end)
    for _, h in ipairs(list) do
        local o, id = h:FindFirstChild("Owner"), h:FindFirstChild("HiveID")
        if o and id and o.Value == nil and not (Odyssey.isHiveHub and dist(h) > 3000) then
            local spot = Odyssey:OdysseyHiveSpot(h)
            if spot then Odyssey:OdysseyTpTo(spot) task.wait(0.5) end
            Odyssey:OdysseyFire("ClaimHive", id.Value)
            for _ = 1, 15 do if Odyssey:OdysseyMyHive() then return true, "Claimed hive " .. id.Value end task.wait(0.1) end
            -- the game's own sender didn't take it: send the claim straight to the server
            local ev = Events and Events:FindFirstChild("ClaimHive")
            if ev and ev:IsA("RemoteEvent") then pcall(ev.FireServer, ev, id.Value) end
            for _ = 1, 20 do if Odyssey:OdysseyMyHive() then return true, "Claimed hive " .. id.Value end task.wait(0.1) end
        end
    end
    return false, "No free hive"
end

