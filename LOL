-- Search results
function Odyssey:OdysseySearch(win, q)
    local page = win._searchPage
    for _, c in ipairs(page.frame:GetChildren()) do if c:IsA("TextButton") or c.Name == "Empty" then c:Destroy() end end
    q = tostring(q or ""):lower()
    if q == "" then
        if win._beforeSearch then Odyssey:OdysseyOpenPage(win, win._beforeSearch) end
        win._beforeSearch = nil
        return
    end
    if win._current ~= page then win._beforeSearch = win._current end
    Odyssey:OdysseyOpenPage(win, page)
    local n = 0
    for _, it in ipairs(win._searchItems) do
        if it.row and it.row.Parent and (it.name:lower():find(q, 1, true) or it.desc:lower():find(q, 1, true)) then
            n += 1
            if n > 60 then break end
            local tabName = it.page and tostring(it.page.Name):gsub("^Page_", "") or "?"
            local secName = it.sec and tostring(it.sec.Name):gsub("^Section_", "") or ""
            local b = Odyssey:OdysseyNew("TextButton", {AutoButtonColor = false, Text = "", BackgroundColor3 = C.panel, Size = UDim2.new(1, -14, 0, 34),
                LayoutOrder = n, Parent = page.frame})
            Odyssey:OdysseyCorner(b, 5)
            Odyssey:OdysseyStroke(b)
            Odyssey:OdysseyText({Text = it.name, Size = 12, Pos = UDim2.new(0, 9, 0, 3), Sz = UDim2.new(1, -18, 0, 15), Parent = b})
            Odyssey:OdysseyText({Text = tabName .. (secName ~= "" and (" › " .. secName) or ""), Size = 10, Color = C.muted,
                Pos = UDim2.new(0, 9, 0, 18), Sz = UDim2.new(1, -18, 0, 13), Parent = b})
            b.MouseButton1Click:Connect(function()
                for _, p in ipairs(win._pages) do
                    if p.frame == it.page then
                        win._searchBox.Text = ""
                        win._beforeSearch = nil
                        if p.root and table.find(p.root.cards, it.sec) then p.subSel = Odyssey:OdysseyShownUnder(p, it.sec) end
                        Odyssey:OdysseyOpenPage(win, p)
                        Odyssey:OdysseyApplySub(win, p)
                        Odyssey:OdysseyScrollTo(win, p, it.sec, it.row)
                        break
                    end
                end
            end)
        end
    end
    if n == 0 then
        Odyssey:OdysseyText({Name = "Empty", Text = "Nothing matches \"" .. q .. "\"", Size = 11, Color = C.muted, Parent = page.frame})
    end
end

