-- F · try micro
F.tryMicro = function()
    if not F.micro or Odyssey:OdysseyItemCount("Micro-Converter") < 1 or os.clock() - X.lastMicro < 5 then return false end
    X.lastMicro = os.clock()
    local p0 = Odyssey:OdysseyPollen()
    if not Odyssey:OdysseyUseItem("Micro-Converter") then return false end
    for _ = 1, 20 do
        task.wait(0.15)
        if Odyssey:OdysseyPollen() < p0 * 0.5 then return true end
    end
    return Odyssey:OdysseyPollen() < p0
end

-- hive balloon
function Odyssey:OdysseyMyBalloon()
    local b = workspace:FindFirstChild("Balloons")
    local hb = b and b:FindFirstChild("HiveBalloons")
    for _, inst in ipairs(hb and hb:GetChildren() or {}) do
        for _, d in ipairs(inst:GetDescendants()) do
            if (d:IsA("StringValue") and d.Value == LP.Name) or (d:IsA("ObjectValue") and d.Value == LP) then return inst end
        end
    end
    local spot = Odyssey:OdysseyHiveSpot()
    if spot then
        for _, inst in ipairs(hb and hb:GetChildren() or {}) do
            local body = inst:FindFirstChild("BalloonBody", true)
            if body and body:IsA("BasePart") and (body.Position - spot).Magnitude < 60 then return inst end
        end
    end
    return nil
end

-- Parse amount
function Odyssey:OdysseyParseAmount(s)
    s = tostring(s or ""):gsub(",", "")
    local num, suf = s:match("([%d%.]+)%s*([KkMmBbTt]?)")
    num = tonumber(num)
    if not num then return nil end
    local mult = ({k = 1e3, m = 1e6, b = 1e9, t = 1e12})[(suf or ""):lower()] or 1
    return num * mult
end

-- Balloon pollen
function Odyssey:OdysseyBalloonPollen()
    if os.clock() - X.bAt < 2 then return X.bCache end
    local inst = Odyssey:OdysseyMyBalloon()
    local best = 0
    for _, d in ipairs(inst and inst:GetDescendants() or {}) do
        if d:IsA("TextLabel") then
            local v = Odyssey:OdysseyParseAmount(d.Text)
            if v and v > best then best = v end
        end
    end
    X.bCache, X.bAt = best, os.clock()
    return best
end

-- F · balloon big
F.balloonBig = function()
    return (F.balloonAt or 0) > 0 and Odyssey:OdysseyBalloonPollen() >= F.balloonAt
end

-- F · balloon wait
F.balloonWait = function(keepGoing)
    local hive = Odyssey:OdysseyMyHive()
    local last, lastDrop, lastToggle = Odyssey:OdysseyBalloonPollen(), os.clock(), os.clock()
    local t = os.clock()
    while running and keepGoing() and os.clock() - t < 240 do
        X.bAt = -1e9
        local bp = Odyssey:OdysseyBalloonPollen()
        if bp <= 0 or not Odyssey:OdysseyMyBalloon() then break end
        if bp < last then lastDrop = os.clock() end
        last = bp
        if fStatus then fStatus("Converting your balloon · " .. Odyssey:OdysseyShort(bp) .. " left") end
        local ph = hive and hive:FindFirstChild("Phase")
        local okP, v = pcall(function() return ph.Value end)
        if os.clock() - lastDrop > 8 and os.clock() - lastToggle > 8 and (not okP or v == nil or v == "Idle") then
            Odyssey:OdysseyFire("PlayerHiveCommand", "ToggleHoneyMaking")
            lastToggle, lastDrop = os.clock(), os.clock()
        end
        if os.clock() - lastDrop > 30 then break end
        task.wait(0.5)
    end
end

