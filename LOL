-- Owned gear
function Odyssey:OdysseyOwnedGear(slot)
    local st = Stats.all()
    local seen, names = {}, {}
    local function add(n)
        if type(n) == "string" and n ~= "" and not seen[n] then seen[n] = true table.insert(names, n) end
    end
    -- everything the shops sell, plus anything already in your stats
    local shops = workspace:FindFirstChild("Shops")
    for _, d in ipairs(shops and shops:GetDescendants() or {}) do
        if d:IsA("BasePart") and d:FindFirstChild("ItemCategory") and d:FindFirstChild("ItemType") then add(d.Name) end
    end
    for _, key in ipairs({"Accessories", "Collectors", "Backpacks", "EquippedAccessories"}) do
        local t = st[key]
        for k, v in pairs(type(t) == "table" and t or {}) do
            add(type(k) == "string" and k or nil)
            add(type(v) == "string" and v or nil)
        end
    end
    local list = {}
    for _, n in ipairs(names) do
        local sl = Odyssey:OdysseySlotOf(n) or (n:lower():find("goggles") and "Hat")
        if sl == slot then
            local pack = Odyssey:OdysseyGearPack(n, slot)
            local ok, has = pcall(IPMod.PlayerHas, pack, st)
            if ok and has then
                table.insert(list, {name = n, pack = pack, on = Odyssey:OdysseyEquipped(pack, st)})
            end
        end
    end
    table.sort(list, function(a, b) return a.name < b.name end)
    return list
end

