end

-- F · on arrive
F.onArrive = function()
    if F.glitter and os.clock() - X.lastGlitter > 905 and Odyssey:OdysseyItemCount("Glitter") > 0 then
        if Odyssey:OdysseyUseItem("Glitter") then X.lastGlitter = os.clock() end
    end
    if F.dice and os.clock() - X.lastDice > 900 and Odyssey:OdysseyItemCount(F.dice) > 0 then
