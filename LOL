-- Walk to
function Odyssey:OdysseyWalkTo(pos, maxT, keepGoing)
    local h, r = Odyssey:OdysseyHum(), Odyssey:OdysseyRoot()
    if not (h and r) then return end
    h:MoveTo(pos)
    local t = os.clock()
    while running and os.clock() - t < (maxT or 3) do
        if keepGoing and not keepGoing() then return end
        r = Odyssey:OdysseyRoot()
        if not r then return end
        local d = (r.Position - pos) * Vector3.new(1, 0, 1)
        if d.Magnitude < 4 then return end
        task.wait(0.1)
    end
end

-- Token score
function Odyssey:OdysseyTokenScore(t)
    local score = 0
    pcall(function()
        if tostring(t.BrickColor) == "Pastel blue-green" then score = 1 end
        for _, d in ipairs(t:GetChildren()) do
            if d:IsA("Decal") then
                local id = tostring(d.Texture):match("%d+")
                if id and RARE_TOKENS[id] then score = 2 break end
            end
        end
    end)
    return score
end

-- Token claimed
function Odyssey:OdysseyTokenClaimed(t, r)
    local cl = Odyssey.claimedTok
    if cl[t] then return true end
    -- the game says this token id was collected
    local id = t:GetAttribute("ID") or tonumber(t.Name)
    if id and Odyssey.claimedIds[tostring(id)] then cl[t] = true return true end
    -- it moved from where it appeared = it's flying to whoever claimed it
    -- real tokens are gone within about 30s: one still there after 40s is stuck / decoration - never go for it
    local at = Odyssey.tokFirstAt[t]
    if not at then Odyssey.tokFirstAt[t] = os.clock()
    elseif os.clock() - at > 40 then cl[t] = true return true end
    local first = Odyssey.tokFirstPos[t]
    if not first then Odyssey.tokFirstPos[t] = t.Position
    else
        -- (sideways or far up only - tokens spin and bob a little in place)
        local mv = t.Position - first
        if (mv * Vector3.new(1, 0, 1)).Magnitude > 1.5 or math.abs(mv.Y) > 4 then cl[t] = true return true end
    end
    -- you're standing on it = you just claimed it
    if r and ((t.Position - r.Position) * Vector3.new(1, 0, 1)).Magnitude < 3 and math.abs(t.Position.Y - r.Position.Y) < 6 then cl[t] = true return true end
    return false
end

-- Tokens in
function Odyssey:OdysseyTokensIn(part, near, radius)
    local list = {}
    local col = workspace:FindFirstChild("Collectibles")
    local r = Odyssey:OdysseyRoot()
    if not (col and r) then return list end
    for _, t in ipairs(col:GetChildren()) do
        if t:IsA("BasePart") and t.Transparency < 1 and not Odyssey:OdysseyTokenClaimed(t, r) then
            local ok = part and Odyssey:OdysseyInField(part, t.Position, 4) or (near and (t.Position - near).Magnitude <= (radius or 40))
            if ok then
                table.insert(list, {part = t, d = (t.Position - r.Position).Magnitude, s = tokenPrio and Odyssey:OdysseyTokenScore(t) or 0})
            end
        end
    end
    table.sort(list, function(a, b) if a.s ~= b.s then return a.s > b.s end return a.d < b.d end)
    return list
end

-- Cur field
function Odyssey:OdysseyCurField()
    if Odyssey.isHiveHub then return "Hub Field" end
    if Odyssey.fieldLock and Odyssey:OdysseyFieldPart(Odyssey.fieldLock.field) and Odyssey:OdysseyFieldOpen(Odyssey.fieldLock.field) then return Odyssey.fieldLock.field end
    if F.eventField and F.eventField.untilT > os.clock() and Odyssey:OdysseyFieldPart(F.eventField.name) and Odyssey:OdysseyFieldOpen(F.eventField.name) then return F.eventField.name end
    if QuestField.name and Odyssey:OdysseyFieldPart(QuestField.name) and Odyssey:OdysseyFieldOpen(QuestField.name) then return QuestField.name end
    if F.sprouts and F.sproutField then
        local sf = F.sproutField()
        if sf and Odyssey:OdysseyFieldOpen(sf) then return sf end
    end
    if F.leaves and F.leafField and Odyssey:OdysseyFieldPart(F.leafField) and Odyssey:OdysseyFieldOpen(F.leafField) then return F.leafField end
    if F.followBoost and F.boost and F.boost.untilT > os.clock() and Odyssey:OdysseyFieldPart(F.boost.field) and Odyssey:OdysseyFieldOpen(F.boost.field) then return F.boost.field end
    if F.rotate and #F.rotList > 0 then
        local list = {}
        for _, n in ipairs(F.rotList) do if Odyssey:OdysseyFieldOpen(n) then table.insert(list, n) end end
        if #list > 0 then
            local idx = math.floor((os.clock() - F.rotStart) / (F.rotMin * 60)) % #list + 1
            return list[idx]
        end
    end
    if Odyssey:OdysseyFieldOpen(F.field) then return F.field end
    return "Sunflower Field"
end

-- Toy ready
function Odyssey:OdysseyToyReady(name)
    local toys = workspace:FindFirstChild("Toys")
    local m = toys and toys:FindFirstChild(name)
    if not m then return false end
    local cd = m:FindFirstChild("Cooldown")
    local cdv = cd and tonumber(cd.Value) or 0
    local tt = Stats.all().ToyTimes
    local last = type(tt) == "table" and tonumber(tt[name]) or nil
    if not last then return true end
    return Odyssey:OdysseyNow() >= last + cdv, (last + cdv) - Odyssey:OdysseyNow()
end

-- Toy spot
function Odyssey:OdysseyToySpot(name)
    local toys = workspace:FindFirstChild("Toys")
    local m = toys and toys:FindFirstChild(name)
    local p = m and m:FindFirstChild("Platform")
    if p and p:IsA("BasePart") then return p.Position end
    if m then local ok, v = pcall(function() return m:GetPivot().Position end) if ok then return v end end
    return nil
end

-- Use toy
function Odyssey:OdysseyUseToy(name, back)
    local spot = Odyssey:OdysseyToySpot(name)
    if not spot then return false, "not found" end
    local before = Stats.all().ToyTimes
    before = type(before) == "table" and before[name] or nil
    Odyssey:OdysseyTpTo(spot, Odyssey.converting)
    task.wait(0.6)
    Odyssey:OdysseyFire("ToyEvent", name)
    local ok = false
    for _ = 1, 25 do
        local tt = Stats.all().ToyTimes
        if type(tt) == "table" and tt[name] and tt[name] ~= before then ok = true break end
        task.wait(0.1)
    end
    if back then Odyssey:OdysseyTpTo(back) end
    return ok
end

-- Inv key
function Odyssey:OdysseyInvKey(name)
    local inv = Stats.all().Eggs
    if type(inv) ~= "table" then return nil, nil end
    for _, k in ipairs({name, (name:gsub("[%s%-]", ""))}) do
        if inv[k] ~= nil then return k, tonumber(inv[k]) or 0 end
    end
    return (name:gsub("[%s%-]", "")), 0
end

-- Item count
function Odyssey:OdysseyItemCount(name)
    local _, c = Odyssey:OdysseyInvKey(name)
    return c
end

-- Use item
function Odyssey:OdysseyUseItem(name)
    local key = Odyssey:OdysseyInvKey(name) or name
    local def = EggTypes and type(EggTypes.Get) == "function" and select(2, pcall(EggTypes.Get, key)) or nil
    local pa = type(def) == "table" and def.PlayerActive or nil
    if type(pa) == "table" and type(pa.CanActivate) == "function" then
        local ok, can = pcall(pa.CanActivate, pa)
        if ok and can == false then return false end
    end
    local nm = (type(pa) == "table" and pa.Name) or name
    Odyssey:OdysseyFire("PlayerActivesCommand", {Name = nm})
    return true
end

-- Hatch timer text
function Odyssey:OdysseyHatch_fmt(sec)
    sec = math.max(0, math.ceil(tonumber(sec) or 0))
    if sec >= 3600 then return math.floor(sec / 3600) .. "h " .. math.floor(sec % 3600 / 60) .. "m" end
    if sec >= 60 then return math.floor(sec / 60) .. "m " .. (sec % 60) .. "s" end
    return sec .. "s"
end

