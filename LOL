-- Notification
function Odyssey:OdysseyNotify(win, o)
    if type(o) ~= "table" then o = {Content = tostring(o)} end
    local holder = win._notes
    local color = NOTIFY_COLORS[o.Type] or C.accent
    local n = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.side, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = math.floor(os.clock() * 1000) % 2000000000, Parent = holder})
    Odyssey:OdysseyCorner(n, 6)
    local st = Odyssey:OdysseyStroke(n)
    st.Transparency = 1
    local stripe = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = color, Size = UDim2.new(0, 3, 1, -12), Position = UDim2.new(0, 6, 0, 6),
        BackgroundTransparency = 1, Parent = n})
    Odyssey:OdysseyCorner(stripe, 2)
    local body = Odyssey:OdysseyNew("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = n})
    Odyssey:OdysseyPad(body, 8, 10, 8, 16)
    Odyssey:OdysseyList(body, 2)
    local t = Odyssey:OdysseyText({Text = tostring(o.Title or win.name), Font = FONT_BOLD, Size = 12, Color = C.white, Order = 1, Parent = body})
    local c = Odyssey:OdysseyText({Text = tostring(o.Content or ""), Size = 11, Color = C.muted, Wrap = true, Order = 2,
        Sz = UDim2.new(1, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Parent = body})
    t.TextTransparency, c.TextTransparency = 1, 1
    Odyssey:OdysseyTween(n, 0.2, {BackgroundTransparency = 0.05})
    Odyssey:OdysseyTween(st, 0.2, {Transparency = 0})
    Odyssey:OdysseyTween(stripe, 0.2, {BackgroundTransparency = 0})
    Odyssey:OdysseyTween(t, 0.2, {TextTransparency = 0})
    Odyssey:OdysseyTween(c, 0.2, {TextTransparency = 0})
    task.delay(tonumber(o.Duration) or 4, function()
        pcall(function()
            for _, x in ipairs({{n, "BackgroundTransparency"}, {stripe, "BackgroundTransparency"}, {t, "TextTransparency"}, {c, "TextTransparency"}, {st, "Transparency"}}) do
                Odyssey:OdysseyTween(x[1], 0.25, {[x[2]] = 1})
            end
            task.wait(0.3)
            n:Destroy()
        end)
    end)
    -- at most 5 on screen
    local kids = {}
    for _, k in ipairs(holder:GetChildren()) do if k:IsA("Frame") then table.insert(kids, k) end end
    table.sort(kids, function(a, b) return a.LayoutOrder > b.LayoutOrder end)
    for i = 6, #kids do kids[i]:Destroy() end
end

-- Yes / no box
