-- Equip gear
function Odyssey:OdysseyEquipGear(name)
    name = tostring(name or ""):gsub(" %(on%)$", "")
    local slot = EQ_SLOTS[EQ.slot] or "Collector"
    for _, it in ipairs(Odyssey:OdysseyOwnedGear(slot)) do
        if it.name == name then
            if it.on then return true, name .. " is already on" end
            local ok, res = Odyssey:OdysseyFire("ItemPackageEvent", "Equip", it.pack)
            task.wait(0.4)
            return ok and res ~= false, (ok and res ~= false) and ("Equipped " .. name) or ("Couldn't equip " .. name)
