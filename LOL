            if kl == "hat" or l:find("mask") or l:find("hat") or l:find("helmet") or l:find("goggles") then hat = hat or l end
            if kl == "boots" or l:find("boot") or l:find("clog") then boots = boots or l end
        end
    end
    local hatOk = hat ~= nil and not (hat:find("helmet") or hat:find("goggles") or hat:find("bbm") or hat:find("bubble bee man"))
    local bootsOk = boots ~= nil and not boots:find("basic")
    if hatOk and bootsOk then return true end
    return false, "his shop isn't unlocked - wear a Propeller Hat (or better) and Hiking Boots (or better)"
end

