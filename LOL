                n += 1
                local b = Odyssey:OdysseyNew("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = sel[opt] and C.hover or C.item,
                    Size = UDim2.new(1, -4, 0, 22), LayoutOrder = i, Parent = listBox})
                Odyssey:OdysseyCorner(b, 4)
                Odyssey:OdysseyText({Text = s, Size = 11, Color = sel[opt] and C.white or C.text, Sz = UDim2.new(1, -26, 1, 0), Pos = UDim2.new(0, 8, 0, 0), Parent = b})
                if sel[opt] then
                    Odyssey:OdysseyText({Text = "✓", Size = 12, Color = C.accent, Sz = UDim2.new(0, 16, 1, 0), Anchor = Vector2.new(1, 0),
                        Pos = UDim2.new(1, -4, 0, 0), AlignX = Enum.TextXAlignment.Center, Parent = b})
                end
                b.MouseButton1Click:Connect(function()
                    if multi then
                        local list, found = {}, false
                        for _, v in ipairs(el.CurrentOption) do
                            if v == opt then found = true else table.insert(list, v) end
                        end
                        if not found then table.insert(list, opt) end
                        el.CurrentOption = list
                    else
                        el.CurrentOption = opt
                        dropWrap.Visible = false
                        arrow.Text = "▾"
                    end
                    fire()
                    build()
                end)
            end
        end
        listBox.Size = UDim2.new(1, 0, 0, math.min(n, maxVis) * 24)
        search.Visible = #el.Options > 8
    end
    fire = function(quiet)
        el.Value = el.CurrentOption
        drawShown()
        Odyssey:OdysseySetFlag(win, o.Flag, multi and Odyssey:OdysseyCopy(el.CurrentOption) or el.CurrentOption)
        if not quiet then Odyssey:OdysseySafe(o.Callback, multi and Odyssey:OdysseyCopy(el.CurrentOption) or el.CurrentOption) end
    end
    search:GetPropertyChangedSignal("Text"):Connect(build)
    box.MouseButton1Click:Connect(function()
        dropWrap.Visible = not dropWrap.Visible
        arrow.Text = dropWrap.Visible and "▴" or "▾"
        if dropWrap.Visible then build() end
    end)
    local function clean(v)
        if multi then
            if type(v) ~= "table" then v = v ~= nil and {v} or {} end
            return Odyssey:OdysseyCopy(v)
        end
        if type(v) == "table" then v = v[1] end
        return v
    end
    function el:Set(v, quiet)
        if type(v) == "table" and v.CurrentOption ~= nil then v = v.CurrentOption end
        el.CurrentOption = clean(v)
        fire(quiet)
        if dropWrap.Visible then build() end
    end
    function el:Refresh(list, keep)
        el.Options = Odyssey:OdysseyCopy(type(list) == "table" and list or {})
        -- picks stay as they are (lists often fill in after the saved picks load)
        drawShown()
        if dropWrap.Visible then build() end
    end
    function el:GetValue() return el.CurrentOption end
    Odyssey:OdysseyBase(el, row, desc)
    Odyssey:OdysseyIndex(sec, row, o.Name, o.Description)
    el.Options = Odyssey:OdysseyCopy(o.Options)
    local saved = Odyssey:OdysseySaved(win, o.Flag)
    if saved ~= nil then
        el:Set(saved)
    else
        el.CurrentOption = clean(o.CurrentOption)
        if not multi and el.CurrentOption == "" then el.CurrentOption = nil end
        fire(true)
    end
    return el
end

-- Input
function Odyssey:OdysseyInput(page, o)
    local win = page.win
    local sec = Odyssey:OdysseyTarget(page, o)
    local row = Odyssey:OdysseyRow(sec, 0, true, true)
    local holder = Odyssey:OdysseyNew("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row})
    Odyssey:OdysseyList(holder, 4)
    Odyssey:OdysseyPad(holder, 6, 8, 7, 8)
    Odyssey:OdysseyText({Text = tostring(o.Name or ""), Size = 12, Order = 1, Parent = holder})
    local desc = Odyssey:OdysseyText({Text = tostring(o.Description or ""), Size = 10, Color = C.muted, Wrap = true, Order = 2,
        Sz = UDim2.new(1, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Parent = holder})
    desc.Visible = (o.Description or "") ~= ""
    local tb = Odyssey:OdysseyNew("TextBox", {BackgroundColor3 = C.dark, PlaceholderText = tostring(o.PlaceholderText or ""), PlaceholderColor3 = C.dim,
        Text = "", ClearTextOnFocus = false, FontFace = FONT, TextSize = 11, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3, Parent = holder})
    Odyssey:OdysseyCorner(tb, 4)
    Odyssey:OdysseyStroke(tb)
    Odyssey:OdysseyPad(tb, 0, 8, 0, 8)
    local el = {Value = "", CurrentValue = ""}
    function el:Set(v, quiet)
        if type(v) == "table" then v = v.CurrentValue or v.Text end
        v = tostring(v or "")
        tb.Text = v
        el.Value, el.CurrentValue = v, v
        Odyssey:OdysseySetFlag(win, o.Flag, v)
        if not quiet then Odyssey:OdysseySafe(o.Callback, v) end
    end
    function el:GetValue() return tb.Text end
    tb.FocusLost:Connect(function(enter)
        if o.Enter and not enter then return end
        local v = tb.Text
        if o.Numeric then v = tostring(tonumber(v) or "") end
        el:Set(v)
        if o.RemoveTextAfterFocusLost then tb.Text = "" end
    end)
    Odyssey:OdysseyBase(el, row, desc)
    Odyssey:OdysseyIndex(sec, row, o.Name, o.Description)
    -- a saved value is shown in the box; the script reads it from Flags (it isn't sent to the callback on load)
    local saved = Odyssey:OdysseySaved(win, o.Flag)
    local start = saved ~= nil and tostring(saved) or tostring(o.CurrentValue or "")
    tb.Text = start
    el.Value, el.CurrentValue = start, start
    if o.Flag then Odyssey.Flags[o.Flag] = start end
    return el
end

-- Keybind
function Odyssey:OdysseyBind(page, o)
    local win = page.win
    local sec = Odyssey:OdysseyTarget(page, o)
    local row = Odyssey:OdysseyRow(sec, 28, true, true)
    local _, desc = Odyssey:OdysseyNameBlock(row, o.Name, o.Description, 90)
    local keyBox = Odyssey:OdysseyNew("TextButton", {AutoButtonColor = false, BackgroundColor3 = C.dark, FontFace = FONT_MED, TextSize = 11,
        TextColor3 = C.accent, Text = "", AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 40, 0, 20), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0), Parent = row})
    Odyssey:OdysseyCorner(keyBox, 4)
    Odyssey:OdysseyStroke(keyBox)
    Odyssey:OdysseyPad(keyBox, 0, 8, 0, 8)
    local el = {}
    local listening = false
    function el:Set(v)
        if type(v) == "table" then v = v.CurrentKeybind end
        el.Key = Odyssey:OdysseyKeyFrom(v)
        el.CurrentKeybind = el.Key and el.Key.Name or "None"
        keyBox.Text = el.CurrentKeybind
        Odyssey:OdysseySetFlag(win, o.Flag, el.CurrentKeybind)
    end
    function el:GetValue() return el.CurrentKeybind end
    keyBox.MouseButton1Click:Connect(function()
        listening = true
        keyBox.Text = "..."
    end)
    table.insert(win._conns, UIS.InputBegan:Connect(function(i, gp)
        if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if listening then
            listening = false
            if i.KeyCode == Enum.KeyCode.Escape or i.KeyCode == Enum.KeyCode.Backspace then el:Set("None") else el:Set(i.KeyCode) end
            return
        end
        if gp or UIS:GetFocusedTextBox() then return end
        if el.Key and i.KeyCode == el.Key then Odyssey:OdysseySafe(o.Callback, el.Key) end
    end))
    Odyssey:OdysseyBase(el, row, desc)
    Odyssey:OdysseyIndex(sec, row, o.Name, o.Description)
    local saved = Odyssey:OdysseySaved(win, o.Flag)
    el:Set(saved ~= nil and saved or o.CurrentKeybind or "None")
    return el
end

