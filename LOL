-- SH · next gear
function SH.nextGear()
    local st = Stats.all()
    local out = {}
    for _, sh in ipairs(GEAR_SHOPS) do
        for _, it in ipairs(Odyssey:OdysseyShopUsable(sh) and Odyssey:OdysseyShopItems(sh) or {}) do
            local slot = Odyssey:OdysseySlotOf(it.name)
            if slot and SH.slots[slot] and it.cost and not Odyssey:OdysseyOwns(it.pack, st) then
                local best = out[slot]
                local hc = Odyssey:OdysseyHoneyCost(it.cost)
                local ownedBest = -1
                if not best or hc < Odyssey:OdysseyHoneyCost(best.cost) then
                    for _, it2 in ipairs(Odyssey:OdysseyShopItems(sh)) do
                        if Odyssey:OdysseySlotOf(it2.name) == slot and Odyssey:OdysseyOwns(it2.pack, st) then ownedBest = math.max(ownedBest, Odyssey:OdysseyHoneyCost(it2.cost)) end
                    end
                    if hc > ownedBest then out[slot] = it end
                end
            end
        end
    end
    return out
end

