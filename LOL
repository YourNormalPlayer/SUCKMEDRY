-- ========== Functions · Helpers ==========

-- Game code can hand the thread back with less access (after a game function waits).
-- The menu lives in a protected spot, so put the access back before making anything
local getId = getthreadidentity or get_thread_identity or (syn and syn.get_thread_identity)
local setId = setthreadidentity or set_thread_identity or (syn and syn.set_thread_identity)
function Odyssey:OdysseyAccess()
    if not (getId and setId) then return end
    local ok, id = pcall(getId)
    if ok and type(id) == "number" and id < 7 then pcall(setId, 8) end
end

-- New instance with properties
function Odyssey:OdysseyNew(class, props, kids)
    Odyssey:OdysseyAccess()
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then o[k] = v end
    end
    for _, k in ipairs(kids or {}) do k.Parent = o end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

