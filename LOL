-- ========== Functions · Server ==========

-- Hook · send
function Hook.send(title, desc, color, fields)
    if Hook.url == "" or not Hook.url:find("^https://") or type(httpReq) ~= "function" then return false end
    local body = HS:JSONEncode({username = "Odyssey", embeds = {{title = title, description = desc, color = color or 0xF5B83D, fields = fields,
        footer = {text = "Odyssey · Bee Swarm Simulator · " .. LP.Name}, timestamp = DateTime.now():ToIsoDate()}}})
    -- one message at a time with a short gap (Discord rejects bursts), and up to 4 tries if Discord is busy or the request drops
    while Hook.sending do task.wait(0.2) end
    Hook.sending = true
    local gap = (Hook.lastSent or 0) + 0.8 - os.clock()
    if gap > 0 then task.wait(gap) end
    local okAll, why = false, "unknown"
    for try = 1, 4 do
        local ok, res = pcall(httpReq, {Url = Hook.url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
        Hook.lastSent = os.clock()
        local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.Status) or 0
        if ok and (code == 0 or (code >= 200 and code < 300)) then okAll = true break end
        if ok and (code == 401 or code == 403 or code == 404) then why = "Discord said " .. code .. " (the webhook was deleted or the link is wrong)" break end
        local retryAfter = 2 * try
        if ok and code == 429 then
            pcall(function() retryAfter = math.clamp((tonumber(HS:JSONDecode(res.Body).retry_after) or 2) + 0.2, 0.5, 30) end)
        end
        why = ok and ("Discord said " .. tostring(code)) or tostring(res)
        task.wait(retryAfter)
    end
    Hook.sending = false
    if not okAll then warn("[Odyssey] webhook didn't send: " .. tostring(why)) end
    return okAll
end

