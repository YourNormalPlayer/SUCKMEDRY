-- moves your old saved files from "OdysseyBeeSwarm" into "Odyssey Hub/Bee Swarm Simulator" (copies once, old files stay)
do
    pcall(function()
        if not (isfolder and makefolder and listfiles and readfile and writefile and isfile) then return end
        local OLD, NEW, SKIP = "OdysseyBeeSwarm", "Odyssey Hub/Bee Swarm Simulator", {}
        local function ensure(p)
            local cur = ""
            for part in p:gmatch("[^/]+") do cur = cur == "" and part or (cur .. "/" .. part) if not isfolder(cur) then makefolder(cur) end end
        end
        ensure(NEW)
        if not isfolder(OLD) or isfile(NEW .. "/.moved") then return end
        local function copy(from, to, depth)
            if depth > 6 then return end
            ensure(to)
            for _, p in ipairs(listfiles(from)) do
                p = p:gsub("\\", "/")
                local name = p:match("([^/]+)$")
                if name and not SKIP[name] then
                    local src = from .. "/" .. name
                    if isfolder(src) then copy(src, to .. "/" .. name, depth + 1)
                    elseif not isfile(to .. "/" .. name) then pcall(function() writefile(to .. "/" .. name, readfile(src)) end) end
                end
            end
        end
        copy(OLD, NEW, 0)
        writefile(NEW .. "/.moved", "files copied from " .. OLD)
    end)
end
