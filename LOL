-- Disp run
function Odyssey:OdysseyDispRun()
    local nextIn
    for _, name in ipairs(DISPENSERS) do
        if not (running and D.on) then break end
        if D.pick[name] and not NOT_AUTO[name] and Odyssey:OdysseyToyOpen(name) and (D.failUntil[name] or 0) < os.clock() and Odyssey:OdysseyToySpot(name) then
            local ready, left = Odyssey:OdysseyToyReady(name)
            if ready then
                if Busy.take("Dispensers") then
                    local r = Odyssey:OdysseyRoot()
                    local back = r and r.Position
                    pcall(function() Odyssey.dispToggle:SetDescription("Using " .. (NICE[name] or name)) end)
                    local ok = Odyssey:OdysseyUseToy(name, nil)
                    if ok and name == "Honeystorm" and D.storm ~= false then
                        pcall(function() Odyssey.dispToggle:SetDescription("Collecting Honeystorm tokens") end)
                        local spot = Odyssey:OdysseyToySpot(name)
                        local t = os.clock()
                        while running and D.on and spot and os.clock() - t < 30 do
                            local tk = Odyssey:OdysseyTokensIn(nil, spot, 90)
                            local r = Odyssey:OdysseyRoot()
                            if tk[1] and r then Odyssey:OdysseyWalkTo(Vector3.new(tk[1].part.Position.X, r.Position.Y, tk[1].part.Position.Z), 2) else task.wait(0.4) end
                        end
                    end
                    if Busy.who == "Dispensers" and not F.active() and back then Odyssey:OdysseyTpTo(back) end
                    Busy.free("Dispensers")
                    if ok then
                        Window:Notify({Type = "Success", Title = "Dispensers", Content = "Used " .. (NICE[name] or name)})
                    else
                        D.failUntil[name] = os.clock() + 600
                    end
                    task.wait(0.5)
                else
                    return "Waiting · " .. tostring(Busy.who)
                end
            elseif left and (not nextIn or left < nextIn) then
                nextIn = left
            end
        end
    end
    if nextIn then
        local m = math.max(0, math.floor(nextIn / 60))
        return "Next one ready in " .. (m >= 60 and (math.floor(m / 60) .. "h " .. (m % 60) .. "m") or (m .. "m"))
    end
    return "Waiting for cooldowns"
end

