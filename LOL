-- Sort the sidebar: Home, game tabs by Group then Order, Settings last
function Odyssey:OdysseySortTabs(win)
    local rank = {Game = 0, Player = 5}
    local list = {}
    for _, p in ipairs(win._pages) do
        if p.kind == "tab" and not p.settings then table.insert(list, p) end
    end
    table.sort(list, function(a, b)
        local ga, gb = rank[a.group] or 1, rank[b.group] or 1
        if ga ~= gb then return ga < gb end
        if a.order ~= b.order then return a.order < b.order end
        return a.idx < b.idx
    end)
    for i, p in ipairs(list) do p.button.LayoutOrder = 10 + i end
end

-- Keep both columns as tall as the page so panels reach the bottom.
-- Works out the size once (no resetting first), so it never flickers or keeps resizing itself
function Odyssey:OdysseyFill(win, page)
    local root = page.root
    if not root or page.filling then return end
    -- safety: if it keeps firing (layout fighting itself), back off instead of hogging the game
    local now = os.clock()
    if now - (page.fillWindow or 0) > 1 then page.fillWindow, page.fillCount = now, 0 end
    page.fillCount = (page.fillCount or 0) + 1
    if page.fillCount > 8 then return end
    page.filling = true
    task.delay(0.1, function()
        page.filling = false
        local sf = page.frame
        if not sf.Visible then return end
        local s = (win.Scale and win.Scale.Scale) or 1
        local avail = sf.AbsoluteSize.Y / s - 14
        for _, col in ipairs(root.cols) do
            local kids = {}
            for _, card in ipairs(col:GetChildren()) do
                if card:IsA("Frame") and card.Visible then table.insert(kids, card) end
            end
            table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
            local total = 0
            for i, card in ipairs(kids) do
                local body = card:FindFirstChild("Body")
                local f = body and body:FindFirstChild("Fill")
                local h = f and f.Size.Y.Offset or 0
                if i < #kids and h ~= 0 then
                    f.Size = UDim2.new(1, 0, 0, 0)
                    h = 0
                end
                total += card.AbsoluteSize.Y / s - h
            end
            total += 6 * math.max(0, #kids - 1)
            local last = kids[#kids]
            if last then
                local body = last:FindFirstChild("Body")
                local f = body and body:FindFirstChild("Fill")
                if body and not f then
                    f = Odyssey:OdysseyNew("Frame", {Name = "Fill", BackgroundTransparency = 1, LayoutOrder = 99999, Size = UDim2.new(1, 0, 0, 0), Parent = body})
                end
                local want = math.floor(math.max(0, avail - total - 4))
                if f and math.abs(f.Size.Y.Offset - want) > 4 then f.Size = UDim2.new(1, 0, 0, want) end
            end
        end
    end)
end

-- Which top tab a section is under
function Odyssey:OdysseyGroupOf(card)
    local g = card:GetAttribute("Sub")
    if type(g) == "string" and g ~= "" then return g end
    return nil
end

-- Top tabs of a page in order (empty = this tab has none)
function Odyssey:OdysseyGroups(page)
    local list, seen = {}, {}
    for _, card in ipairs(page.root and page.root.cards or {}) do
        local g = Odyssey:OdysseyGroupOf(card)
        if g and not seen[g] then seen[g] = true table.insert(list, g) end
    end
    return list
end

-- The top tab a section shows under (sections nobody grouped go with the first top tab)
function Odyssey:OdysseyShownUnder(page, card)
    return Odyssey:OdysseyGroupOf(card) or Odyssey:OdysseyGroups(page)[1]
end

-- Tabs in tabs: only the sections under the picked top tab show (in both columns when they use both)
function Odyssey:OdysseyApplySub(win, page)
    local root = page.root
    if not root or #root.cards == 0 then return end
    -- every tab looks like Farm: sections in two columns side by side (never one long full-width list)
    root.cols[1].Size = UDim2.new(0.5, -3, 0, 0)
    root.cols[2].Visible = true
    root.colsFrame.Visible = true
    local groups = Odyssey:OdysseyGroups(page)
    if #groups == 0 then
        page.subSel = nil
    elseif not table.find(groups, page.subSel) then
        page.subSel = groups[1]
    end
    local shown, usesCol = {}, {}
    for _, card in ipairs(root.cards) do
        if (#groups == 0) or Odyssey:OdysseyShownUnder(page, card) == page.subSel then
            table.insert(shown, card)
            usesCol[math.clamp(card:GetAttribute("Col") or 1, 1, 2)] = true
        end
    end
    -- all in one column? share them out over both so the page stays two columns
    local split = not (usesCol[1] and usesCol[2])
    local k = 0
    for i, card in ipairs(root.cards) do
        local on = table.find(shown, card) ~= nil
        card.Visible = on
        if on then
            k += 1
            local col = split and ((k % 2 == 1) and 1 or 2) or math.clamp(card:GetAttribute("Col") or 1, 1, 2)
            card.Parent = root.cols[col]
            card.LayoutOrder = i
        end
        card:SetAttribute("Wide", false)
    end
    if #groups > 0 then page.frame.CanvasPosition = Vector2.new(0, 0) end
    Odyssey:OdysseyFill(win, page)
    for _, card in ipairs(root.cards) do Odyssey:OdysseyGrid(card) end
end

-- Put sections into their columns (also used by scripts after moving sections around)
function Odyssey:OdysseyRelayout(win, compact)
    for _, root in ipairs(win._roots) do
        for i, card in ipairs(root.cards) do
            card.Parent = root.cols[math.clamp(card:GetAttribute("Col") or 1, 1, 2)]
            card.LayoutOrder = i
        end
        if root.colsFrame then root.colsFrame.Visible = #root.cards > 0 end
    end
    for _, p in ipairs(win._pages) do
        if p.root then Odyssey:OdysseyApplySub(win, p) end
    end
    if win._current then Odyssey:OdysseyBuildHeader(win) end
end

