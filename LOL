-- Rarity of
function Odyssey:OdysseyRarityOf(t)
    HV.bt = HV.bt or Odyssey:OdysseyMod("BeeTypes")
    if not HV.bt then return nil end
    local ok, names = pcall(function() return HV.bt:GetRarityNames() end)
    for _, r in ipairs(ok and type(names) == "table" and names or {}) do
        local ok2, list = pcall(function() return HV.bt:GetTypesOfRarity(r) end)
        if ok2 and type(list) == "table" then
            for k, v in pairs(list) do if v == t or k == t then return r end end
        end
    end
    return nil
end

-- Build file matches
function Odyssey:OdysseyMatches(file)
    if type(file) ~= "table" or not file.Type then return false end
    local wantTypes = {}
    for w in RJ.types:gmatch("[^,]+") do wantTypes[(w:gsub("^%s+", ""):gsub("%s+$", "")):lower()] = true end
    local typeOk = (next(wantTypes) == nil) or wantTypes[tostring(file.Type):lower()] or wantTypes[(tostring(file.Type) .. " bee"):lower()]
    local rarOk = (next(RJ.rar) == nil) or RJ.rar[Odyssey:OdysseyRarityOf(file.Type) or ""]
    local giftOk = (not RJ.gifted) or Odyssey:OdysseyIsGifted(file)
    return typeOk and rarOk and giftOk and true or false
end

