        Pos = UDim2.new(1, -10, 0, 0), Sz = UDim2.new(0.4, 0, 1, 0), Parent = foot})
    local function drawKey() keyText.Text = "Toggle UI: " .. Odyssey:OdysseyKeyName(win.toggleKey) .. " · Lib v" .. Odyssey.Version end
    drawKey()

    -- notifications
    win._notes = Odyssey:OdysseyNew("Frame", {Name = "Notifications", BackgroundTransparency = 1, Size = UDim2.new(0, 270, 1, -24),
        AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Parent = gui})
