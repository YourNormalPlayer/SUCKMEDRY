-- Fireflies: the game's flying things whose name says firefly
function Odyssey:OdysseyFireflies(deep)
    local out = {}
    MB.lfe = MB.lfe or Odyssey:OdysseyMod("LocalFlyingEntity")
    local L = MB.lfe
    if L and type(L.GetEntities) == "function" then
        local ok, list = pcall(L.GetEntities)
        if not (ok and type(list) == "table") then ok, list = pcall(L.GetEntities, L) end
        for _, e in pairs(ok and type(list) == "table" and list or {}) do
            local tag = ""
            pcall(function()
                for _, k in ipairs({"Type", "Name", "EntityType", "Kind", "MonsterType"}) do
                    if type(e[k]) == "string" then tag = tag .. e[k] end
                end
                local m = e.Model or e.Instance or e.Part
                if typeof(m) == "Instance" then tag = tag .. m.Name end
            end)
            if tag:lower():find("firefl") then
                local pos
                pcall(function() pos = L.GetPos(e) end)
                if typeof(pos) ~= "Vector3" then pcall(function() pos = e:GetPos() end) end
                if typeof(pos) == "Vector3" then table.insert(out, pos) end
            end
        end
    end
    if #out > 0 then return out end
    -- the models themselves
    FF.folders = FF.folders or {}
    for _, f in ipairs(FF.folders) do
        for _, d in ipairs(f.Parent and f:GetChildren() or {}) do
            if d.Name:lower():find("firefl") then
                local ok, p = pcall(function() return d:IsA("BasePart") and d.Position or d:GetPivot().Position end)
                if ok and p then table.insert(out, p) end
            end
        end
    end
    if #out == 0 and deep and (not FF.searched or os.clock() - FF.searched > 15) then
        -- look everywhere once in a while and remember where they live
        FF.searched = os.clock()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name:lower():find("firefl") and d.Parent and not table.find(FF.folders, d.Parent) then
                table.insert(FF.folders, d.Parent)
            end
        end
    end
    return out
end

-- Landed fireflies: the ones sitting on a firefly field (not flying)
function Odyssey:OdysseyLandedFireflies()
    local out = {}
    for _, pos in ipairs(Odyssey:OdysseyFireflies(Odyssey:OdysseyIsNight())) do
        for _, n in ipairs(FIREFLY_FIELDS) do
            local fp = Odyssey:OdysseyFieldPart(n)
            if fp and Odyssey:OdysseyInField(fp, pos, 4) and pos.Y - (fp.Position.Y + fp.Size.Y / 2) < 6 then
                table.insert(out, {pos = pos, field = n})
                break
            end
        end
    end
    return out
end

-- Firefly status
