-- Farm run
function Odyssey:OdysseyFarmLoop(gen)
    local function keepGoing() return running and F.active() and farmGen == gen end
    local function needConvert()
        if Odyssey:OdysseyCapacity() > 0 and Odyssey:OdysseyPollen() >= Odyssey:OdysseyCapacity() * (F.convertAt / 100) then return true end
        return F.balloonBig ~= nil and F.balloonBig() == true
    end
    local lastSprinkler, lastField = 0, nil
    while keepGoing() do
        if Busy.who and Busy.who ~= "Farm" then
            fStatus("Paused · " .. Busy.who)
            task.wait(0.5)
        elseif not Odyssey:OdysseyMyHive() then
            if F.autoClaim then
                local _, msg = Odyssey:OdysseyClaimHive()
                fStatus(msg)
                task.wait(2)
            else
                fStatus("Claim a hive first")
                task.wait(2)
            end
        else
            local fieldName = Odyssey:OdysseyCurField()
            local part = Odyssey:OdysseyFieldPart(fieldName)
            local r = Odyssey:OdysseyRoot()
            local h = Odyssey:OdysseyHum()
            if not (part and r) then
                fStatus(part and "Waiting for your character" or ("Can't find " .. fieldName))
                task.wait(1)
            elseif F.healthLeave > 0 and h and h.MaxHealth > 0 and h.Health / h.MaxHealth * 100 < F.healthLeave then
                Busy.take("Farm")
                fStatus("Low health · healing at your hive")
                local spot = Odyssey:OdysseyHiveSpot()
                if spot then Odyssey:OdysseyTpTo(spot) end
                local t = os.clock()
                while keepGoing() and os.clock() - t < 90 do
                    local hh = Odyssey:OdysseyHum()
                    if not hh or hh.Health / math.max(hh.MaxHealth, 1) >= 0.95 then break end
                    task.wait(1)
                end
                Busy.free("Farm")
                lastField = nil
            elseif needConvert() and not Busy.take("Farm") then
                fStatus("Bag full · waiting for " .. tostring(Busy.who) .. " to finish")
                task.wait(0.5)
            elseif needConvert() and F.tryMicro and F.tryMicro() then
                fStatus("Used a Micro-Converter")
                Busy.free("Farm")
            elseif not needConvert() and not Odyssey.fieldLock and Odyssey.OdysseyMobReadyAny and Odyssey:OdysseyMobReadyAny() then
                -- a mob Auto Mobs wants (picked or for a quest) is off cooldown: mobs first, farm again once they're all on cooldown
                fStatus("Doing mobs first · " .. tostring(Odyssey:OdysseyMobReadyAny()) .. " is ready")
                task.wait(0.5)
            elseif needConvert() then
                fStatus("Bag full · going to make honey")
                local prevHat
                if F.honeyMask then
                    prevHat = F.currentHat()
                    if prevHat ~= "Honey Mask" then F.equipByName("Honey Mask") else prevHat = nil end
                end
                local h0 = Odyssey:OdysseyHoney()
                local _, msg = Odyssey:OdysseyConvertHoney(keepGoing)
                local fx = F.fx
                if fx.lastF then fx.honey[fx.lastF] = (fx.honey[fx.lastF] or 0) + math.max(0, Odyssey:OdysseyHoney() - h0) end
                if prevHat then F.equipByName(prevHat) end
                fStatus(msg)
                Busy.free("Farm")
                lastField = nil
            else
                if lastField ~= fieldName or not Odyssey:OdysseyInField(part, r.Position, 10) then
                    -- a mob here is off cooldown (it spawns when you walk in): wait just outside the field for your
                    -- bees first. Every mob here on cooldown: teleport straight in
                    local sp, mt = nil, nil
                    if Odyssey.OdysseyFieldMobReady and Odyssey.waitBees ~= false then sp, mt = Odyssey:OdysseyFieldMobReady(part) end
                    if sp and not Odyssey:OdysseyInField(part, r.Position, 40) then
                        local from = r.Position
                        local outside = Odyssey:OdysseyOutsideSpot(part, 20, from)
                        if outside then
                            Odyssey:OdysseyTpTo(outside)
                            Odyssey:OdysseyWaitForBees(keepGoing, function(n, need)
                                fStatus(("%s can spawn in %s · waiting outside for your bees (%d/%d)"):format(tostring(mt), fieldName, n, need))
                            end, from)
                        end
                    end
                    Odyssey:OdysseyTpTo(Odyssey:OdysseyFieldCenter(part))
                    task.wait(0.5)
                    lastField = fieldName
                    if F.sprinkler and os.clock() - lastSprinkler > 30 then
                        lastSprinkler = os.clock()
                        Odyssey:OdysseyFire("PlayerActivesCommand", {Name = "Sprinkler Builder"})
                        local rr = Odyssey:OdysseyRoot()
                        if rr then F.fx.sprPos, F.fx.sprField = rr.Position, fieldName end
                    end
                    if F.onArrive then pcall(F.onArrive, fieldName) end
                end
                -- with Dodge on, never pick a spot near a mob or walk a path that passes by one
                local mobs = F.dodge and F.mobsIn(part) or {}
                local function unsafe(pos) return #mobs > 0 and pos and F.pathNearMob(r.Position, pos, mobs) end
                -- Teleport to tokens: only for tokens that are far away (walks to close ones), at most once every 1.5s
                if F.tpTokens and F.tokens and os.clock() - (F.fx.lastTokTp or 0) > 1.5 then
                    for _, t in ipairs(Odyssey:OdysseyTokensIn(part)) do
                        local tp = t.part
                        if tp.Parent and tp.Transparency < 1 and not (#mobs > 0 and F.pathNearMob(tp.Position, tp.Position, mobs)) then
                            if (tp.Position - r.Position).Magnitude > 25 then
                                F.fx.lastTokTp = os.clock()
                                Odyssey:OdysseyTpTo(tp.Position)
                                task.wait(0.2)
                                r = Odyssey:OdysseyRoot() or r
                            end
                            break
                        end
                    end
                end
                local target, best = nil, -1
                if F.tokens then
                    for _, t in ipairs(Odyssey:OdysseyTokensIn(part)) do
                        if not unsafe(t.part.Position) then
                            -- chasing the same token for 4s and it's still there (can't reach it / already claimed): ignore it
                            local ch = F.chase
                            if ch and ch.part == t.part then
                                if os.clock() - ch.since > 4 then Odyssey.claimedTok[t.part] = true F.chase = nil continue end
                            else
                                F.chase = {part = t.part, since = os.clock()}
                            end
                            target, best = t.part.Position, t.s
                            break
                        end
                    end
                end
                if best < 2 and F.extraTarget then
                    local okX, x = pcall(F.extraTarget, part)
                    if okX and x and not unsafe(x) then target = x end
                end
                if not target then
                    for _ = 1, 8 do
                        local pt = F.point(part, fieldName)
                        if not unsafe(pt) then target = pt break end
                    end
                end
                if not target and #mobs > 0 then target = F.safeSpot(part) end
                target = target or F.point(part, fieldName)
                if F.dodge then target = F.dodgeFrom(part) or target end
                do
                    local fx, t = F.fx, os.clock()
                    if fx.lastT and fx.lastF == fieldName then fx.time[fieldName] = (fx.time[fieldName] or 0) + math.min(t - fx.lastT, 10) end
                    fx.lastT, fx.lastF = t, fieldName
                end
                -- farming the field a quest needs: stay here until that task is done
                if QuestField.name and fieldName == QuestField.name then
                    if not (Odyssey.fieldLock and Odyssey.fieldLock.field == fieldName) then Odyssey.fieldLock = {field = fieldName, since = os.clock()} end
                end
                fStatus((Odyssey.fieldLock and "Quest field · " or "Farming ") .. fieldName .. " · " .. Odyssey:OdysseyShort(Odyssey:OdysseyPollen()) .. " / " .. Odyssey:OdysseyShort(Odyssey:OdysseyCapacity()))
                local swinging = true
                if F.swing then
                    task.spawn(function()
                        while swinging and keepGoing() do swing() task.wait(0.1) end
                    end)
                end
                Odyssey:OdysseyWalkTo(Vector3.new(target.X, r.Position.Y, target.Z), 2.5, keepGoing)
                swinging = false
            end
        end
        task.wait()
    end
    Busy.free("Farm")
end

-- F · active
function F.active() return F.on or next(F.drivers) ~= nil end

-- F · sync
function F.sync()
    if running and F.active() then
        if not farmRunning then
            farmRunning = true
            farmGen += 1
            local g = farmGen
            task.spawn(function()
                local ok, err = pcall(function(...) return Odyssey:OdysseyFarmLoop(...) end, g)
                if not ok then pcall(function() Odyssey.farmToggle:SetDescription("error: " .. tostring(err):sub(1, 60)) end) end
                if farmGen == g then farmRunning = false end
            end)
        end
    elseif farmRunning then
        farmRunning = false
        farmGen += 1
        Busy.free("Farm")
        local h = Odyssey:OdysseyHum()
        local r = Odyssey:OdysseyRoot()
        if h and r then h:MoveTo(r.Position) end
    end
end

-- F · drive
function F.drive(who, on)
    on = on and true or nil
    if F.drivers[who] == on then return end
    F.drivers[who] = on
    F.sync()
end

-- leaves are "LeafBurst" sparkles on a flower in Workspace.Flowers (scan 4)
function Odyssey:OdysseyTrack2(d)
    if d.Name == "LeafBurst" and d:IsA("ParticleEmitter") then
        if d.Parent and d.Parent:IsA("BasePart") then X.leaves[d] = true end
        return
    end
    if not d:IsA("BasePart") then return end
    local n = d.Name
    if n == "PetalPart" then
        X.petals[d] = true
    elseif n == "Meteor" and d.Parent and d.Parent.Name == "Particles" then
        X.meteors[d] = os.clock()
    end
end

-- Pos of
function Odyssey:OdysseyPosOf(x)
    if x:IsA("ParticleEmitter") then
        local pp = x.Parent
        return pp and pp:IsA("BasePart") and (pp.Position + Vector3.new(0, pp.Size.Y / 2, 0)) or nil
    end
    if x.Transparency >= 1 then return nil end
    return x.Position
end

-- Nearest in
function Odyssey:OdysseyNearestIn(set, part, pos, radius)
    local r = Odyssey:OdysseyRoot()
    if not r then return nil end
    local best, bd
    for p in pairs(set) do
        if not p.Parent then
            set[p] = nil
        else
            local pp = Odyssey:OdysseyPosOf(p)
            local ok = pp and ((part and Odyssey:OdysseyInField(part, pp, 4)) or (pos and (pp - pos).Magnitude <= (radius or 40)))
            if ok then
                local d = (pp - r.Position).Magnitude
                if not bd or d < bd then best, bd = pp, d end
            end
        end
    end
    return best
end

-- Count in
function Odyssey:OdysseyCountIn(set, part)
    local n = 0
    for p in pairs(set) do
        local pp = p.Parent and Odyssey:OdysseyPosOf(p)
        if pp and Odyssey:OdysseyInField(part, pp, 4) then n += 1 end
    end
    return n
end

-- Bubble or flame
function Odyssey:OdysseyBubbleOrFlame(part)
    local pf = workspace:FindFirstChild("Particles")
    local r = Odyssey:OdysseyRoot()
    if not (pf and r) then return nil end
    local best, bd
    for _, c in ipairs(pf:GetChildren()) do
        local n = c.Name
        local want = (F.bubbles and n == "Bubble") or (F.flames and (n:find("Flame") ~= nil or n == "PFire" or n == "Fire"))
        if want and c:IsA("BasePart") and Odyssey:OdysseyInField(part, c.Position, 2) then
            local d = (c.Position - r.Position).Magnitude
            if not bd or d < bd then best, bd = c, d end
        end
    end
    return best
end

-- the server tells the game where meteors, coconuts and petals will land (LocalFX)
function Odyssey:OdysseyFieldAt(pos)
    for _, n in ipairs(Odyssey:OdysseyFieldNames()) do
        local fp = Odyssey:OdysseyFieldPart(n)
        if fp and Odyssey:OdysseyInField(fp, pos, 6) then return n, fp end
    end
    return nil
end

-- On fx
function Odyssey:OdysseyOnFx(name, d)
    if type(name) ~= "string" or type(d) ~= "table" then return end
    if name == "PluckedPetal" and typeof(d.GoalPos) == "Vector3" then
        table.insert(X.goals, {pos = d.GoalPos, untilT = os.clock() + (tonumber(d.Duration) or 2) + 1})
    elseif name == "MythicMeteor" and typeof(d.Pos) == "Vector3" and F.meteor then
        local fname = Odyssey:OdysseyFieldAt(d.Pos)
        if fname and Odyssey:OdysseyFieldOpen(fname) then
            local landIn = (tonumber(d.Delay) or 2.5) + (tonumber(d.Dur) or 0.8)
            X.catch = {pos = d.Pos, untilT = os.clock() + landIn + 0.6, field = fname}
            if not (F.eventField and F.eventField.name == fname and F.eventField.untilT > os.clock()) then
                Window:Notify({Title = "Mythic Meteor", Content = "Landing in " .. fname .. " - going to catch it"})
            end
            F.eventField = {name = fname, untilT = os.clock() + 120}
            local r = Odyssey:OdysseyRoot()
            if F.active() and r and not Odyssey.converting and (Busy.who == nil or Busy.who == "Farm") then
                if (r.Position - d.Pos).Magnitude > 60 then Odyssey:OdysseyTpTo(d.Pos) else local h = Odyssey:OdysseyHum() if h then h:MoveTo(d.Pos) end end
            end
        end
    elseif name == "FallingCoconut" and typeof(d.Pos) == "Vector3" and F.coconuts and (d.Friendly or d.ComboOwner == LP) then
        local r = Odyssey:OdysseyRoot()
        local fname, fp = Odyssey:OdysseyFieldAt(d.Pos)
        if r and fname and fp and Odyssey:OdysseyInField(fp, r.Position, 10) and not Odyssey.converting then
            X.catch = {pos = d.Pos, untilT = os.clock() + (tonumber(d.Dur) or 2.6) + 0.4, field = fname}
            local h = Odyssey:OdysseyHum()
            if h then h:MoveTo(d.Pos) end
        end
    end
end

-- F · extra target
F.extraTarget = function(part)
    if X.catch and X.catch.untilT > os.clock() and Odyssey:OdysseyInField(part, X.catch.pos, 6) then return X.catch.pos end
    if F.leaves or (QQ.on and QQ.wantLeaves) then
