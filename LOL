-- Play the minigame
function Odyssey:OdysseyPlay(g, status)
    local function sel(i)
        local ok, tile = pcall(function() return g.Grid:GetTileAtIndex(i) end)
        if ok and tile then pcall(g.RegisterTileSelected, g, tile) end
    end
    local function waitFor(cond, secs)
        local t = os.clock()
        while os.clock() - t < (secs or 5) do
            if cond() then return true end
            task.wait(0.05)
        end
        return false
    end
    local function unknown()
        for i = 1, g.NumTiles do if not g.RevealedTiles[i] and not g.MatchedTiles[i] then return i end end
    end
    local guard = 0
    while running and MM.on and not g.Finished and (g.Chances or 0) > 0 and guard < 60 do
        guard += 1
        waitFor(function() return not g.WaitingForResponse end, 6)
        local rev, mat = g.RevealedTiles, g.MatchedTiles
        if g.LastSelectedIndex == nil then
            local a, b
            for i, ta in pairs(rev) do
                if not mat[i] then
                    for j, tb in pairs(rev) do
                        if j ~= i and tb == ta and not mat[j] then a, b = i, j break end
                    end
                end
                if a then break end
            end
            if a then
                sel(a)
                waitFor(function() return g.LastSelectedIndex == a end, 2)
                sel(b)
            else
                local u = unknown()
                if not u then break end
                sel(u)
                waitFor(function() return g.RevealedTiles[u] ~= nil end, 6)
            end
        else
            local i = g.LastSelectedIndex
            local ta = rev[i]
            local pick
            for j, tb in pairs(rev) do if j ~= i and tb == ta and not mat[j] then pick = j break end end
            pick = pick or unknown()
            if not pick then break end
            sel(pick)
            waitFor(function() return g.RevealedTiles[pick] ~= nil end, 6)
        end
        waitFor(function() return g.LastSelectedIndex == nil or g.Finished end, 4)
        if status then status("Playing · " .. tostring(g.Chances) .. " tries left") end
    end
end

