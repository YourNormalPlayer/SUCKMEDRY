local convertInner

convertInner = function(keepGoing)
    local spot = Odyssey:OdysseyHiveSpot()
    if not spot then return false, "No hive yet" end
    Busy.at = os.clock()
    if F.converters then
        for _, c in ipairs(CONVERTERS) do
            if Odyssey:OdysseyToyOpen(c) and Odyssey:OdysseyToyReady(c) and Odyssey:OdysseyUseToy(c) then
                task.wait(2)
                if Odyssey:OdysseyPollen() <= 0 then return true, "Used " .. c end
                break
            end
        end
    end
    local hive = Odyssey:OdysseyMyHive()
    local function phase()
        local p = hive and hive:FindFirstChild("Phase")
        local ok, v = pcall(function() return p.Value end)
        return ok and v or nil
    end
    Odyssey:OdysseyTpTo(spot, true)
    task.wait(0.8)
    Odyssey:OdysseyFire("PlayerHiveCommand", "ToggleHoneyMaking")
    if F.atHiveJobs then pcall(F.atHiveJobs) end
    local lastP, lastDrop, lastToggle, zeroSince = Odyssey:OdysseyPollen(), os.clock(), os.clock(), nil
    while running and keepGoing() do
        Busy.at = os.clock()
        local p = Odyssey:OdysseyPollen()
        if p <= 0 then
            zeroSince = zeroSince or os.clock()
            if os.clock() - zeroSince > 2 then break end
        else
            zeroSince = nil
            if p < lastP then lastDrop = os.clock() end
            lastP = p
            local r = Odyssey:OdysseyRoot()
            if r and (r.Position - spot).Magnitude > 12 then
                Odyssey:OdysseyTpTo(spot, true)
                task.wait(0.5)
            end
            local ph = phase()
            local stalled = os.clock() - lastDrop > 8
            if stalled and os.clock() - lastToggle > 8 and (ph == nil or ph == "Idle") then
                Odyssey:OdysseyFire("PlayerHiveCommand", "ToggleHoneyMaking")
                lastToggle, lastDrop = os.clock(), os.clock()
            end
            if fStatus then fStatus("Making honey · " .. Odyssey:OdysseyShort(p) .. " pollen left · stays until your bag is empty") end
        end
        task.wait(0.5)
    end
    if F.balloonWait and (F.balloonStay or (F.balloonBig and F.balloonBig())) then pcall(F.balloonWait, keepGoing) end
    return true, "Made honey"
end
