end

-- ========== Functions · Config ==========

-- Config file path
function Odyssey:OdysseyConfigPath(win)
    return "Odyssey Hub/" .. tostring(win.folder) .. "/Config.json"
end

-- Load saved settings
function Odyssey:OdysseyLoadConfig(win)
    local function read(path)
        local ok, data = pcall(function()
            if isfile and isfile(path) then return HttpService:JSONDecode(readfile(path)) end
        end)
        return ok and type(data) == "table" and data or nil
    end
    local data = read(Odyssey:OdysseyConfigPath(win))
    if not data and win.oldConfig then data = read(win.oldConfig) end
    for k, v in pairs(data or {}) do Odyssey.Flags[k] = v end
    win._loaded = data or {}
end

-- Save settings (a moment after the last change)
function Odyssey:OdysseySaveConfig(win)
    win._saveGen = (win._saveGen or 0) + 1
    local gen = win._saveGen
    task.delay(0.6, function()
        if gen ~= win._saveGen then return end
        pcall(function()
            if not (writefile and makefolder) then return end
            if isfolder and not isfolder("Odyssey Hub") then makefolder("Odyssey Hub") end
            local dir = "Odyssey Hub/" .. tostring(win.folder)
            if isfolder and not isfolder(dir) then makefolder(dir) end
            local out = {}
            for k, v in pairs(Odyssey.Flags) do
                local t = typeof(v)
                if t == "string" or t == "number" or t == "boolean" or t == "table" then out[k] = v
                elseif t == "EnumItem" then out[k] = v.Name end
            end
            writefile(Odyssey:OdysseyConfigPath(win), HttpService:JSONEncode(out))
        end)
    end)
end

-- Set a flag and save
function Odyssey:OdysseySetFlag(win, flag, v)
    if not flag then return end
    Odyssey.Flags[flag] = v
    Odyssey:OdysseySaveConfig(win)
end

-- Saved value for a flag (nil = none saved)
function Odyssey:OdysseySaved(win, flag)
    if not flag then return nil end
    return win._loaded and win._loaded[flag]
end

