    local fg = (o.Style == "Primary" and C.dark) or C.white
    row.BackgroundColor3 = base
    row.BackgroundTransparency = 0
    for _, ch in ipairs(row:GetChildren()) do if ch:IsA("UIStroke") then ch:Destroy() end end
    local bst = Odyssey:OdysseyStroke(row, o.Style == "Primary" and C.accent or (o.Style == "Danger" and Color3.fromRGB(170, 40, 40) or C.border))
    local holder = Odyssey:OdysseyNew("Frame", {Name = "Text", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row})
    local hl = Odyssey:OdysseyList(holder, 1)
    hl.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Odyssey:OdysseyPad(holder, 7, 10, 7, 10)
    local title = Odyssey:OdysseyText({Name = "Title", Text = tostring(o.Name or ""), Font = FONT_MED, Size = 12, Color = fg, Order = 1,
        AlignX = Enum.TextXAlignment.Center, Sz = UDim2.new(1, 0, 0, 15), Parent = holder})
    local desc = Odyssey:OdysseyText({Name = "Desc", Text = tostring(o.Description or ""), Size = 10, Wrap = true, Order = 2,
        Color = o.Style == "Primary" and C.dark or C.muted, AlignX = Enum.TextXAlignment.Center, Sz = UDim2.new(1, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Parent = holder})
    desc.Visible = (o.Description or "") ~= ""
    row.MouseEnter:Connect(function() Odyssey:OdysseyTween(row, 0.1, {BackgroundColor3 = base:Lerp(C.white, 0.1)}) bst.Color = C.accent end)
    row.MouseLeave:Connect(function()
        Odyssey:OdysseyTween(row, 0.1, {BackgroundColor3 = base})
        bst.Color = o.Style == "Primary" and C.accent or (o.Style == "Danger" and Color3.fromRGB(170, 40, 40) or C.border)
    end)
    row.MouseButton1Click:Connect(function()
        Odyssey:OdysseyTween(row, 0.05, {BackgroundColor3 = base:Lerp(C.white, 0.25)})
        task.delay(0.1, function() Odyssey:OdysseyTween(row, 0.15, {BackgroundColor3 = base}) end)
        task.spawn(function() Odyssey:OdysseySafe(o.Callback) end)
    end)
    sec.lastButton = row
    local el = {}
    function el:Set(v)
        if type(v) == "table" then
            if v.Name then title.Text = tostring(v.Name) end
            if v.Description then el:SetDescription(v.Description) end
        elseif v ~= nil then title.Text = tostring(v) end
    end
    Odyssey:OdysseyBase(el, row, desc)
    Odyssey:OdysseyIndex(sec, row, o.Name, o.Description)
