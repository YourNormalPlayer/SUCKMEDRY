    local dim = Odyssey:OdysseyNew("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 50, Parent = win.Root})
