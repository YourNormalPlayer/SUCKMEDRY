-- Find game
function Odyssey:OdysseyFindGame()
    if type(getgc) ~= "function" then return nil end
    for _, v in ipairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "RevealedTiles") and rawget(v, "Grid") and rawget(v, "NumTiles") and rawget(v, "Alive") ~= false and not rawget(v, "Finished") then
            return v
        end
