        BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = C.border, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 1, 0), Visible = false, Parent = content})}
    Odyssey:OdysseyPad(win._searchPage.frame, 7, 8, 7, 7)
    Odyssey:OdysseyList(win._searchPage.frame, 5)
    box:GetPropertyChangedSignal("Text"):Connect(function() Odyssey:OdysseySearch(win, box.Text) end)

    -- ---------- window methods ----------
    function win:CreateTab(t)
        t = t or {}
        local page = Odyssey:OdysseyPage(win, t, "tab")
        page.button = Odyssey:OdysseyTabButton(win, tostring(t.Name or "Tab"), t.Icon, 10 + #win._pages)
        page.button.MouseButton1Click:Connect(function() Odyssey:OdysseyOpenPage(win, page) end)
        page.api = Odyssey:OdysseyTabApi(page)
        Odyssey:OdysseySortTabs(win)
        return page.api
    end

    function win:Notify(n) Odyssey:OdysseyNotify(win, n) end

    function win:Confirm(c) Odyssey:OdysseyConfirm(win, c or {}) end

    function win:CreateProgressWidget(p) return Odyssey:OdysseyProgressWidget(win, p or {}) end

    function win:SetHomeStats(list)
        for _, c in ipairs(win._statsFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        local out = {}
        for i, s in ipairs(list or {}) do
            local card = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.panel, LayoutOrder = i, Parent = win._statsFrame})
            Odyssey:OdysseyCorner(card, 6)
            Odyssey:OdysseyStroke(card)
            Odyssey:OdysseyText({Text = tostring(s.Name), Size = 10, Color = C.muted, Pos = UDim2.new(0, 9, 0, 6), Sz = UDim2.new(1, -18, 0, 13), Parent = card})
            local v = Odyssey:OdysseyText({Text = tostring(s.Value or "-"), Font = FONT_BOLD, Size = 13, Color = C.white, Pos = UDim2.new(0, 9, 0, 21),
                Sz = UDim2.new(1, -18, 0, 16), Rich = true, Parent = card})
            local fill
            if s.Bar then
                local bar = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.border, Size = UDim2.new(1, -18, 0, 3), Position = UDim2.new(0, 9, 1, -8), Parent = card})
                Odyssey:OdysseyCorner(bar, 2)
                fill = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.accent, Size = UDim2.new(0, 0, 1, 0), Parent = bar})
                Odyssey:OdysseyCorner(fill, 2)
            end
            local el = {}
            function el:Set(x)
                if type(x) == "table" then
                    if x.Value ~= nil then v.Text = tostring(x.Value) end
                    if fill and tonumber(x.Percent) then
                        local p = tonumber(x.Percent)
                        if p > 1 then p = p / 100 end
                        Odyssey:OdysseyTween(fill, 0.3, {Size = UDim2.new(math.clamp(p, 0, 1), 0, 1, 0)})
                    end
                else
                    v.Text = tostring(x == nil and "-" or x)
                end
            end
            out[s.Name] = el
        end
        return out
    end

    function win:SetHomeCard(c)
        c = c or {}
        local body = win._sessionBody
        for _, k in ipairs(body:GetChildren()) do
            if k:IsA("Frame") and k.Name ~= "Head" then k:Destroy() end
        end
        local headLabel = win._sessionHead:FindFirstChildOfClass("TextLabel")
        if headLabel then headLabel.Text = tostring(c.Title or "Session"):upper() end
        local out = {}
        for i, r in ipairs(c.Rows or {}) do
            local v = Odyssey:OdysseyKV(body, r.Name, r.Value or "-", true, i + 1)
            local el = {}
            function el:Set(x)
                if type(x) == "table" then x = x.Value end
                v.Text = tostring(x == nil and "-" or x)
            end
            out[r.Name] = el
        end
        return out
    end

    -- one update card
    local function logCard(parent, u, entries)
        local card = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.panel, Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = -#win._logs, Parent = parent})
        Odyssey:OdysseyCorner(card, 6)
        Odyssey:OdysseyStroke(card)
        Odyssey:OdysseyPad(card, 8, 9, 8, 9)
        Odyssey:OdysseyList(card, 4)
        Odyssey:OdysseyText({Text = tostring(u.Version or "Update") .. (u.Date and ("  ·  " .. tostring(u.Date)) or ""), Font = FONT_BOLD, Size = 12,
            Color = C.white, Order = 0, Parent = card})
        local TYPE_COLORS = {Added = C.good, Fixed = C.accent, Changed = C.warn, Removed = C.bad}
        for i, e in ipairs(entries) do
            local line = Odyssey:OdysseyNew("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Parent = card})
            local pill = Odyssey:OdysseyNew("TextLabel", {BackgroundColor3 = TYPE_COLORS[e.Type] or C.accent, BackgroundTransparency = 0.8,
                FontFace = FONT_BOLD, TextSize = 9, TextColor3 = TYPE_COLORS[e.Type] or C.accent, Text = tostring(e.Type or "Note"):upper(),
                Size = UDim2.new(0, 58, 0, 15), Parent = line})
            Odyssey:OdysseyCorner(pill, 4)
            Odyssey:OdysseyText({Text = tostring(e.Text or ""), Size = 11, Wrap = true, Pos = UDim2.new(0, 66, 0, 0), Sz = UDim2.new(1, -66, 0, 0),
                Auto = Enum.AutomaticSize.Y, Parent = line})
        end
    end

    -- empty page note
    local function emptyNote(parent, text)
        local old = parent:FindFirstChild("Empty")
        local has = false
        for _, c in ipairs(parent:GetChildren()) do if c:IsA("Frame") and c.Name ~= "Empty" then has = true end end
        if has then
            if old then old:Destroy() end
        elseif not old then
            local t = Odyssey:OdysseyText({Text = text, Size = 11, Color = C.muted, Parent = parent})
            t.Name = "Empty"
        end
    end

    -- Window:CreateUpdateLog({Version = "v1.1", Date = "Nov 5", Entries = {{Type = "Added", Text = "..."}, {Type = "Fixed", Text = "..."}}})
    -- Kind = "Bug Fix" puts the whole log under Bug Fixes only
    function win:CreateUpdateLog(u)
        u = u or {}
        table.insert(win._logs, u)
        local fixes = {}
        for _, e in ipairs(u.Entries or {}) do
            if u.Kind == "Bug Fix" or tostring(e.Type) == "Fixed" then table.insert(fixes, e) end
        end
        if u.Kind ~= "Bug Fix" then logCard(win._updates, u, u.Entries or {}) end
        if #fixes > 0 then logCard(win._fixes, u, fixes) end
        emptyNote(win._updates, "No updates yet")
        emptyNote(win._fixes, "No bug fixes yet")
    end

    function win:CreateDiscordButton(d)
        d = d or {}
        win._discordCb = d.Callback
        if d.Label then win._discordBtn.Text = tostring(d.Label):gsub("Odyssey Discord Server", "Odyssey Hub") end
    end

    function win:SetTier(t)
        if win._badge then win._badge:Destroy() end
        win._badge = Odyssey:OdysseyBadge(win, badgeHolder, t)
    end

    function win:_relayoutTabs(compact) Odyssey:OdysseyRelayout(win, compact) end

    function win:Destroy()
        if win._dead then return end
        win._dead = true
        pcall(function() if type(win.OnDestroy) == "function" then win.OnDestroy() end end)
        for _, c in ipairs(win._conns) do pcall(function() c:Disconnect() end) end
        pcall(function() gui:Destroy() end)
    end

    -- Home first, Settings last; scripts can add their own settings with Window.ExtraSettings = function(tab) ... end
    Odyssey:OdysseyBuildHome(win)
    emptyNote(win._updates, "No updates yet")
    emptyNote(win._fixes, "No bug fixes yet")
    Odyssey:OdysseySettingsTab(win)
    Odyssey:OdysseyOpenPage(win, win._home)

    -- keep the shown key in step with the Settings bind
    task.spawn(function()
        while not win._dead do
            local k = Odyssey:OdysseyKeyFrom(Odyssey.Flags.HoloToggleKey)
            if k and k ~= win.toggleKey then win.toggleKey = k drawKey() end
            task.wait(1)
        end
    end)

    return setmetatable(win, {
        __newindex = function(t, k, v)
            rawset(t, k, v)
            -- the script's own Settings sections go under the built-in ones
            if k == "ExtraSettings" and type(v) == "function" and win._settings then
                local api = win._settings.api
                api:Side("Left")
                Odyssey:OdysseySafe(v, api)
                Odyssey:OdysseyRelayout(win, win._compact)
            end
        end,
    })
end

return Odyssey
