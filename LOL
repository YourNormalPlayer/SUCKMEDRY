-- Go do
function Odyssey:OdysseyGoDo(who, pos, fn)
    if not Busy.take(who) then return false end
    local ok, res = pcall(function()
        if pos then Odyssey:OdysseyTpTo(pos) task.wait(0.7) end
        return fn()
    end)
    Busy.free(who)
    return ok and res
end

