-- Shared element methods
function Odyssey:OdysseyBase(el, row, descLabel)
    el.Instance = row
    function el:SetDescription(t)
        if descLabel then
            descLabel.Text = tostring(t or "")
            descLabel.Visible = t ~= nil and t ~= ""
        end
    end
