-- Feed lowest
function Odyssey:OdysseyFeedLowest(key, amount)
    local low = Odyssey:OdysseyLowestBee()
    if not low or amount < 1 then return false end
    return Odyssey:OdysseyGoDo("Feeding", Odyssey:OdysseyHiveSpot(), function()
        Odyssey:OdysseyHiveCall(low.X, low.Y, key, amount, false, nil)
        task.wait(1)
        return true
    end)
end

-- quest tasks that use bees (feeding treats/berries, Royal Jelly, bee levels): done at the hive while the bag empties
function Odyssey:OdysseySafeJellyBee()
    local pick
    local BS = Odyssey:OdysseyMod("BeeStats")
    if HCTools and type(HCTools.ForEachLocalCell) == "function" then
        pcall(HCTools.ForEachLocalCell, function(c)
            local f = c.File
            if type(f) == "table" then
                local gifted = false
                if BS and type(BS.HasTrait) == "function" then local ok, r = pcall(BS.HasTrait, f, "Gifted") gifted = ok and r == true end
                if not gifted and (not pick or (tonumber(f.Lvl) or 1) < (tonumber(pick.File.Lvl) or 1)) then pick = c end
            end
        end)
    end
    return pick
end

-- Quest bee jobs
function Odyssey:OdysseyQuestBeeJobs()
    local jobs = {}
    for _, q in ipairs(Odyssey:OdysseyActiveQuests()) do
        for i, t in ipairs(type(q.tasks) == "table" and q.tasks or {}) do
            local p = q.prog[i]
            local done = type(p) == "table" and tonumber(p[1]) and p[1] >= 1
            if not done and type(t) == "table" then
                local leftAmt = type(p) == "table" and math.max(0, (tonumber(p[3]) or 0) - (tonumber(p[2]) or 0)) or 0
                if t.Type == "Use Items" and type(t.Item) == "string" and leftAmt > 0 then
                    local key, have = Odyssey:OdysseyInvKey(t.Item)
                    if have and have > 0 then
                        if FEEDABLE[t.Item] then
                            table.insert(jobs, {kind = "feed", key = key, n = math.min(leftAmt, have, 100), item = t.Item})
                        elseif t.Item == "RoyalJelly" then
                            table.insert(jobs, {kind = "jelly", key = key, n = math.min(leftAmt, have, 5), item = "Royal Jelly"})
                        end
                    end
                elseif t.Type == "Have Bees" and t.Level then
                    local key, have = Odyssey:OdysseyInvKey("Treat")
                    if have and have >= 10 then table.insert(jobs, {kind = "feed", key = key, n = 10, item = "Treat (bee levels)"}) end
                end
            end
        end
    end
    return jobs
end

-- Run bee jobs
function Odyssey:OdysseyRunBeeJobs(jobs)
    local did = {}
    for _, j in ipairs(jobs) do
        if j.kind == "feed" then
            local low = Odyssey:OdysseyLowestBee()
            if low and Odyssey:OdysseyHiveCall(low.X, low.Y, j.key, j.n) then table.insert(did, "fed " .. j.n .. " " .. j.item) end
            task.wait(0.8)
        elseif j.kind == "jelly" then
            local used = 0
            for _ = 1, j.n do
                local b = Odyssey:OdysseySafeJellyBee()
                if not b then break end
                if Odyssey:OdysseyHiveCall(b.X, b.Y, j.key, 1) then used += 1 end
                task.wait(0.8)
            end
            if used > 0 then table.insert(did, "used " .. used .. " Royal Jelly (on your lowest non-gifted bee)") end
        end
    end
    return did
end

-- called by the honey-making step while you're standing at your hive
F.atHiveJobs = function()
    if not (QQ.on and QQ.tasks) then return end
    local jobs = Odyssey:OdysseyQuestBeeJobs()
    if #jobs == 0 then QQ.beeQueuedAt = nil return end
    if fStatus then fStatus("Making honey · doing quest bee tasks") end
    local did = Odyssey:OdysseyRunBeeJobs(jobs)
    QQ.beeQueuedAt = nil
    if #did > 0 then Window:Notify({Title = "Quest bee tasks", Content = table.concat(did, ", ")}) end
end

-- Do item tasks
function Odyssey:OdysseyDoItemTasks()
    local did = {}
    do
        local jobs = Odyssey:OdysseyQuestBeeJobs()
        if #jobs == 0 then
            QQ.beeQueuedAt = nil
        elseif F.active() and os.clock() - (QQ.beeQueuedAt or os.clock()) < 240 then
            -- farming: wait until the next time the bag gets emptied at the hive (no extra trip)
            QQ.beeQueuedAt = QQ.beeQueuedAt or os.clock()
        else
            -- not farming (or no honey trip for 4 minutes): go to the hive now
            local list
            if Odyssey:OdysseyGoDo("Feeding", Odyssey:OdysseyHiveSpot(), function() list = Odyssey:OdysseyRunBeeJobs(jobs) return true end) then
                QQ.beeQueuedAt = nil
                for _, d in ipairs(list or {}) do table.insert(did, d) end
            end
        end
    end
    for _, q in ipairs(Odyssey:OdysseyActiveQuests()) do
        for i, t in ipairs(type(q.tasks) == "table" and q.tasks or {}) do
            local p = q.prog[i]
            local done = type(p) == "table" and tonumber(p[1]) and p[1] >= 1
            if not done and type(t) == "table" then
                local leftAmt = type(p) == "table" and math.max(0, (tonumber(p[3]) or 0) - (tonumber(p[2]) or 0)) or 0
                if t.Type == "Use Items" and type(t.Item) == "string" and not NO_AUTO_USE[t.Item] and not FEEDABLE[t.Item] and leftAmt > 0 then
                    local _, have = Odyssey:OdysseyInvKey(t.Item)
                    if have and have > 0 and Odyssey:OdysseyUseItem(t.Item) then table.insert(did, "used " .. t.Item) end
                elseif t.Type == "Donate To Wind Shrine" and type(t.Item) == "string" and leftAmt > 0 and Odyssey:OdysseyNpcOpen("Wind Shrine") then
                    local key, have = Odyssey:OdysseyInvKey(t.Item)
                    if have and have > 0 and not NO_AUTO_USE[t.Item] then
                        local n = math.min(leftAmt, have)
                        local f = workspace:FindFirstChild("NPCs")
                        local m = f and f:FindFirstChild("Wind Shrine")
                        local p = m and m:FindFirstChild("Platform")
                        if Odyssey:OdysseyGoDo("Quests", p and p.Position, function() Odyssey:OdysseyFire("WindShrineDonation", key, n) task.wait(0.8) return true end) then
                            table.insert(did, "donated " .. n .. " " .. t.Item .. " to the Wind Shrine")
                        end
                    end
                elseif t.Type == "Use Toy" and type(t.Toy) == "string" and Odyssey:OdysseyToySpot(t.Toy) and (TOY_BEES[t.Toy] == nil or Odyssey:OdysseyToyOpen(t.Toy)) and Odyssey:OdysseyToyReady(t.Toy) then
                    if Odyssey:OdysseyGoDo("Quests", nil, function() return Odyssey:OdysseyUseToy(t.Toy) end) then table.insert(did, "used " .. t.Toy) end
                end
            end
        end
    end
    return did
end

-- how much is left of a quest (lower = easier): each unfinished task adds what's left of it (0..1),
-- tasks you can't do yet (locked field / mob zone) add a lot, so quests you can finish soonest go first
function Odyssey:OdysseyQuestLeft(q)
    local left = 0
    for i, t in ipairs(type(q.tasks) == "table" and q.tasks or {}) do
        local p = q.prog[i]
        local frac = type(p) == "table" and tonumber(p[1]) or 0
        if frac < 1 and type(t) == "table" then
            left += 1 - math.max(frac, 0)
            if t.Type == "Collect Pollen" then
                if type(t.Zone) == "string" and not Odyssey:OdysseyFieldOpen(t.Zone) then left += 10 end
                if type(t.Zone) ~= "string" and type(t.Color) == "string" and not Odyssey:OdysseyColorField(t.Color) then left += 10 end
            elseif t.Type == "Defeat Monsters" and type(t.MonsterType) == "string" and mobOpen and not mobOpen(t.MonsterType) then
                left += 10
            end
        end
    end
    return left
end

-- your active quests, easiest (closest to done) first
function Odyssey:OdysseyQuestsEasyFirst()
    local list = {}
    QQ.lockedActive = {}
    for _, q in ipairs(Odyssey:OdysseyActiveQuests()) do
        local open, why = Odyssey:OdysseyQuestOpen(q.name, q.prog)
        if open then table.insert(list, q) else QQ.lockedActive[q.name] = why end
    end
    local score = {}
    for _, q in ipairs(list) do score[q] = Odyssey:OdysseyQuestLeft(q) end
    table.sort(list, function(a, b) return score[a] < score[b] end)
    return list
end

-- Quest needs
function Odyssey:OdysseyQuestNeeds()
    local field, mobs, farm = nil, {}, false
    local itemField
    QQ.wantBlooms, QQ.wantLeaves, QQ.itemFarm = false, false, nil
    local quests = Odyssey:OdysseyQuestsEasyFirst()
    QQ.easiest = quests[1] and quests[1].name or nil
    for _, q in ipairs(quests) do
        for i, t in ipairs(type(q.tasks) == "table" and q.tasks or {}) do
            local p = q.prog[i]
            local done = type(p) == "table" and tonumber(p[1]) and p[1] >= 1
            if not done and type(t) == "table" then
                local tag = t.Tag
                local first = type(tag) == "table" and tag[1] or tag
                if first == "Petals" or first == "Blooms" then QQ.wantBlooms = true end
                if t.Type == "Collect Tokens" and first == "Leaves" then QQ.wantLeaves = true end
                -- quest needs an item you're short on (like Treats): farm the leaves of the field that drops it
                if (t.Type == "Use Items" or t.Type == "Have Items" or t.Type == "Donate To Wind Shrine") and type(t.Item) == "string" and not itemField then
                    local need = type(p) == "table" and math.max(0, (tonumber(p[3]) or 0) - (tonumber(p[2]) or 0)) or (tonumber(t.Amount) or 1)
                    local lf = LEAF_ITEM_FIELD[t.Item]
                    if lf and need > Odyssey:OdysseyItemCount(t.Item) and Odyssey:OdysseyFieldPart(lf) and Odyssey:OdysseyFieldOpen(lf) then
                        itemField = lf
                        QQ.itemFarm = t.Item .. " (" .. Odyssey:OdysseyItemCount(t.Item) .. "/" .. need .. ")"
                    end
                end
            end
        end
    end
    if itemField then QQ.wantLeaves, farm = true, true end
    -- every field your unfinished pollen tasks can use, from every bear's quest (easiest quests first)
    local pollenTasks, candidates, seen = {}, {}, {}
    local function addField(f, order)
        if f and not seen[f] and Odyssey:OdysseyFieldPart(f) and Odyssey:OdysseyFieldOpen(f) then
            seen[f] = true
            table.insert(candidates, {name = f, order = order})
        end
    end
    for qi, q in ipairs(quests) do
        for i, t in ipairs(type(q.tasks) == "table" and q.tasks or {}) do
            local p = q.prog[i]
            local done = type(p) == "table" and tonumber(p[1]) and p[1] >= 1
            if not done and type(t) == "table" then
                if t.Type == "Collect Pollen" or t.Type == "Collect Tokens" or t.Type == "Collect Goo" then
                    if t.Type ~= "Collect Pollen" or type(t.Zone) ~= "string" or Odyssey:OdysseyFieldOpen(t.Zone) then farm = true end
                end
                if t.Type == "Collect Pollen" then
                    table.insert(pollenTasks, t)
                    if type(t.Zone) == "string" then
                        addField(t.Zone, qi)
                    elseif type(t.Color) == "string" then
                        for _, f in ipairs(COLOR_FIELDS[t.Color] or {}) do addField(f, qi + 0.5) end
                    elseif Odyssey.isHiveHub then
                        -- any-pollen task in the Hive Hub: the Hub Field gives 4x pollen
                        addField("Hub Field", qi + 0.25)
                    end
                elseif t.Type == "Defeat Monsters" and type(t.MonsterType) == "string" then
                    mobs[t.MonsterType] = true
                end
            end
        end
    end
    -- how many of those tasks each field counts for (a white field helps "white pollen" AND "Sunflower" quests)
    local function colorOf(f) for c, list in pairs(COLOR_FIELDS) do if table.find(list, f) then return c end end end
    for _, c in ipairs(candidates) do
        local n, col = 0, colorOf(c.name)
        for _, t in ipairs(pollenTasks) do
            if (type(t.Zone) == "string" and t.Zone == c.name) or (type(t.Zone) ~= "string" and (t.Color == nil or t.Color == col)) then n += 1 end
        end
        c.hits = n
    end
    table.sort(candidates, function(a, b) if a.hits ~= b.hits then return a.hits > b.hits end return a.order < b.order end)
    -- stay on a field until the quest tasks there are done, then go to the next quest's field.
    -- The field that counts for the most quests goes first (two quests on one field = both done at once).
    if #candidates > 0 then
        QQ.rot = QQ.rot or {field = nil, at = 0}
        local rot, idx = QQ.rot, nil
        for i, c in ipairs(candidates) do if c.name == rot.field then idx = i break end end
        if idx then
            field = rot.field
        else
            -- that field's tasks are done: the best field left
            field = candidates[1].name
            rot.field, rot.at = field, os.clock()
        end
        QQ.questFields = #candidates
    else
        QQ.questFields = 0
    end
    return field or itemField, mobs, farm
end

-- can this quest be done right now? false + why when something it needs is locked:
-- a zone (field / mob area / toy), an item you don't have and can't farm, a translator, or the quest's own requirements
function Odyssey:OdysseyQuestOpen(questName, prog)
    if not (QuestsMod and questName) then return true end
    local st = Stats.all()
    local okD, def = pcall(QuestsMod.Get, QuestsMod, questName)
    if not (okD and type(def) == "table") then return true end
    -- the quest's own requirements (bees, flags like a translator, other quests done)
    for _, req in ipairs(type(def.Requirements) == "table" and def.Requirements or {}) do
        if type(req) == "table" then
            if req.Type == "Have Bees" and tonumber(req.Amount or req.Bees or req.Value) and Odyssey:OdysseyBeeCount() < tonumber(req.Amount or req.Bees or req.Value) then
                return false, (req.Amount or req.Bees or req.Value) .. " bees"
            elseif req.Type == "Have Flags" then
                for _, fl in ipairs(type(req.Flags) == "table" and req.Flags or {req.Flag}) do
                    if type(fl) == "string" and not Odyssey:OdysseyHasFlag(fl) then return false, (fl:find("Translat") and "a translator" or fl) end
                end
            end
        end
    end
    local okT, tasks = pcall(QuestsMod.ResolveTasks, def, st)
    for i, t in ipairs(okT and type(tasks) == "table" and tasks or {}) do
        local p = prog and prog[i]
        local done = type(p) == "table" and tonumber(p[1]) and p[1] >= 1
        if type(t) == "table" and not done then
            if t.Type == "Collect Pollen" then
                if type(t.Zone) == "string" and not Odyssey:OdysseyFieldOpen(t.Zone) then return false, t.Zone end
                if type(t.Zone) ~= "string" and type(t.Color) == "string" and not Odyssey:OdysseyColorField(t.Color) then return false, t.Color .. " fields" end
            elseif t.Type == "Defeat Monsters" and type(t.MonsterType) == "string" then
                if not (mobOpen and mobOpen(t.MonsterType)) then return false, t.MonsterType .. " zone" end
            elseif t.Type == "Use Toy" and type(t.Toy) == "string" then
                if TOY_BEES[t.Toy] ~= nil and not Odyssey:OdysseyToyOpen(t.Toy) then return false, t.Toy end
            elseif (t.Type == "Use Items" or t.Type == "Have Items" or t.Type == "Donate To Wind Shrine") and type(t.Item) == "string" then
                -- an item you don't have enough of and can't farm from a field you've unlocked
                local need = type(p) == "table" and math.max(0, (tonumber(p[3]) or 0) - (tonumber(p[2]) or 0)) or (tonumber(t.Amount) or 1)
                local lf = LEAF_ITEM_FIELD[t.Item]
                local canFarm = lf and Odyssey:OdysseyFieldPart(lf) and Odyssey:OdysseyFieldOpen(lf)
                if need > 0 and (Odyssey:OdysseyItemCount(t.Item) or 0) < need and not canFarm then return false, need .. " " .. t.Item end
                if t.Type == "Donate To Wind Shrine" and not Odyssey:OdysseyNpcOpen("Wind Shrine") then return false, "the Wind Shrine" end
            end
        end
    end
    return true
end

-- NPC action
function Odyssey:OdysseyNpcAction(npc)
    if not NPCsMod then return nil end
    QQ.sent = QQ.sent or {}
    local st = Stats.all()
    local okG, data = pcall(NPCsMod.Get, npc)
    data = okG and type(data) == "table" and data or nil
    local function reqsOk(r)
        if not r then return true end
        StatToolsMod = StatToolsMod or Odyssey:OdysseyMod("StatTools")
        if not (StatToolsMod and type(StatToolsMod.CheckReqs) == "function") then return false end
        local ok, res = pcall(StatToolsMod.CheckReqs, st, r)
        return ok and res == true
    end
    do
        local okP, ev0, ph0 = pcall(NPCsMod.GetEventPhase, npc, st)
        local e0 = okP and data and type(data.Events) == "table" and data.Events[ev0] or nil
        if e0 and (e0.Type == "Dialogue" or e0.Type == "Repeat Dialogue") and type(e0.Ongoing) == "table" and e0.Ongoing.ActionTag and not QUEST_BLOCK_TAGS[e0.Ongoing.ActionTag] then
            local key = npc .. "|" .. tostring(ev0) .. "|" .. tostring(e0.Ongoing.ActionTag)
            if not QQ.sent[key] and (ph0 == "Start" or ph0 == "Ongoing") then
                QQ.sent[key] = true
                return "SelectNPCOption", e0.Ongoing.ActionTag
            end
        end
    end
    local okR, ev, phase = pcall(NPCsMod.ResolveEventPhase, npc)
    if not okR then return nil end
    local evData = data and type(data.Events) == "table" and data.Events[ev] or nil
    local okO, ov, ovPhase = pcall(NPCsMod.ResolveOverrideEvent, npc)
    if not okO then ov = nil end
    local typ = evData and evData.Type
    if phase == "Finish" and not (ov and ov.Type == "Dialogue") then
        if typ == "Single Quest" then return "CompleteQuest", evData.Quest end
        if typ == "Repeat Quest" then return "CompleteQuestFromPool", evData.QuestPool end
    end
    if ov and ov.Type == "Single Quest" then
        if ovPhase == "Start" and Odyssey:OdysseyQuestOpen(ov.Quest) then return "GiveQuest", ov.Quest end
        if ovPhase == "Finish" then return "CompleteQuest", ov.Quest end
    elseif ov and type(ov.Start) == "table" and ov.Start.ActionTag and not QUEST_BLOCK_TAGS[ov.Start.ActionTag] then
        local key = npc .. "|ov|" .. tostring(ov.Start.ActionTag)
        if not QQ.sent[key] then
            QQ.sent[key] = true
            return "SelectNPCOption", ov.Start.ActionTag
        end
    end
    if typ == "Single Quest" and phase == "Start" then
        local open, why = Odyssey:OdysseyQuestOpen(evData.Quest)
        if not open then return nil, nil, "Locked: " .. tostring(evData.Quest) .. " needs " .. tostring(why) end
        return "GiveQuest", evData.Quest
    end
    if typ == "Repeat Quest" and phase == "Start" then return "GiveQuestFromPool", evData.QuestPool end
    if typ == "Options" and (phase == "Start" or phase == "Ongoing" or phase == "Finish") then
        for _, o in ipairs(type(evData.Options) == "table" and evData.Options or {}) do
            local tag = type(o) == "table" and o.ActionTag
            if type(tag) == "string" and not tag:find("GivePresent") and not QUEST_BLOCK_TAGS[tag] and reqsOk(o.Requirements) then
                local key = npc .. "|" .. tostring(ev) .. "|" .. tag
                if not QQ.sent[key] then
                    QQ.sent[key] = true
                    return "SelectNPCOption", tag
                end
            end
        end
        return nil, nil, "waiting on something you need first (" .. tostring(phase) .. ")"
    end
    if phase == "Unready" then
        local q = evData and (evData.Quest or evData.QuestPool)
        return nil, nil, "next quest isn't unlocked yet" .. (q and (" (" .. tostring(q) .. ")") or "")
    end
    if phase == "Cooldown" then return nil, nil, "repeat quest on cooldown" end
    if phase == "Ongoing" and (typ == "Single Quest" or typ == "Repeat Quest") then return nil, nil, nil end
    return nil, nil, typ and (tostring(typ) .. " · " .. tostring(phase)) or nil
end

-- ========== Functions · Mobs ==========

-- Spawner info
function Odyssey:OdysseySpawnerInfo(sp)
    local mt = sp:FindFirstChild("MonsterType")
    local terr = sp:FindFirstChild("Territory")
    local cd = sp:FindFirstChild("Cooldown")
    local typ = mt and mt.Value
    return typ, terr and terr.Value, cd and tonumber(cd.Value) or MOB_CD[typ] or 300
end

-- Spawner left
function Odyssey:OdysseySpawnerLeft(sp)
    if MonsterTools and type(MonsterTools.GetSpawnerCooldown) == "function" then
        local ok, v = pcall(MonsterTools.GetSpawnerCooldown, sp.Name)
        if ok and type(v) == "number" then return v end
    end
    local _, _, cd = Odyssey:OdysseySpawnerInfo(sp)
    local mt = Stats.all().MonsterTimes
    local last = type(mt) == "table" and tonumber(mt[sp.Name]) or nil
    if last then return (last + cd) - Odyssey:OdysseyNow() end
    -- the game didn't say: use the time saved when the script last killed it (kept in a file across rejoins)
    local saved = MB.saved and tonumber(MB.saved[sp.Name])
    if saved then return saved - os.time() end
    return 0
end

-- Territory pos
function Odyssey:OdysseyTerritoryPos(t)
    if typeof(t) ~= "Instance" then return nil end
    if t:IsA("BasePart") then return t.Position + Vector3.new(0, t.Size.Y / 2 + 3, 0) end
    for _, d in ipairs(t:GetDescendants()) do
        if d:IsA("BasePart") then return d.Position + Vector3.new(0, d.Size.Y / 2 + 3, 0) end
    end
    return nil
end

-- Spawner open
function Odyssey:OdysseySpawnerOpen(sp)
    local _, terr = Odyssey:OdysseySpawnerInfo(sp)
    local need = SPAWNER_BEES[sp.Name] or (typeof(terr) == "Instance" and ZONE_BEES[terr.Name]) or 0
    return Odyssey:OdysseyBeeCount() >= need
end

-- the mob of this type closest to `near` (within 220 studs)
function Odyssey:OdysseyFindMonster(typ, near)
    local m = workspace:FindFirstChild("Monsters")
    local best, bd
    for _, x in ipairs(m and m:GetChildren() or {}) do
        if x.Name:sub(1, #typ) == typ then
            local ok, p = pcall(function() return x:GetPivot().Position end)
            if ok and p then
                local d = near and (p - near).Magnitude or 0
                if not near or d < 220 then
                    if not bd or d < bd then best, bd = x, d end
                end
            end
        end
    end
    return best
end

-- a mob's health left (0..1), nil if it can't be read
function Odyssey:OdysseyMobHealth(mon)
    local hp, max
    pcall(function()
        local h = mon:FindFirstChildOfClass("Humanoid")
        if h and h.MaxHealth > 0 then hp, max = h.Health, h.MaxHealth return end
        hp, max = mon:GetAttribute("Health"), mon:GetAttribute("MaxHealth")
        if not (hp and max) then
            local a, b = mon:FindFirstChild("Health", true), mon:FindFirstChild("MaxHealth", true)
            hp, max = a and a.Value, b and b.Value
        end
    end)
    if type(hp) == "number" and type(max) == "number" and max > 0 then return hp / max end
    return nil
end

-- when each spawner is ready again (os.time), written after every kill
function Odyssey:OdysseySaveMobTime(sp, secs)
    local _, _, cd = Odyssey:OdysseySpawnerInfo(sp)
    MB.saved[sp.Name] = os.time() + (secs or cd or 300)
    pcall(function()
        if not (writefile and makefolder and isfolder) then return end
        local cur = ""
        for part in DIR:gmatch("[^/]+") do cur = cur == "" and part or (cur .. "/" .. part) if not isfolder(cur) then makefolder(cur) end end
        writefile(FILE, HS:JSONEncode(MB.saved))
    end)
end

-- time until a mob respawns. The saved respawn time (from your kills) decides; without one the game's timer is used,
-- unless it's longer than that mob can ever take (then it's wrong and the mob gets checked once and saved)
function Odyssey:OdysseyMobLeft(sp, typ)
    local saved = tonumber(MB.saved[sp.Name])
    if saved then return math.max(saved - os.time(), 0) end
    local _, _, cd = Odyssey:OdysseySpawnerInfo(sp)
    local game = Odyssey:OdysseySpawnerLeft(sp)
    if game > (cd or 300) * 1.1 then return 0 end
    return math.max(game, 0)
end

-- Spawner ready
function Odyssey:OdysseySpawnerReady(sp)
    local typ = Odyssey:OdysseySpawnerInfo(sp)
    return Odyssey:OdysseySpawnerOpen(sp) and Odyssey:OdysseyMobLeft(sp, typ) <= 0
end

-- how many bees (the game's own flying-entity list) are within `radius` of pos. nil = can't tell
function Odyssey:OdysseyBeesNear(pos, radius)
    MB.lfe = MB.lfe or Odyssey:OdysseyMod("LocalFlyingEntity")
    local L = MB.lfe
    if not (L and type(L.GetEntities) == "function") then return nil end
    local ok, list = pcall(L.GetEntities)
    if not (ok and type(list) == "table") then ok, list = pcall(L.GetEntities, L) end
    if not (ok and type(list) == "table") then return nil end
    local n, seen = 0, 0
    for _, e in pairs(list) do
        local p
        pcall(function() p = L.GetPos(e) end)
        if typeof(p) ~= "Vector3" then pcall(function() p = e:GetPos() end) end
        if typeof(p) ~= "Vector3" and type(e) == "table" then
            p = e.Pos or e.Position or (typeof(e.CFrame) == "CFrame" and e.CFrame.Position) or nil
        end
        if typeof(p) == "Vector3" then
            seen += 1
            if (p - pos).Magnitude <= radius then n += 1 end
        end
    end
    if seen == 0 then return nil end
    return n
end

-- stay put until your bees have caught up (60% of them within 30 studs), at most 12s.
-- If the bees can't be read, waits by how far you teleported (bees fly about 30 studs a second)
function Odyssey:OdysseyWaitForBees(keep, status, fromPos)
    local need = math.max(1, math.floor(Odyssey:OdysseyBeeCount() * 0.6))
    local t0, fallback = os.clock(), nil
    while running and (not keep or keep()) and os.clock() - t0 < 12 do
        local r = Odyssey:OdysseyRoot()
        if not r then break end
        local n = Odyssey:OdysseyBeesNear(r.Position, 30)
        if n == nil then
            fallback = fallback or math.clamp(((fromPos and (fromPos - r.Position).Magnitude) or 150) / 30, 2, 8)
            if os.clock() - t0 >= fallback then return true end
        elseif n >= need then
            return true
        end
        if status then pcall(status, n or 0, need) end
        task.wait(0.25)
    end
    return false
end

-- Box of
function Odyssey:OdysseyBoxOf(inst)
    if typeof(inst) ~= "Instance" then return nil end
    if inst:IsA("BasePart") then return inst.CFrame, inst.Size end
    if inst:IsA("Model") then
        local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf then return cf, size end
    end
    for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then return d.CFrame, d.Size end end
    return nil
end

-- a spot on the ground just outside a zone (mob territory or field), on the side closest to `near`
function Odyssey:OdysseyOutsideSpot(inst, margin, near)
    local cf, size = Odyssey:OdysseyBoxOf(inst)
    if not cf then return nil end
    local c = cf.Position
    local rad = math.sqrt(size.X ^ 2 + size.Z ^ 2) / 2 + (margin or 20)
    local best, bd
    for i = 0, 7 do
        local a = i * math.pi / 4
        local p = c + Vector3.new(math.cos(a) * rad, 0, math.sin(a) * rad)
        local g = Odyssey.OdysseyGroundAt and Odyssey:OdysseyGroundAt(p)
        if g and math.abs(g.Y - c.Y) < 40 then
            local d = near and (g - near).Magnitude or 0
            if not bd or d < bd then best, bd = g, d end
        end
    end
    return best
end

-- a mob spawner in / next to this field that's off cooldown (walking in would wake it)
function Odyssey:OdysseyFieldMobReady(part)
    local ms = workspace:FindFirstChild("MonsterSpawners")
    for _, sp in ipairs(ms and ms:GetChildren() or {}) do
        local typ, terr = Odyssey:OdysseySpawnerInfo(sp)
        local tp = typ and Odyssey:OdysseyTerritoryPos(terr)
        if tp and Odyssey:OdysseyInField(part, tp, 15) and Odyssey:OdysseySpawnerReady(sp) then return sp, typ end
    end
    return nil
end

-- is this mob type one Auto Mobs goes for right now (picked, a quest needs it, Robo Bear / bosses)
function Odyssey:OdysseyMobWanted(typ)
    if not typ then return false end
    local wanted = (MB.on and not MB.onlyQuest and MB.pick[typ]) or QQ.mobNeed[typ] or (MB.extraNeed and MB.extraNeed[typ]) or (MB.bosses and MB.bossPick and MB.bossPick[typ])
    if wanted and MB.bossMin and MB.bossMin[typ] and Odyssey:OdysseyBeeCount() < MB.bossMin[typ] then wanted = false end
    return wanted and true or false
end

-- a mob Auto Mobs wants that's off cooldown right now: farming waits until every one of them is done / on cooldown
function Odyssey:OdysseyMobReadyAny()
    if Odyssey.isHiveHub then return nil end
    if not (MB.active and MB.active()) then return nil end
    local ms = workspace:FindFirstChild("MonsterSpawners")
    for _, sp in ipairs(ms and ms:GetChildren() or {}) do
        local typ = Odyssey:OdysseySpawnerInfo(sp)
        if Odyssey:OdysseyMobWanted(typ) and (MB.failUntil[sp.Name] or 0) < os.clock() and Odyssey:OdysseySpawnerReady(sp) then
            return typ
        end
    end
    return nil
end

-- a mob your quests need that can be fought right now (Auto Quests does these before farming)
function Odyssey:OdysseyQuestMobReady()
    if Odyssey.isHiveHub then return nil end
    if not (QQ.on and next(QQ.mobNeed or {}) ~= nil and MB.active and MB.active()) then return nil end
    local ms = workspace:FindFirstChild("MonsterSpawners")
    for _, sp in ipairs(ms and ms:GetChildren() or {}) do
        local typ = Odyssey:OdysseySpawnerInfo(sp)
        if typ and QQ.mobNeed[typ] and (MB.failUntil[sp.Name] or 0) < os.clock()
            and not (MB.bossMin and MB.bossMin[typ] and Odyssey:OdysseyBeeCount() < MB.bossMin[typ])
            and Odyssey:OdysseySpawnerReady(sp) then
            return typ
        end
    end
    return nil
end

-- Away spot
function Odyssey:OdysseyAwaySpot(mobPos, area, rMin, rMax)
    local cands = {}
    local cf, size = Odyssey:OdysseyBoxOf(area)
    if cf then
        for _ = 1, 16 do
            local off = Vector3.new((math.random() - 0.5) * size.X, size.Y / 2, (math.random() - 0.5) * size.Z)
            table.insert(cands, (cf * CFrame.new(off)).Position)
        end
    end
    for i = 0, 7 do
        local a = i * math.pi / 4
        table.insert(cands, mobPos + Vector3.new(math.cos(a) * (rMin + rMax) / 2, 0, math.sin(a) * (rMin + rMax) / 2))
    end
    local best, bd
    for _, c in ipairs(cands) do
        local d = ((c - mobPos) * Vector3.new(1, 0, 1)).Magnitude
        if d >= rMin and d <= rMax then
            local g = Odyssey.OdysseyGroundAt and Odyssey:OdysseyGroundAt(c) or c
            if g and math.abs(g.Y - mobPos.Y) < 25 and (not bd or d > bd) then best, bd = g, d end
        end
    end
    return best
end

-- Keep away
function Odyssey:OdysseyKeepAway(mon, area)
    if not Odyssey.keepAway then return function() end end
    local on, last = true, 0
    task.spawn(function()
        while on and running and mon and mon.Parent do
            local r = Odyssey:OdysseyRoot()
            local ok, p = pcall(function() return mon:GetPivot().Position end)
            if r and ok and p and os.clock() - last > 0.8 and ((p - r.Position) * Vector3.new(1, 0, 1)).Magnitude < 12 then
                local spot = Odyssey:OdysseyAwaySpot(p, area, 25, 40)
                if spot then
                    last = os.clock()
                    Odyssey:OdysseyTpTo(spot)
                end
            end
            task.wait(0.1)
        end
    end)
    return function() on = false end
end

-- Dodge jump
function Odyssey:OdysseyDodgeJump(mon)
    if not Odyssey.dodgeJump or Odyssey.keepAway then return end
    local h, r = Odyssey:OdysseyHum(), Odyssey:OdysseyRoot()
    if not (h and r and mon) then return end
    local ok, p = pcall(function() return mon:GetPivot().Position end)
    if ok and p and ((p - r.Position) * Vector3.new(1, 0, 1)).Magnitude < 15 and h.FloorMaterial ~= Enum.Material.Air then
        h.Jump = true
    end
end

-- Mob run
function Odyssey:OdysseyMobRun()
    local ms = workspace:FindFirstChild("MonsterSpawners")
    if not ms then return "Spawners not found" end
    if not Odyssey:OdysseyMyHive() then return "Claim a hive first" end
    if Odyssey.isHiveHub then return "Mobs are in the main game · in the Hive Hub it only farms the Hub Field" end
    if Odyssey.fieldLock then return "Waiting · doing the quest fields first (" .. tostring(Odyssey.fieldLock.field) .. ")" end
    local soonest
    -- the mobs your quests need go first
    local order = ms:GetChildren()
    local function isQuest(sp) local t = Odyssey:OdysseySpawnerInfo(sp) return t and QQ.mobNeed[t] and 0 or 1 end
    table.sort(order, function(a, b) return isQuest(a) < isQuest(b) end)
    for _, sp in ipairs(order) do
        if not (running and MB.active()) then break end
        local typ, terr = Odyssey:OdysseySpawnerInfo(sp)
        -- bosses (picked or needed by a quest) only when you have enough bees for them
        local wanted = Odyssey:OdysseyMobWanted(typ)
        if wanted and Odyssey:OdysseySpawnerOpen(sp) and (MB.failUntil[sp.Name] or 0) < os.clock() then
            local left = Odyssey:OdysseyMobLeft(sp, typ)
            if left > 0 then
                if not soonest or left < soonest then soonest = left end
            else
                local pos = Odyssey:OdysseyTerritoryPos(terr)
                if pos then
                    local result = "busy"
                    local r0 = Odyssey:OdysseyRoot()
                    local from = r0 and r0.Position
                    -- stand just outside its territory until the bees catch up, then go in
                    local outside = MB.waitBees and Odyssey:OdysseyOutsideSpot(terr, 20, from) or nil
                    Odyssey:OdysseyGoDo("Mobs", outside or pos, function()
                        result = "none"
                        Toggles.mobWaiting = nil
                        if outside then
                            Odyssey:OdysseyWaitForBees(function() return running and MB.active() end, function(n, need)
                                Odyssey.mobToggle:SetDescription(("Waiting outside %s for your bees (%d/%d)"):format(sp.Name, n, need))
                            end, from)
                            Odyssey:OdysseyTpTo(pos)
                            task.wait(0.5)
                        end
                        pcall(function() Odyssey.mobToggle:SetDescription("Going to " .. typ .. " · " .. sp.Name) end)
                        local mon
                        for _ = 1, 60 do
                            mon = Odyssey:OdysseyFindMonster(typ, pos)
                            if mon or not (running and MB.active()) then break end
                            task.wait(0.25)
                        end
                        if not mon then result = "none" return end
                        pcall(function() Odyssey.mobToggle:SetDescription("Fighting " .. mon.Name) end)
                        local t = os.clock()
                        local cap = (MB.bossMin and MB.bossMin[typ]) and 900 or 300
                        -- once a fight starts it's finished (doesn't stop because a quest/toggle changed mid-fight)
                        local stopHover = Odyssey:OdysseyKeepAway(mon, terr)
                        while running and mon.Parent and os.clock() - t < cap do
                            local h = Odyssey:OdysseyHum()
                            local r = Odyssey:OdysseyRoot()
                            local mine = h and h.MaxHealth > 0 and h.Health / h.MaxHealth or 1
                            local theirs = Odyssey:OdysseyMobHealth(mon)
                            -- low health: leave - unless the mob is almost dead, then stay until you're really low
                            if mine < 0.3 and not (theirs and theirs < 0.25 and mine > 0.12) then stopHover() result = "low" return end
                            -- stay with the mob itself (not the middle of its area, that's what pulled you out of the field)
                            local okM, mp = pcall(function() return mon:GetPivot().Position end)
                            if r and okM and mp and ((mp - r.Position) * Vector3.new(1, 0, 1)).Magnitude > 50 then
                                Odyssey:OdysseyTpTo(Odyssey:OdysseyAwaySpot(mp, terr, 20, 35) or (mp + Vector3.new(20, 0, 20)))
                            end
                            Odyssey:OdysseyDodgeJump(mon)
                            pcall(function() Odyssey.mobToggle:SetDescription("Fighting " .. mon.Name .. (theirs and (" · " .. math.floor(theirs * 100) .. "%") or "")) end)
                            task.wait(0.6)
                        end
                        stopHover()
                        result = mon.Parent and "timeout" or "killed"
                        local lt = os.clock()
                        while running and MB.active() and os.clock() - lt < 8 do
                            local tk = Odyssey:OdysseyTokensIn(nil, pos, 45)
                            if not tk[1] then break end
                            local r = Odyssey:OdysseyRoot()
                            Odyssey:OdysseyWalkTo(Vector3.new(tk[1].part.Position.X, r and r.Position.Y or pos.Y, tk[1].part.Position.Z), 2)
                        end
                    end)
                    if result == "busy" then
                        -- something else (quests, hatching...) has the character right now: try again in a few seconds, don't give up on this mob
                        Toggles.mobWaiting = os.clock()
                        return typ .. " is ready · waiting for " .. tostring(Busy.who) .. " to finish"
                    elseif result == "killed" then
                        Odyssey:OdysseySaveMobTime(sp)
                        Window:Notify({Type = "Success", Title = "Mobs", Content = "Killed " .. typ})
                    elseif result == "low" then
                        MB.failUntil[sp.Name] = os.clock() + 60
                        local spot = Odyssey:OdysseyHiveSpot()
                        if spot then Odyssey:OdysseyTpTo(spot) end
                        task.wait(20)
                    elseif result == "none" then
                        -- nothing spawned = it's still on cooldown: save that and check again later
                        local _, _, cd0 = Odyssey:OdysseySpawnerInfo(sp)
                        Odyssey:OdysseySaveMobTime(sp, math.clamp((cd0 or 300) / 2, 60, 300))
                    else
                        MB.failUntil[sp.Name] = os.clock() + 120
                    end
                    return "Last: " .. typ .. " (" .. result .. ")"
                end
            end
        end
    end
    if soonest then return "Next mob in " .. Odyssey:OdysseyHatch_fmt(soonest) end
    return "No mobs to kill"
end

-- MB · active
function MB.active() return MB.on or next(MB.drivers) ~= nil end

-- MB · sync
function MB.sync()
    if not (running and MB.active()) or mobRunning then return end
    mobRunning = true
    task.spawn(function()
        while running and MB.active() do
            local ok, msg = pcall(function(...) return Odyssey:OdysseyMobRun(...) end)
            if MB.active() then pcall(function() Odyssey.mobToggle:SetDescription((MB.on and "" or "(for " .. tostring(next(MB.drivers)) .. ") ") .. (ok and tostring(msg) or ("error: " .. tostring(msg):sub(1, 60)))) end) end
            local t = os.clock()
            while running and MB.active() and os.clock() - t < 3 do task.wait(0.25) end
        end
        mobRunning = false
        pcall(function() Odyssey.mobToggle:SetDescription("Goes to each mob you pick when it's ready and kills it") end)
    end)
end

-- Toggles · mob drive
Toggles.mobDrive = function(who, on)
    on = on and true or nil
    if MB.drivers[who] == on then return end
    MB.drivers[who] = on
    MB.sync()
end

-- Toggles · mob on
Toggles.mobOn = function() return MB.active() end

-- Health low
function Odyssey:OdysseyHealthLow(p)
    local h = Odyssey:OdysseyHum()
    return h and h.MaxHealth > 0 and h.Health / h.MaxHealth < (p or 0.3)
end

-- Loot around
function Odyssey:OdysseyLootAround(pos, secs, on)
    local t = os.clock()
    while running and on() and os.clock() - t < secs do
        local tk = Odyssey:OdysseyTokensIn(nil, pos, 50)
        if not tk[1] then break end
        local r = Odyssey:OdysseyRoot()
        Odyssey:OdysseyWalkTo(Vector3.new(tk[1].part.Position.X, r and r.Position.Y or pos.Y, tk[1].part.Position.Z), 2)
    end
end

-- Monster named
function Odyssey:OdysseyMonsterNamed(prefix)
    local m = workspace:FindFirstChild("Monsters")
    for _, x in ipairs(m and m:GetChildren() or {}) do
        if x.Name:sub(1, #prefix) == prefix then
            local ok, p = pcall(function() return x:GetPivot().Position end)
            if ok then return x, p end
        end
    end
end

-- Go after a mob by name
function Odyssey:OdysseyChase(who, prefix, on, status)
    local mon, pos = Odyssey:OdysseyMonsterNamed(prefix)
    if not mon then return nil end
    if Odyssey:OdysseyNearestNeed(pos) > Odyssey:OdysseyBeeCount() then return "in a zone you haven't unlocked" end
    local result = "lost it"
    Odyssey:OdysseyGoDo(who, pos, function()
        local t = os.clock()
        local stopHover = Odyssey:OdysseyKeepAway(mon, nil)
        while running and on() and mon.Parent and os.clock() - t < 600 do
            if Odyssey:OdysseyHealthLow(0.3) then result = "low health" break end
            local ok, p = pcall(function() return mon:GetPivot().Position end)
            local r = Odyssey:OdysseyRoot()
            if ok and r then
                local flat = Vector3.new(p.X, r.Position.Y, p.Z)
                if (r.Position - flat).Magnitude > 50 then Odyssey:OdysseyTpTo(Odyssey:OdysseyAwaySpot(p, nil, 20, 35) or (p - Vector3.new(0, math.max(0, p.Y - r.Position.Y - 4), 0) + Vector3.new(20, 0, 20))) end
                Odyssey:OdysseyDodgeJump(mon)
                pos = p
            end
            if status then status("Fighting " .. mon.Name) end
            task.wait(0.5)
        end
        stopHover()
        if not mon.Parent then result = "defeated" end
        Odyssey:OdysseyLootAround(pos, 10, on)
        return true
    end)
    if result == "low health" then local s = Odyssey:OdysseyHiveSpot() if s then Odyssey:OdysseyTpTo(s) end end
    return result
end

-- a quest needs ants (Ant, Giant Ant, Fire Ant...) -> plays the Ant Challenge too, even with the toggle off
function Odyssey:OdysseyQuestNeedsAnts()
    if not QQ.on then return false end
    for typ in pairs(QQ.mobNeed or {}) do if tostring(typ):find("Ant") then return true end end
    return false
end

-- Ant wanted
function Odyssey:OdysseyAntWanted() return B.ant or Odyssey:OdysseyQuestNeedsAnts() end

-- Start ant run
function Odyssey:OdysseyStartAntLoop()
    if antLoopOn then return end
    antLoopOn = true
    task.spawn(function()
        while running and Odyssey:OdysseyAntWanted() do
            local msg = "Waiting"
            pcall(function()
                if not Odyssey:OdysseyToyOpen("Ant Challenge") then msg = "Ant zone isn't unlocked" return end
                local _, passes = Odyssey:OdysseyInvKey("AntPass")
                if not passes or passes < 1 then msg = "No Ant Passes" return end
                if not Odyssey:OdysseyToyReady("Ant Challenge") then msg = "Ant Challenge is on cooldown" return end
                local field = Odyssey:OdysseyFieldPart("Ant Field")
                local spot = Odyssey:OdysseyToySpot("Ant Challenge")
                if not (field and spot) then msg = "Can't find the Ant Challenge" return end
                Odyssey:OdysseyGoDo("Ant Challenge", spot, function()
                    Odyssey:OdysseyFire("ToyEvent", "Ant Challenge")
                    task.wait(3)
                    Odyssey:OdysseyTpTo(Odyssey:OdysseyFieldCenter(field))
                    local t, lastAnt, seen = os.clock(), os.clock(), false
                    while running and Odyssey:OdysseyAntWanted() and os.clock() - t < 420 do
                        if Odyssey:OdysseyHealthLow(0.25) then break end
                        local m = workspace:FindFirstChild("Monsters")
                        local ant = false
                        for _, x in ipairs(m and m:GetChildren() or {}) do if x.Name:find("Ant") then ant = true break end end
                        if ant then lastAnt, seen = os.clock(), true end
                        if seen and os.clock() - lastAnt > 20 then break end
                        local target = F.dodgeFrom(field)
                        if not target then
                            local tk = Odyssey:OdysseyTokensIn(field)
                            target = tk[1] and tk[1].part.Position or nil
                        end
                        local r = Odyssey:OdysseyRoot()
                        if target and r then Odyssey:OdysseyWalkTo(Vector3.new(target.X, r.Position.Y, target.Z), 1.5) else task.wait(0.3) end
                        pcall(function() Odyssey.aToggle:SetDescription("Playing · " .. math.floor(os.clock() - t) .. "s") end)
                    end
                    return true
                end)
                msg = "Finished an Ant Challenge" .. (B.ant and "" or " (for a quest)")
            end)
            pcall(function() Odyssey.aToggle:SetDescription((not B.ant and Odyssey:OdysseyQuestNeedsAnts() and "(for a quest) " or "") .. msg) end)
            local t = os.clock()
            while running and Odyssey:OdysseyAntWanted() and os.clock() - t < 15 do task.wait(0.5) end
        end
        antLoopOn = false
    end)
end

-- Listen to a game remote
function Odyssey:OdysseyListen(name, fn)
    local ev = Events and Events:FindFirstChild(name)
    if ev and ev:IsA("RemoteEvent") then
        Odyssey:OdysseyTrack(ev.OnClientEvent:Connect(function(...) pcall(fn, ...) end))
