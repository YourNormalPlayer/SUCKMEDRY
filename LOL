-- Your humanoid
function Odyssey:OdysseyHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end

-- Your HumanoidRootPart
function Odyssey:OdysseyRoot() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end

-- Teleport to a spot
function Odyssey:OdysseyTpTo(pos, force)
    local r = Odyssey:OdysseyRoot()
    if not (r and pos) then return false end
    if Odyssey.converting and not force then return false end
    if FF.run and not force then return false end
    if typeof(pos) == "CFrame" then pos = pos.Position end
    pcall(function() LP:RequestStreamAroundAsync(pos) end)
    r.AssemblyLinearVelocity = Vector3.new()
    r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    return true
end

-- Fire a game remote
function Odyssey:OdysseyFire(name, ...)
    if EvMod and type(EvMod.ClientCall) == "function" then
        return pcall(EvMod.ClientCall, name, ...)
    end
    local ev = Events and Events:FindFirstChild(name)
    if not ev then return false end
    if ev:IsA("RemoteFunction") then return pcall(ev.InvokeServer, ev, ...) end
    return pcall(ev.FireServer, ev, ...)
end

-- Load a game module
function Odyssey:OdysseyMod(path)
    local cur = RS
    for p in path:gmatch("[^%.]+") do cur = cur and cur:FindFirstChild(p) end
    if not (cur and cur:IsA("ModuleScript")) then return nil end
    local ok, m = pcall(require, cur)
    return ok and m or nil
end

-- feed / hatch / jelly: same call as the game, then update the game's local stats like the game does
-- (without this the quest menu sometimes doesn't see treats you fed)
function Odyssey:OdysseyHiveCall(x, y, key, amount)
    local ok, newCount, okServer, honeycomb, discovered, eggUses = Odyssey:OdysseyFire("ConstructHiveCellFromEgg", x, y, key, amount, false, nil)
    local c = Stats.cache
    if ok and okServer and type(c) == "table" and type(c.Set) == "function" then
        if newCount ~= nil then pcall(c.Set, c, {"Eggs", key}, newCount) end
        if discovered ~= nil then pcall(c.Set, c, "DiscoveredBees", discovered) end
        if honeycomb ~= nil then pcall(c.Set, c, "Honeycomb", honeycomb) end
        if eggUses ~= nil then pcall(c.Set, c, {"Totals", "EggUses"}, eggUses) end
    end
    return ok and okServer
end

-- Server time
function Odyssey:OdysseyNow()
    local v = workspace:FindFirstChild("OsTime")
    local ok, t = pcall(function() return v.Value end)
    return (ok and tonumber(t) and t > 1e9) and t or os.time()
end

-- Short number (1.2K, 3.4M)
function Odyssey:OdysseyShort(n)
    n = tonumber(n) or 0
    local s = {"", "K", "M", "B", "T", "Qd", "Qn", "Sx"}
    local i = 1
    while math.abs(n) >= 1000 and i < #s do n = n / 1000 i += 1 end
    return (i == 1 and tostring(math.floor(n)) or string.format("%.2f", n):gsub("%.?0+$", "")) .. s[i]
end

