-- Codes text
function Odyssey:OdysseyCodesText()
    local lines = {}
    local function block(title, list)
        local parts = {}
        for _, c in ipairs(list) do
            local r = codeResult[c]
            table.insert(parts, r and (c .. " (" .. r .. ")") or c)
        end
        table.insert(lines, title .. " (" .. #list .. "): " .. table.concat(parts, ", "))
    end
    block("Working", CODES_WORKING)
    -- codes the game itself said are expired / invalid while redeeming
    local said = {}
    for c, r in pairs(codeResult) do if r == "expired" then table.insert(said, c) end end
    table.sort(said)
    if #said > 0 then table.insert(lines, "Game said expired: " .. table.concat(said, ", ")) end
    table.insert(lines, "Expired (" .. #CODES_EXPIRED .. "): " .. table.concat(CODES_EXPIRED, ", "))
    return table.concat(lines, "\n\n")
end

-- listen to the game's message remotes for a moment after sending a code, and sort the answer
function Odyssey:OdysseyAnswerFor(code)
    local got
    local cons = {}
    local function scan(v, d)
        if got or (d or 0) > 3 then return end
        if type(v) == "string" and #v > 3 then got = v
        elseif type(v) == "table" then for _, x in pairs(v) do scan(x, (d or 0) + 1) end end
    end
    for _, name in ipairs({"ServerMessage", "ServerMessagePrompt", "ErrorMessage", "ReceiveAlert", "PromoCodeEvent", "ServerSystemEvent"}) do
        local rem = Events and Events:FindFirstChild(name)
        if rem and rem:IsA("RemoteEvent") then
            table.insert(cons, rem.OnClientEvent:Connect(function(...)
                local a = table.pack(...)
                for i = 1, a.n do
                    local v = a[i]
                    -- skip the stat-cache messages, they aren't about the code
                    if not (type(v) == "string" and v:find("Cache")) then scan(v) end
                end
            end))
        end
    end
    Odyssey:OdysseyFire("PromoCodeEvent", code)
    local t = os.clock()
    while not got and os.clock() - t < 2.5 do task.wait(0.1) end
    for _, c in ipairs(cons) do pcall(function() c:Disconnect() end) end
    if not got then return "no answer" end
    local l = got:lower()
    if l:find("expire") or l:find("invalid") or l:find("not valid") or l:find("doesn't exist") then return "expired" end
    if l:find("already") then return "already used" end
    if l:find("group") or l:find("club") then return "needs the club group" end
    return "redeemed"
end

-- remembers which codes each account already tried (by UserId, so alts still get them)
function Odyssey:OdysseyRedeemAll(force)
    if redeeming then return end
    redeeming = true
    local all = {}
    pcall(function() if isfile and isfile(CODE_FILE) then all = HS:JSONDecode(readfile(CODE_FILE)) end end)
    if type(all) ~= "table" then all = {} end
    local me = tostring(LP.UserId)
    if type(all[me]) ~= "table" then all[me] = {} end
    local done = all[me]
    local n = 0
    for _, c in ipairs(CODES) do
        if not running then break end
        if force or not done[c] then
            codeResult[c] = Odyssey:OdysseyAnswerFor(c)
            done[c] = true
            n += 1
            pcall(function() Odyssey.codePara:Set({Content = Odyssey:OdysseyCodesText()}) end)
            task.wait(1)
        end
    end
    for k, v in pairs(all) do if type(v) ~= "table" then all[k] = nil end end
    pcall(function() writefile(CODE_FILE, HS:JSONEncode(all)) end)
    redeeming = false
    local ok, exp = 0, 0
    for _, r in pairs(codeResult) do if r == "redeemed" then ok += 1 elseif r == "expired" then exp += 1 end end
    Window:Notify({Type = "Success", Title = "Codes", Content = n > 0 and ("Tried " .. n .. " codes · " .. ok .. " redeemed · " .. exp .. " expired") or "Already tried every code on this account"})
end

-- Claim all badges
function Odyssey:OdysseyClaimAllBadges()
    local n = 0
    pcall(function()
        Bm = Bm or Odyssey:OdysseyMod("Badges")
        if not Bm then return end
        for set in pairs(Bm.GetSets() or {}) do
            for _ = 1, 10 do
                local ok, ready = pcall(Bm.CheckIfSetIsReadyToCollect, set, Stats.all())
                if not (ok and ready) then break end
                Odyssey:OdysseyFire("BadgeEvent", "Collect", set)
                n += 1
                task.wait(0.6)
            end
        end
    end)
    return n
end

-- Quest score
function Odyssey:OdysseyQuestScore(q)
    local score = 0
    for _, t in ipairs(type(q) == "table" and type(q.Tasks) == "table" and q.Tasks or {}) do
        if t.Type == "Collect Pollen" then
            if type(t.Zone) == "string" then score += (Odyssey:OdysseyFieldOpen(t.Zone) and 0 or 100)
            elseif type(t.Color) == "string" then score += (Odyssey:OdysseyColorField(t.Color) and 1 or 100) end
        elseif t.Type == "Defeat Monsters" then
            score += (mobOpen and mobOpen(tostring(t.MonsterType)) and 5 or 100)
        elseif t.Type == "Collect Tokens" or t.Type == "Collect Goo" then
            score += 3
        else
            score += 10
        end
    end
    return score
end

