-- Gear run
function Odyssey:OdysseyGearRun()
    if not IPMod then return "Loading the game's shop data..." end
    local st = Stats.all()
    local bySlot = {}
    for _, sh in ipairs(GEAR_SHOPS) do
        for _, it in ipairs(Odyssey:OdysseyShopUsable(sh) and Odyssey:OdysseyShopItems(sh) or {}) do
            local slot = Odyssey:OdysseySlotOf(it.name)
            if slot and SH.slots[slot] and it.cost then
                bySlot[slot] = bySlot[slot] or {}
                table.insert(bySlot[slot], it)
            end
        end
    end
    local msgs = {}
    for slot, list in pairs(bySlot) do
        local bestOwned, bestOwnedCost = nil, -1
        for _, it in ipairs(list) do
            if Odyssey:OdysseyOwns(it.pack, st) and Odyssey:OdysseyHoneyCost(it.cost) > bestOwnedCost then bestOwned, bestOwnedCost = it, Odyssey:OdysseyHoneyCost(it.cost) end
        end
        local target, targetCost
        for _, it in ipairs(list) do
            local hc = Odyssey:OdysseyHoneyCost(it.cost)
            if hc > bestOwnedCost and not Odyssey:OdysseyOwns(it.pack, st) and Odyssey:OdysseyCanBuy(it.pack, it.cost, st) and (not targetCost or hc > targetCost) then target, targetCost = it, hc end
        end
        if target then
            if Odyssey:OdysseyBuyItem(target, 1) > 0 then
                Window:Notify({Type = "Success", Title = "Bought " .. target.name, Content = target.text})
                table.insert(msgs, "bought " .. target.name)
                if SH.equip then Odyssey:OdysseyEquipItem(target) end
                return table.concat(msgs, ", ")
            end
        elseif SH.equip and bestOwned and not Odyssey:OdysseyEquipped(bestOwned.pack, st) then
            if Odyssey:OdysseyEquipItem(bestOwned) then table.insert(msgs, "equipped " .. bestOwned.name) end
        end
        local nextUp, nextCost
        for _, it in ipairs(list) do
            local hc = Odyssey:OdysseyHoneyCost(it.cost)
            if hc > bestOwnedCost and not Odyssey:OdysseyOwns(it.pack, st) and (not nextCost or hc < nextCost) then nextUp, nextCost = it, hc end
        end
        if nextUp and #msgs == 0 then table.insert(msgs, slot .. " next: " .. nextUp.name .. " (" .. nextUp.text .. ")") end
    end
    return #msgs > 0 and table.concat(msgs, " · ") or "You have the best gear you can buy"
end

