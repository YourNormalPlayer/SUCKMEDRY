-- Field part
function Odyssey:OdysseyFieldPart(name)
    local fz = workspace:FindFirstChild("FlowerZones")
    local p = fz and fz:FindFirstChild(name)
    return (p and p:IsA("BasePart")) and p or nil
end

-- Field names
function Odyssey:OdysseyFieldNames()
    -- in the Hive Hub only the Hub Field is used
    if Odyssey.isHiveHub then return {"Hub Field"} end
    local list = {}
    local fz = workspace:FindFirstChild("FlowerZones")
    for _, p in ipairs(fz and fz:GetChildren() or {}) do
        -- (far-away zones are minigames, except the Hive Hub's own Hub Field)
        if p:IsA("BasePart") and ((math.abs(p.Position.X) < 5000 and math.abs(p.Position.Z) < 5000) or p.Name == "Hub Field") then table.insert(list, p.Name) end
    end
    table.sort(list)
    if #list == 0 then list = {"Sunflower Field"} end
    return list
end

-- In field
function Odyssey:OdysseyInField(part, pos, margin)
    local lp = part.CFrame:PointToObjectSpace(pos)
    margin = margin or 0
    return math.abs(lp.X) <= part.Size.X / 2 + margin and math.abs(lp.Z) <= part.Size.Z / 2 + margin and lp.Y > -6 and lp.Y < 30
end

-- Field center
function Odyssey:OdysseyFieldCenter(part) return part.Position + Vector3.new(0, part.Size.Y / 2 + 3, 0) end

-- Bee count
function Odyssey:OdysseyBeeCount()
    local n = 0
    local hc = Stats.all().Honeycomb
    for _, col in pairs(type(hc) == "table" and hc or {}) do
        if type(col) == "table" then for _, b in pairs(col) do if type(b) == "table" and b.Type then n += 1 end end end
    end
    return n
end

-- Field open
function Odyssey:OdysseyFieldOpen(name)
    if Odyssey.isHiveHub then return name == "Hub Field" end
    local need = ZONE_BEES[name]
    if need == nil then return false end
    return Odyssey:OdysseyBeeCount() >= need
end

-- Nearest need
function Odyssey:OdysseyNearestNeed(pos)
    if typeof(pos) ~= "Vector3" then return 999 end
    local best, bd
    for name, need in pairs(ZONE_BEES) do
        local p = Odyssey:OdysseyFieldPart(name)
        if p then
            local d = ((p.Position - pos) * Vector3.new(1, 0, 1)).Magnitude
            if not bd or d < bd then best, bd = need, d end
        end
    end
    return best or 999
end

-- NPC open
function Odyssey:OdysseyNpcOpen(name)
    local need = NPC_BEES[name]
    if need == nil then
        local f = workspace:FindFirstChild("NPCs")
        local m = f and f:FindFirstChild(name)
        local p = m and m:FindFirstChild("Platform")
        need = (p and p:IsA("BasePart")) and Odyssey:OdysseyNearestNeed(p.Position) or 999
    end
    return Odyssey:OdysseyBeeCount() >= need
end

-- Toy open
function Odyssey:OdysseyToyOpen(name) return Odyssey:OdysseyBeeCount() >= (TOY_BEES[name] or 999) end

-- Shop open
