Odyssey.hatchToggle = Hive:CreateToggle({
    Name = "Auto hatch eggs",
    Description = "Puts your eggs into empty hive slots",
    Flag = "AutoHatch",
    Callback = function(on)
        HV.hatch = on
        if not on then return end
        task.spawn(function()
            while running and HV.hatch do
                local msg = "No eggs or no free slots"
                pcall(function()
                    if not Odyssey:OdysseyMyHive() then msg = "Claim a hive first" return end
                    local tried = {}
                    local function nextEgg()
                        for _, egg in ipairs({"Basic", "Silver", "Gold", "Diamond"}) do
                            if HV.eggs[egg] and Odyssey:OdysseyItemCount(egg) > 0 then return egg end
                        end
                    end
                    local function firstFree()
                        for _, c in ipairs(Odyssey:OdysseyCells()) do
                            if not c.Locked and c.File == nil and not tried[c.X .. "," .. c.Y] then return c end
                        end
                    end
                    if not nextEgg() then return end
                    if not firstFree() then msg = "Hive is full" return end
                    local n = 0
                    local done = Odyssey:OdysseyGoDo("Hatching", Odyssey:OdysseyHiveSpot(), function()
                        for _ = 1, 50 do
                            if not (running and HV.hatch) then break end
                            local egg, slot = nextEgg(), firstFree()
                            if not (egg and slot) then break end
                            tried[slot.X .. "," .. slot.Y] = true
                            Odyssey:OdysseyHiveCall(slot.X, slot.Y, egg, 1, false, nil)
                            n += 1
                            for _ = 1, 10 do
                                task.wait(0.1)
                                local filled = false
                                for _, c in ipairs(Odyssey:OdysseyCells()) do if c.X == slot.X and c.Y == slot.Y and c.File ~= nil then filled = true break end end
                                if filled then break end
                            end
                        end
                        return true
                    end)
                    if done and n > 0 then
                        msg = "Hatched " .. n .. " egg" .. (n == 1 and "" or "s")
                        Window:Notify({Type = "Success", Title = "Hive", Content = msg})
                        if Hook.hatch then
                            local got = {}
                            for k in pairs(tried) do
                                local x, y = k:match("(%d+),(%d+)")
                                for _, c in ipairs(Odyssey:OdysseyCells()) do
                                    if tostring(c.X) == x and tostring(c.Y) == y and type(c.File) == "table" then table.insert(got, tostring(c.File.Type) .. " Bee") end
                                end
                            end
                            Hook.send("Hatched " .. n .. " egg" .. (n == 1 and "" or "s"), #got > 0 and table.concat(got, "\n") or nil, 0xF5B83D)
                        end
                    elseif not done then
                        msg = "Waiting to go to your hive (" .. tostring(Busy.who) .. ")"
                    end
                end)
                pcall(function() Odyssey.hatchToggle:SetDescription(msg) end)
                local t = os.clock()
                while running and HV.hatch and os.clock() - t < 3 do task.wait(0.25) end
            end
        end)
    end,
})

