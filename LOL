-- Turn a table into text
function Odyssey:OdysseyFlat(v, d)
    if type(v) ~= "table" then return tostring(v) end
    if (d or 0) > 2 then return "{...}" end
    local parts = {}
    for k, x in pairs(v) do table.insert(parts, tostring(k) .. "=" .. Odyssey:OdysseyFlat(x, (d or 0) + 1)) end
    table.sort(parts)
    return "{" .. table.concat(parts, ",") .. "}"
end

-- Mutation of
function Odyssey:OdysseyMutationOf(file)
    if type(file) ~= "table" then return nil end
    for k, v in pairs(file) do
        if tostring(k):lower():find("mut") and v ~= nil and v ~= false and not (type(v) == "table" and next(v) == nil) then
            return tostring(k) .. ": " .. Odyssey:OdysseyFlat(v)
        end
    end
    return nil
end

