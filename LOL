-- Toggle
function Odyssey:OdysseyToggle(page, o)
    local win = page.win
    local sec = Odyssey:OdysseyTarget(page, o)
    local row = Odyssey:OdysseyRow(sec, 28, true, true)
    local _, desc = Odyssey:OdysseyNameBlock(row, o.Name, o.Description, 44)
    local track = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.dark, Size = UDim2.new(0, 28, 0, 15), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0), Parent = row})
    Odyssey:OdysseyCorner(track, 8)
    local tst = Odyssey:OdysseyStroke(track)
    local knob = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.muted, Size = UDim2.new(0, 11, 0, 11), AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0), Parent = track})
    Odyssey:OdysseyCorner(knob, 6)
    local el = {Value = false, CurrentValue = false}
    local busy = false
    local function draw()
        Odyssey:OdysseyTween(track, 0.15, {BackgroundColor3 = el.Value and C.accent or C.dark})
        tst.Color = el.Value and C.accent or C.border
        Odyssey:OdysseyTween(knob, 0.15, {Position = el.Value and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
            BackgroundColor3 = el.Value and C.dark or C.muted})
    end
    function el:Set(v, quiet)
        if type(v) == "table" then v = v.CurrentValue end
        v = v == true
        el.Value, el.CurrentValue = v, v
        draw()
        Odyssey:OdysseySetFlag(win, o.Flag, v)
        if not quiet and not busy then
            busy = true
            Odyssey:OdysseySafe(o.Callback, v)
            busy = false
        end
    end
    function el:GetValue() return el.Value end
    row.MouseButton1Click:Connect(function() el:Set(not el.Value) end)
    Odyssey:OdysseyBase(el, row, desc)
    Odyssey:OdysseyIndex(sec, row, o.Name, o.Description)
    local saved = Odyssey:OdysseySaved(win, o.Flag)
    if saved ~= nil then el:Set(saved == true)
    elseif o.CurrentValue then el:Set(true)
    else el.Value = false if o.Flag then Odyssey.Flags[o.Flag] = false end draw() end
    return el
end

