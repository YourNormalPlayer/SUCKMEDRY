Window.ExtraSettings = function(tab)
    tab:CreateSection("Performance")

    tab:CreateToggle({
        Name = "Anti AFK",
        Description = "No 20 min kick",
        CurrentValue = true,
        Flag = "AntiAFK",
        Callback = function(on) antiAfk = on end,
    })

    tab:CreateToggle({
        Name = "Low graphics",
        Description = "No shadows, lowest quality, no particles",
        Flag = "LowGfx",
        Callback = function(on)
            pcall(function()
                game:GetService("Lighting").GlobalShadows = not on
                settings().Rendering.QualityLevel = on and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
            end)
            if on then
                for _, d in ipairs(workspace:GetDescendants()) do
                    if (d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")) and d.Enabled then
                        LowGfx[d] = true d.Enabled = false
                    end
                end
            else
                for d in pairs(LowGfx) do pcall(function() d.Enabled = true end) end
                LowGfx = {}
            end
        end,
    })

    tab:CreateToggle({
        Name = "Hide 3D world",
        Description = "Saves battery/FPS while you AFK",
        Callback = function(on)
            pcall(function() RunService:Set3dRenderingEnabled(not on) end)
        end,
    })
    -- these go into the UI's own SERVER section (so there's only one Server section)
    do
        local found = false
        pcall(function()
            for list, info in pairs(tab._root.secs) do
                if type(info) == "table" and info.card and info.card.Name == "Section_SERVER" then
                    tab._list = list
                    tab._needSide = nil
                    tab._side = info.col == 2 and "Right" or "Left"
                    found = true
                    break
                end
            end
        end)
        if not found then tab:CreateSection("Server") end
    end
    -- Auto rejoin: on a disconnect (or a kick, if that's on) it keeps trying to rejoin until it gets in, then loads
    -- the script again in the new server (through the Odyssey Loader + queue_on_teleport)
    do
        local RC = {on = true, kicks = true, queued = false, rejoining = false}
        local G2 = (getgenv and getgenv()) or _G
        local queue = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
        local function queueReload()
            if RC.queued or type(queue) ~= "function" then return end
            if type(G2.OdysseyBootSrc) == "string" then
                -- started from the Odyssey Loader: reload through it
                RC.queued = true
                pcall(queue, string.format("(getgenv and getgenv() or _G).OdysseyBootSrc = %q\nloadstring((getgenv and getgenv() or _G).OdysseyBootSrc)()", G2.OdysseyBootSrc))
            end
        end
        Odyssey.queueReload = queueReload -- (used by "Return to main game")
        local function kind(msg)
            msg = tostring(msg or ""):lower()
            -- kicks first: a kick message also says "Disconnected"
            if msg:find("kick", 1, true) or msg:find("error code: 267", 1, true) or msg:find("shut down", 1, true) or msg:find("shutdown", 1, true)
                or msg:find("error code: 288", 1, true) then
                return "kicked / server closed"
            end
            if msg:find("internet connection", 1, true) or msg:find("lost connection", 1, true) or msg:find("connection attempt failed", 1, true)
                or msg:find("error code: 277", 1, true) or msg:find("error code: 279", 1, true) or msg:find("connection lost", 1, true)
                or msg:find("disconnected", 1, true) then
                return "lost connection"
            end
            return nil
        end
        local function rejoin(why)
            if RC.rejoining then return end
            RC.rejoining = true
            queueReload()
            task.spawn(function()
                local TS = game:GetService("TeleportService")
                local tries = 0
                while true do
                    tries += 1
                    -- same server first (connection drops), then any server
                    if why == "lost connection" and tries <= 3 then
                        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
                    else
                        pcall(function() TS:Teleport(game.PlaceId, LP) end)
                    end
                    task.wait(math.min(5 + tries, 20))
                end
            end)
        end
        local function onError(msg)
            if not RC.on then return end
            local why = kind(msg)
            if not why or (why ~= "lost connection" and not RC.kicks) then return end
            if why == "lost connection" and G2.OdysseyReconnectOn then return end -- the loader is already handling it
