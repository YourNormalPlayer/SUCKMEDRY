-- Clamp in
function Odyssey:OdysseyClampIn(part, pos)
    local lp = part.CFrame:PointToObjectSpace(pos)
    local hx, hz = part.Size.X / 2 * 0.9, part.Size.Z / 2 * 0.9
    local x, z = math.clamp(lp.X, -hx, hx), math.clamp(lp.Z, -hz, hz)
    return part.CFrame:PointToWorldSpace(Vector3.new(x, part.Size.Y / 2 + 3, z))
end

-- F · point
function F.point(part, fieldName)
    local fx = F.fx
    if F.nearSpr and fx.sprPos and fx.sprField == fieldName then
        local a = math.random() * math.pi * 2
        local d = 4 + math.random() * 14
        return Odyssey:OdysseyClampIn(part, fx.sprPos + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d))
    end
    if F.pattern == "Snake" then
        local cols, rows = 6, 8
        fx.idx = (fx.idx % (cols * rows)) + 1
        local row = math.floor((fx.idx - 1) / cols)
        local col = (fx.idx - 1) % cols
        if row % 2 == 1 then col = cols - 1 - col end
        local x = (col / (cols - 1) - 0.5) * part.Size.X * 0.8
        local z = (row / (rows - 1) - 0.5) * part.Size.Z * 0.8
        return part.CFrame:PointToWorldSpace(Vector3.new(x, part.Size.Y / 2 + 3, z))
    elseif F.pattern == "Circle" then
        fx.idx = (fx.idx % 16) + 1
        local a = fx.idx / 16 * math.pi * 2
        local rx, rz = part.Size.X * 0.35, part.Size.Z * 0.35
        return part.CFrame:PointToWorldSpace(Vector3.new(math.cos(a) * rx, part.Size.Y / 2 + 3, math.sin(a) * rz))
    end
    return Odyssey:OdysseyRandomInField(part)
end

-- the spot in the field that's farthest from every mob (picks the best of 12 random spots)
function F.safeSpot(part)
    local m = workspace:FindFirstChild("Monsters")
    local mons = {}
    for _, x in ipairs(m and m:GetChildren() or {}) do
        local ok, p = pcall(function() return x:GetPivot().Position end)
        if ok and p and Odyssey:OdysseyInField(part, p, 40) then table.insert(mons, p) end
    end
    local best, bd
    for _ = 1, 12 do
        local pt = Odyssey:OdysseyRandomInField(part)
        local d = math.huge
        for _, p in ipairs(mons) do d = math.min(d, ((pt - p) * Vector3.new(1, 0, 1)).Magnitude) end
        if not bd or d > bd then best, bd = pt, d end
    end
    return best
end

-- mobs in (or right next to) this field
function F.mobsIn(part)
    local m = workspace:FindFirstChild("Monsters")
    local out = {}
    for _, x in ipairs(m and m:GetChildren() or {}) do
        local ok, p = pcall(function() return x:GetPivot().Position end)
        if ok and p and Odyssey:OdysseyInField(part, p, 30) then table.insert(out, p) end
    end
    return out
end

-- does walking from a to b go within 25 studs of a mob? (flat distance from the mob to the line)
function F.pathNearMob(a, b, mobs)
    local flat = Vector3.new(1, 0, 1)
    a, b = a * flat, b * flat
    local ab = b - a
    local len2 = ab:Dot(ab)
    for _, p in ipairs(mobs) do
        local q = p * flat
        local t = len2 > 0 and math.clamp((q - a):Dot(ab) / len2, 0, 1) or 0
        if (q - (a + ab * t)).Magnitude < 25 then return true end
    end
    return false
end

-- a mob got close: teleport to another part of the field
function F.dodgeTp(part)
    if Odyssey.converting or os.clock() - (F.fx.lastDodge or 0) < 1.2 then return nil end
    F.fx.lastDodge = os.clock()
    local spot = F.safeSpot(part)
    if spot then Odyssey:OdysseyTpTo(spot) end
    return spot
end

-- F · dodge from
function F.dodgeFrom(part)
    local r = Odyssey:OdysseyRoot()
    local m = workspace:FindFirstChild("Monsters")
    if not (r and m) then return nil end
    for _, x in ipairs(m:GetChildren()) do
        local ok, p = pcall(function() return x:GetPivot().Position end)
        if ok and p and (p - r.Position).Magnitude < 22 then
            local spot = F.dodgeTp(part)
            if spot then return spot end
            local away = (r.Position - p) * Vector3.new(1, 0, 1)
            if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
            return Odyssey:OdysseyClampIn(part, r.Position + away.Unit * 30)
        end
    end
    return nil
end

