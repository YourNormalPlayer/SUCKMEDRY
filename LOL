-- Header tabs for the open page
function Odyssey:OdysseyBuildHeader(win)
    local bar = win._headTabs
    for _, c in ipairs(bar:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local page = win._current
    if not page then return end
    local items = {}
    if page.kind == "home" then
        items = {{"Overview", function() Odyssey:OdysseyHomeSub(win, "Overview") end, win._homeSub == "Overview"},
            {"Full Updates", function() Odyssey:OdysseyHomeSub(win, "Updates") end, win._homeSub == "Updates"},
            {"Bug Fixes", function() Odyssey:OdysseyHomeSub(win, "Fixes") end, win._homeSub == "Fixes"}}
    elseif page.kind == "search" then
        items = {{"Search results", function() end, true}}
    else
        for _, g in ipairs(Odyssey:OdysseyGroups(page)) do
            table.insert(items, {g, function()
                page.subSel = g
                Odyssey:OdysseyApplySub(win, page)
            end, g == page.subSel})
        end
    end
    local function paint(btn, on)
        btn:SetAttribute("On", on)
        btn.BackgroundColor3 = on and C.accent or C.panel
        btn.BackgroundTransparency = on and 0 or 1
        btn.TextColor3 = on and C.dark or C.muted
        btn.FontFace = on and FONT_BOLD or FONT_MED
    end
    for i, it in ipairs(items) do
        local b = Odyssey:OdysseyNew("TextButton", {
            Name = "Head_" .. it[1],
            AutoButtonColor = false,
            BackgroundColor3 = C.panel,
            FontFace = FONT,
            TextSize = 11,
            TextColor3 = C.muted,
            Text = it[1],
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2.new(0, 0, 0, 22),
            LayoutOrder = i,
            Parent = bar,
        })
        Odyssey:OdysseyCorner(b, 11)
        Odyssey:OdysseyPad(b, 0, 11, 0, 11)
        paint(b, it[3])
        b.MouseEnter:Connect(function() if not b:GetAttribute("On") then b.BackgroundTransparency = 0.3 b.TextColor3 = C.white end end)
        b.MouseLeave:Connect(function() if not b:GetAttribute("On") then b.BackgroundTransparency = 1 b.TextColor3 = C.muted end end)
        b.MouseButton1Click:Connect(function()
            it[2]()
            for _, o in ipairs(bar:GetChildren()) do
                if o:IsA("TextButton") then paint(o, o == b) end
            end
        end)
    end
end

-- Scroll a page to a section
function Odyssey:OdysseyScrollTo(win, page, card, flash)
    local sf = page.frame
    task.defer(function()
        local s = (win.Scale and win.Scale.Scale) or 1
        local y = (card.AbsolutePosition.Y - sf.AbsolutePosition.Y) / s + sf.CanvasPosition.Y
        Odyssey:OdysseyTween(sf, 0.25, {CanvasPosition = Vector2.new(0, math.max(0, y - 6))})
        if flash then
            local st = flash:FindFirstChildOfClass("UIStroke") or Odyssey:OdysseyStroke(flash, C.accent)
            local old = st.Color
            st.Color = C.accent
            task.delay(1.2, function() pcall(function() st.Color = old end) end)
        end
    end)
end

-- Open a page
function Odyssey:OdysseyOpenPage(win, page)
    for _, p in ipairs(win._pages) do
        p.frame.Visible = (p == page)
        if p.button then
            local on = (p == page)
            p.button.BackgroundTransparency = on and 0 or 1
            p.button.Label.TextColor3 = on and C.white or C.muted
        end
    end
    win._searchPage.frame.Visible = (page == win._searchPage)
    win._current = page
    Odyssey:OdysseyBuildHeader(win)
    if page.root then Odyssey:OdysseyFill(win, page) end
end

