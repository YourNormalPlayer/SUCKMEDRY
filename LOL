-- Nearest petal
function Odyssey:OdysseyNearestPetal(c)
    local best, bd
    for name, pc in pairs(PETALS) do
        local d = (c.R - pc.R) ^ 2 + (c.G - pc.G) ^ 2 + (c.B - pc.B) ^ 2
        if not bd or d < bd then best, bd = name, d end
    end
    return best
end

-- a bloom's colors = the colors of its petals (a set, plus a label like "Cyan/Green")
function Odyssey:OdysseyBloomColors(m)
    local set, order = {}, {}
    for _, d in ipairs(m:GetDescendants()) do
        if d.Name == "Petal" and d:IsA("BasePart") then
            local name = Odyssey:OdysseyNearestPetal(d.Color)
            if name and not set[name] then set[name] = true table.insert(order, name) end
        end
    end
    if #order == 0 then set.White = true order = {"White"} end
    table.sort(order)
    return set, table.concat(order, "/")
end

-- Find blooms in the fields
function Odyssey:OdysseyBlooms()
    local hp = workspace:FindFirstChild("Happenings")
    local f = hp and hp:FindFirstChild("PoppablePlants")
    local list = {}
    for _, m in ipairs(f and f:GetChildren() or {}) do
        local ok, p = pcall(function() return m:IsA("Model") and m:GetPivot().Position or m.Position end)
        if ok and p then
            for _, n in ipairs(Odyssey:OdysseyFieldNames()) do
                local fp = Odyssey:OdysseyFieldPart(n)
                if fp and Odyssey:OdysseyInField(fp, p, 4) then
                    if Odyssey:OdysseyFieldOpen(n) then
                        local set, col = Odyssey:OdysseyBloomColors(m)
                        local want = false
                        for name in pairs(set) do if BM.colors[name] then want = true break end end
                        -- quests that need petals take any color
                        if want or (QQ.on and QQ.wantBlooms and not BM.on) then table.insert(list, {m = m, pos = p, field = n, color = col}) end
                    end
                    break
                end
            end
        end
    end
    local r = Odyssey:OdysseyRoot()
    if r then table.sort(list, function(a, b) return (a.pos - r.Position).Magnitude < (b.pos - r.Position).Magnitude end) end
    return list
end

-- Stop everything and clean up
function Odyssey:OdysseyStop()
    if not running then return end
    running = false
    F.on, D.on, I.on = false, false, false
    QQ.on, MB.on, HV.hatch, HV.feed, PL.on = false, false, false, false, false
    SH.gear, SH.egg, SH.tt = false, false, false
    for d in pairs(LowGfx) do pcall(function() d.Enabled = true end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(Odyssey.OdysseyStopFly, Odyssey)
    pcall(function() if Odyssey.OdysseyStopFreecam then Odyssey.OdysseyStopFreecam() end end)
    pcall(function() for p in pairs(touched) do if p.Parent then p.CanCollide = true end end end)
    pcall(function()
        local h = Odyssey:OdysseyHum()
        if h then if baseWS then h.WalkSpeed = baseWS end if baseJP then h.JumpPower = baseJP end end
    end)
    pcall(function() RunService:Set3dRenderingEnabled(true) end)
    G.OdysseyBeeSwarmStop = nil
end

