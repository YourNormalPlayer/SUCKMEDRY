    local no = Odyssey:OdysseyPill(row, tostring(o.CancelText or "Cancel"), false, 1)
    local yes = Odyssey:OdysseyPill(row, tostring(o.ConfirmText or "Confirm"), true, 2)
    no.ZIndex, yes.ZIndex = 53, 53
