    local box = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.panel, Size = UDim2.new(0, 300, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 51, Parent = dim})
    Odyssey:OdysseyCorner(box, 8)
    Odyssey:OdysseyStroke(box)
    Odyssey:OdysseyPad(box, 12, 12, 12, 12)
    Odyssey:OdysseyList(box, 8)
    Odyssey:OdysseyText({Text = tostring(o.Title or "Are you sure?"), Font = FONT_BOLD, Size = 13, Color = C.white, Order = 1, Z = 52, Parent = box})
    Odyssey:OdysseyText({Text = tostring(o.Content or ""), Size = 11, Color = C.muted, Wrap = true, Order = 2, Z = 52,
        Sz = UDim2.new(1, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Parent = box})
    local row = Odyssey:OdysseyNew("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 3, ZIndex = 52, Parent = box})
    local l = Odyssey:OdysseyList(row, 6, Enum.FillDirection.Horizontal)
