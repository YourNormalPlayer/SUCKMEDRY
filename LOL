-- Built-in Settings tab
function Odyssey:OdysseySettingsTab(win)
    local page = Odyssey:OdysseyPage(win, {Name = "Settings", Order = 1e9}, "tab")
    page.kind = "tab"
    page.settings = true
    local tab = Odyssey:OdysseyTabApi(page)
    page.api = tab
    page.button = Odyssey:OdysseyTabButton(win, "Settings", "⚙️", 10000)
    page.button.MouseButton1Click:Connect(function() Odyssey:OdysseyOpenPage(win, page) end)
    tab:CreateSection("Interface")
    tab:CreateSlider({
        Name = "UI Size",
        Range = {50, 150},
        Increment = 5,
        CurrentValue = win._autoScale or 100,
        Suffix = "%",
        Flag = "HoloScale",
        Callback = function(v)
            if win.FitScale then win.FitScale(v / 100) else win.Scale.Scale = v / 100 end
        end,
    })
    tab:CreateBind({
        Name = "Show / hide key",
        CurrentKeybind = Odyssey:OdysseyKeyName(win.toggleKey),
        Flag = "HoloToggleKey",
        Callback = function() end,
    })
    tab:CreateButton({
        Name = "Close Odyssey",
        Description = "Stops the script and removes the menu",
        Style = "Danger",
        Callback = function()
            Odyssey:OdysseyConfirm(win, {Title = "Close Odyssey?", Content = "Everything stops. Run the script again to get it back.",
                ConfirmText = "Close", OnConfirm = function() win:Destroy() end})
        end,
    })
    tab:Side("Right")
    tab:CreateSection("Config")
    tab:CreateParagraph({Title = "Saved settings", Content = "Every toggle, slider and dropdown saves by itself to " .. Odyssey:OdysseyConfigPath(win)})
    tab:CreateButton({
        Name = "Reset settings",
        Description = "Clears the saved file. Run the script again after",
        Callback = function()
            Odyssey:OdysseyConfirm(win, {Title = "Reset settings?", Content = "Your saved toggles and picks are cleared.", ConfirmText = "Reset",
                OnConfirm = function()
                    pcall(function() if delfile then delfile(Odyssey:OdysseyConfigPath(win)) else writefile(Odyssey:OdysseyConfigPath(win), "{}") end end)
                    win._saveGen = (win._saveGen or 0) + 1000
                    win._noSave = true
                    win:Notify({Type = "Success", Content = "Settings cleared · run the script again"})
                end})
        end,
    })
    tab:Side("Left")
    win._settings = page
    return page
end

