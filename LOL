-- Slider
function Odyssey:OdysseySlider(page, o)
    local win = page.win
    local sec = Odyssey:OdysseyTarget(page, o)
    local row = Odyssey:OdysseyRow(sec, 40, true, true)
    local lo, hi = (o.Range and o.Range[1]) or 0, (o.Range and o.Range[2]) or 100
    local inc = tonumber(o.Increment) or 1
    local holder = Odyssey:OdysseyNew("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row})
    Odyssey:OdysseyList(holder, 4)
    Odyssey:OdysseyPad(holder, 6, 8, 8, 8)
    local top = Odyssey:OdysseyNew("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 15), LayoutOrder = 1, Parent = holder})
    Odyssey:OdysseyText({Text = tostring(o.Name or ""), Size = 12, Sz = UDim2.new(1, -70, 1, 0), Parent = top})
    local val = Odyssey:OdysseyText({Text = "", Size = 11, Color = C.accent, Font = FONT_MED, AlignX = Enum.TextXAlignment.Right,
        Sz = UDim2.new(0, 70, 1, 0), Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, 0, 0, 0), Parent = top})
    local desc = Odyssey:OdysseyText({Text = tostring(o.Description or ""), Size = 10, Color = C.muted, Wrap = true, Order = 2,
        Sz = UDim2.new(1, 0, 0, 0), Auto = Enum.AutomaticSize.Y, Parent = holder})
    desc.Visible = (o.Description or "") ~= ""
    local bar = Odyssey:OdysseyNew("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.dark, Size = UDim2.new(1, 0, 0, 6),
        LayoutOrder = 3, Parent = holder})
    Odyssey:OdysseyCorner(bar, 3)
    local fill = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.accent, Size = UDim2.new(0, 0, 1, 0), Parent = bar})
    Odyssey:OdysseyCorner(fill, 3)
    local knob = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.white, Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), Parent = bar})
    Odyssey:OdysseyCorner(knob, 6)
    local el = {Value = lo, CurrentValue = lo}
    local function fmt(v)
        local s = (inc < 1) and string.format("%." .. math.clamp(#tostring(inc) - 2, 1, 3) .. "f", v) or tostring(math.floor(v + 0.5))
        return s .. (o.Suffix and (" " .. tostring(o.Suffix)) or "")
    end
    local function snap(v)
        v = math.clamp(tonumber(v) or lo, lo, hi)
        v = lo + math.floor((v - lo) / inc + 0.5) * inc
        return math.clamp(v, lo, hi)
    end
    local function draw()
        local a = hi > lo and (el.Value - lo) / (hi - lo) or 0
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        val.Text = fmt(el.Value)
    end
    function el:Set(v, quiet)
        if type(v) == "table" then v = v.CurrentValue end
        v = snap(v)
        local changed = v ~= el.Value
        el.Value, el.CurrentValue = v, v
        draw()
        Odyssey:OdysseySetFlag(win, o.Flag, v)
        if not quiet and (changed or quiet == false) then Odyssey:OdysseySafe(o.Callback, v) end
    end
    function el:GetValue() return el.Value end
    local dragging = false
    local function at(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
        el:Set(lo + a * (hi - lo))
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            at(i.Position.X)
        end
    end)
    table.insert(win._conns, UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    table.insert(win._conns, UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then at(i.Position.X) end
    end))
    Odyssey:OdysseyBase(el, row, desc)
    Odyssey:OdysseyIndex(sec, row, o.Name, o.Description)
    local saved = Odyssey:OdysseySaved(win, o.Flag)
    if saved ~= nil then
        el.Value = snap(saved) - 1e9
        el:Set(saved)
    else
        el.Value = snap(o.CurrentValue or lo)
        el.CurrentValue = el.Value
        if o.Flag then Odyssey.Flags[o.Flag] = el.Value end
        draw()
    end
    return el
end

