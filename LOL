-- Quick tween
function Odyssey:OdysseyTween(o, t, props)
    local tw = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

-- Safe call (errors go to the console, never stop the UI). Runs in its own thread: a callback that
-- calls the game can't lower the access of the script that made the element
function Odyssey:OdysseySafe(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(fn, table.unpack(args, 1, args.n))
        if not ok then warn("[Odyssey UI] " .. tostring(err)) end
    end)
    Odyssey:OdysseyAccess()
end

-- Where the UI lives
function Odyssey:OdysseyGuiParent()
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h then return h end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then
        local test = pcall(function() local f = Instance.new("Folder") f.Parent = cg f:Destroy() end)
        if test then return cg end
    end
    return LP:WaitForChild("PlayerGui")
end

-- Drag a frame by a handle
function Odyssey:OdysseyDrag(handle, target, win)
    local dragging, start, startPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, start, startPos = true, i.Position, target.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    local c = UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    if win then table.insert(win._conns, c) end
end

