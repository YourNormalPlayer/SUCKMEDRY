-- Free ready
function Odyssey:OdysseyFreeReady()
    local st = Stats.all()
    local StatTools, OsTime = Odyssey:OdysseyMod("StatTools"), Odyssey:OdysseyMod("OsTime")
    if not (StatTools and type(StatTools.GetLastCooldownTime) == "function") then return false end
    local ok, last = pcall(StatTools.GetLastCooldownTime, st, "StickBugFreeEntry")
    local okT, nowT = pcall(function() return type(OsTime) == "function" and OsTime() or Odyssey:OdysseyNow() end)
    if not (ok and okT) then return false end
    return (nowT - (tonumber(last) or 0)) >= 129600, 129600 - (nowT - (tonumber(last) or 0))
end

-- Ground at
function Odyssey:OdysseyGroundAt(p)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ex = {LP.Character}
    local m = workspace:FindFirstChild("Monsters")
    if m then table.insert(ex, m) end
    local col = workspace:FindFirstChild("Collectibles")
    if col then table.insert(ex, col) end
    params.FilterDescendantsInstances = ex
    local hit = workspace:Raycast(p + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), params)
    return hit and hit.Position
end

