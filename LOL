pcall(function()
    local roots = Window._roots
    if type(roots) ~= "table" then return end
    local function tabOf(root)
        local page = root.colsFrame and root.colsFrame.Parent
        return page and tostring(page.Name):gsub("^Page_", "") or nil
    end
    local byTab = {}
    for _, root in ipairs(roots) do local t = tabOf(root) if t then byTab[t] = root end end
    local function secName(card) return (tostring(card.Name):gsub("^Section_", "")) end
    for _, mv in ipairs(MOVES) do
        local from, to = byTab[mv[1]], byTab[mv[3]]
        if from and to then
            for i, card in ipairs(from.cards) do
                if secName(card) == mv[2] then
                    table.remove(from.cards, i)
                    table.insert(to.cards, card)
                    -- search should show these settings under their new tab
                    local newPage = to.colsFrame and to.colsFrame.Parent
                    for _, it in ipairs(Window._searchItems or {}) do if it.sec == card and newPage then it.page = newPage end end
                    break
                end
            end
        end
    end
    -- fold small panels into bigger ones: their header and contents move in as a sub-part
    local function parts(card)
        local vl
        for _, c in ipairs(card:GetChildren()) do if c:IsA("Frame") then vl = c break end end
        if not vl then return nil end
        local head, list
        for _, c in ipairs(vl:GetChildren()) do
            if c:IsA("Frame") then
                if c.LayoutOrder == 0 then head = c elseif c.LayoutOrder == 1 then list = c end
            end
        end
        return vl, head, list
    end
    local sItems, sSecs = Window._searchItems or {}, Window._searchSections or {}
    for _, mg in ipairs(MERGES) do
        local root = byTab[mg[1]]
        if root then
            local function find(n) for i, c in ipairs(root.cards) do if secName(c) == n then return c, i end end end
            local target = find(mg[2])
            local tvl, thead
            if target then tvl, thead = parts(target) end
            if tvl then
                if mg[3] and thead then
                    for _, l in ipairs(thead:GetDescendants()) do if l:IsA("TextLabel") then l.Text = mg[3]:upper() end end
                end
                for k = 4, #mg do
                    local src, si = find(mg[k])
                    local svl, shead, slist
                    if src then svl, shead, slist = parts(src) end
                    if slist then
                        local gap = Instance.new("Frame")
                        gap.BackgroundTransparency, gap.Size, gap.LayoutOrder = 1, UDim2.new(1, 0, 0, 4), k * 10
                        gap.Parent = tvl
                        if shead then
                            shead.LayoutOrder = k * 10 + 1
                            for _, l in ipairs(shead:GetDescendants()) do if l:IsA("TextLabel") then l.TextTransparency = 0.25 end end
                            shead.Parent = tvl
                        end
                        slist.LayoutOrder = k * 10 + 2
                        slist.Parent = tvl
                        -- search: its settings now belong to the bigger panel
                        for _, it in ipairs(sItems) do if it.sec == src then it.sec = target end end
                        for i = #sSecs, 1, -1 do if sSecs[i] == src then table.remove(sSecs, i) end end
                        table.remove(root.cards, si)
                        src.Visible = false
                    end
                end
            end
        end
    end
    for tab, lay in pairs(LAYOUT) do
        local root = byTab[tab]
        if root then
            local rank = {}
            for col, names in pairs({[1] = lay.Left, [2] = lay.Right}) do
                for i, n in ipairs(names) do rank[n] = rank[n] or {col = col, i = i} end
            end
            local orig = {}
            for i, card in ipairs(root.cards) do orig[card] = i end
            local function key(card)
                local r = rank[secName(card)]
                if r then return r.col * 1000 + r.i end
                return (card:GetAttribute("Col") or 1) * 1000 + 500 + orig[card]
            end
            for _, card in ipairs(root.cards) do
                local r = rank[secName(card)]
                if r then card:SetAttribute("Col", r.col) end
            end
            table.sort(root.cards, function(a, b) return key(a) < key(b) end)
        end
    end
    -- moved sections also need their new tab's columns
    for _, root in ipairs(roots) do
        for _, card in ipairs(root.cards) do card.Parent = root.cols[1] end
        -- a tab that only gets moved-in panels (Field Bonuses) has to show its columns
        if #root.cards > 0 and root.colsFrame then root.colsFrame.Visible = true end
    end
    Window:_relayoutTabs(Window._compact)
end)
