    card:SetAttribute("Col", col)
    card:SetAttribute("Wide", false)
    if page.subTab then card:SetAttribute("Sub", page.subTab) end
    Odyssey:OdysseyCorner(card, 6)
    Odyssey:OdysseyStroke(card)
    local body = Odyssey:OdysseyNew("Frame", {Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Parent = card})
    Odyssey:OdysseyPad(body, 8, 9, 8, 9)
    Odyssey:OdysseyList(body, 5)
    local head = Odyssey:OdysseyNew("Frame", {Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 0, Parent = body})
    Odyssey:OdysseyText({Text = tostring(name or ""):upper(), Font = FONT_BOLD, Size = 10, Color = C.muted, Sz = UDim2.new(1, 0, 1, 0), Parent = head})
    if not name or name == "" then head.Visible = false end
    local list = Odyssey:OdysseyNew("Frame", {Name = "List", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = body})
    Odyssey:OdysseyList(list, 5)
    table.insert(page.root.cards, card)
    card.LayoutOrder = #page.root.cards
    table.insert(win._searchSections, card)
    local sec = {card = card, list = list, page = page, col = col, n = 0, name = name}
    page.lastByCol[col] = sec
    page.section = sec
    page.root.colsFrame.Visible = true
    if not page.applyQueued then
        page.applyQueued = true
        task.delay(0.2, function()
            page.applyQueued = false
            Odyssey:OdysseyApplySub(win, page)
            if win._current == page then Odyssey:OdysseyBuildHeader(win) end
        end)
    end
    -- new sections stay hidden until the tab sorts them (no flash of every section at once)
    if page.subSel and Odyssey:OdysseyShownUnder(page, card) ~= page.subSel then card.Visible = false end
    Odyssey:OdysseyFill(win, page)
    return sec
end

local GRID_QUEUED = setmetatable({}, {__mode = "k"})

-- Side by side grid: in a full-width section, toggles / buttons / sliders go two per line;
-- dropdowns, labels and paragraphs keep the whole line
function Odyssey:OdysseyGrid(card)
    if not card or GRID_QUEUED[card] then return end
    local body = card:FindFirstChild("Body")
    if not body then return end
    local wide = card:GetAttribute("Wide") == true
    for _, list in ipairs(body:GetChildren()) do
        if list.Name == "List" then
            -- take every row back out of its line
            local rows = {}
            for _, c in ipairs(list:GetChildren()) do
                if c.Name == "GridLine" then
                    for _, r in ipairs(c:GetChildren()) do
                        if r:IsA("GuiObject") then r.Position = UDim2.new() r.Parent = list end
                    end
                    c:Destroy()
                end
            end
            for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then table.insert(rows, c) end end
            table.sort(rows, function(x, y) return x.LayoutOrder < y.LayoutOrder end)
            for _, r in ipairs(rows) do r.Size = UDim2.new(1, 0, 0, r.Size.Y.Offset) end
            if wide then
                -- pair each option with the next one that can share a line, even past a dropdown or label in between
                local used = {}
                local pairsList = {}
                for i, a in ipairs(rows) do
                    if not used[a] and a:GetAttribute("Half") and a.Visible then
                        for j = i + 1, #rows do
                            local b = rows[j]
                            if not used[b] and b:GetAttribute("Half") and b.Visible then
                                used[a], used[b] = true, true
                                table.insert(pairsList, {a, b})
                                break
                            end
                        end
                    end
                end
                for _, pr in ipairs(pairsList) do
                    local a, b = pr[1], pr[2]
                    do
                        local line = Odyssey:OdysseyNew("Frame", {Name = "GridLine", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                            AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = a.LayoutOrder, Parent = list})
                        a.Parent, b.Parent = line, line
                        a.Size = UDim2.new(0.5, -3, 0, a.Size.Y.Offset)
                        b.Size = UDim2.new(0.5, -3, 0, b.Size.Y.Offset)
                        a.Position = UDim2.new(0, 0, 0, 0)
                        b.Position = UDim2.new(0.5, 3, 0, 0)
                    end
                end
            end
        end
    end
end

-- Which section a new element goes in
function Odyssey:OdysseyTarget(page, opts)
    local want = (type(opts) == "table" and opts.Side == "Right") and 2 or ((type(opts) == "table" and opts.Side == "Left") and 1 or nil)
    if want then
        if page.section and page.section.col == want then return page.section end
        return page.lastByCol[want] or Odyssey:OdysseySection(page, "", want)
    end
    return page.section or Odyssey:OdysseySection(page, "", page.col)
end

-- Element row frame
function Odyssey:OdysseyRow(sec, height, box, half)
    sec.n += 1
    local row = Odyssey:OdysseyNew(box and "TextButton" or "Frame", {
        Name = "Row",
        BackgroundColor3 = C.item,
        BackgroundTransparency = box and 0 or 1,
        Size = UDim2.new(1, 0, 0, height or 26),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = sec.n,
        Parent = sec.list,
    })
    if half then row:SetAttribute("Half", true) end
    local card = sec.card
    if not GRID_QUEUED[card] then
        GRID_QUEUED[card] = true
        task.delay(0.25, function()
            GRID_QUEUED[card] = nil
            Odyssey:OdysseyGrid(card)
        end)
    end
    if row:IsA("TextButton") then row.AutoButtonColor = false row.Text = "" end
    if box then
        row.BackgroundTransparency = 0.15
        Odyssey:OdysseyCorner(row, 6)
        if row:IsA("TextButton") then
            row.MouseEnter:Connect(function() Odyssey:OdysseyTween(row, 0.12, {BackgroundTransparency = 0}) end)
            row.MouseLeave:Connect(function() Odyssey:OdysseyTween(row, 0.12, {BackgroundTransparency = 0.15}) end)
        end
    end
    return row
end

-- Name + description block on the left of a row
function Odyssey:OdysseyNameBlock(row, name, desc, rightSpace)
    local holder = Odyssey:OdysseyNew("Frame", {Name = "Text", BackgroundTransparency = 1, Size = UDim2.new(1, -(rightSpace or 0), 0, 0),
