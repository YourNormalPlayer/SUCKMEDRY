Odyssey.caBtn = Farm:CreateButton({
    Name = "Collect everything on the map",
    Description = "Teleports to every token on the map, then brings you back. Press again to stop",
    Callback = function()
        if CA.busy then CA.stop = true return end
        task.spawn(function()
            local r = Odyssey:OdysseyRoot()
            if not r then return end
            if not Busy.take("Collect all") then
                Window:Notify({Type = "Warning", Content = "Wait for " .. tostring(Busy.who) .. " to finish first"})
                return
            end
            CA.busy, CA.stop = true, false
            local back = r.Position
            local got, t0 = 0, os.clock()
            pcall(function()
                local col = workspace:FindFirstChild("Collectibles")
                local left = {}
                for _, t in ipairs(col and col:GetChildren() or {}) do
                    if t:IsA("BasePart") and t.Transparency < 1 and not Odyssey:OdysseyIsHidden(t) then table.insert(left, t) end
                end
                local total = #left
                -- always go to the closest one next, so it doesn't zig-zag across the map
                local pos = back
                while #left > 0 and running and not CA.stop and os.clock() - t0 < 90 do
                    local bi, bd
                    for i, t in ipairs(left) do
                        local d = t.Parent and (t.Position - pos).Magnitude or math.huge
                        if not bd or d < bd then bi, bd = i, d end
                    end
                    local t = table.remove(left, bi)
                    if t and t.Parent and t.Transparency < 1 then
                        Busy.at = os.clock()
                        local rr = Odyssey:OdysseyRoot()
                        if rr then
                            rr.AssemblyLinearVelocity = Vector3.new()
                            rr.CFrame = CFrame.new(t.Position)
                        end
                        pos = t.Position
                        got += 1
                        pcall(function() Odyssey.caBtn:SetDescription("Collecting " .. got .. " / " .. total .. " - press to stop") end)
                        task.wait(0.12)
                        -- still there after standing on it = a hidden token: remember it and never go back
                        local tok, spot = t, Odyssey:OdysseySpotKey(t.Position)
                        task.delay(0.6, function()
                            if tok.Parent and tok.Transparency < 1 and not skip[spot] then
                                skip[spot] = true
                                got -= 1
                                Odyssey:OdysseySaveSkip()
                            end
                        end)
                    end
                end
            end)
            Odyssey:OdysseyTpTo(back)
            Busy.free("Collect all")
            CA.busy = false
            pcall(function() Odyssey.caBtn:SetDescription("Teleports to every token on the map, then brings you back. Press again to stop") end)
            Window:Notify({Content = (CA.stop and "Stopped - " or "Done - ") .. "went to " .. got .. " tokens"})
        end)
    end,
})

