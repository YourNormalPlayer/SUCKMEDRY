Odyssey.plantToggle = Items:CreateToggle({
    Name = "Auto planters",
    Description = "Plants in your fields and harvests when they're grown",
    Flag = "AutoPlanters",
    Callback = function(on)
        PL.on = on
        if not on then return end
        task.spawn(function()
            while running and PL.on do
                local msg = "Waiting"
                pcall(function()
                    local mine, can = Odyssey:OdysseyMyPlanters()
                    if not can then msg = "Your executor can't read planters" return end
                    for _, p in ipairs(mine) do
                        if (tonumber(p.GrowthPercent) or 0) * 100 >= PL.at and typeof(p.Pos) == "Vector3" then
                            Odyssey:OdysseyGoDo("Planters", p.Pos, function()
                                Odyssey:OdysseyFire("PlanterModelCollect", p.ActorID)
                                task.wait(1.5)
                                return true
                            end)
                            msg = "Harvested a " .. tostring(p.Type)
                            Window:Notify({Type = "Success", Title = "Planters", Content = msg})
                            return
                        end
                    end
                    if #mine >= PL.max then
                        local best = 0
                        for _, p in ipairs(mine) do best = math.max(best, tonumber(p.GrowthPercent) or 0) end
                        msg = #mine .. " growing · best " .. math.floor(best * 100) .. "%"
                        return
                    end
                    local used = {}
                    for _, p in ipairs(mine) do
                        for name in pairs(PL.fields) do
                            local fp = Odyssey:OdysseyFieldPart(name)
                            if fp and typeof(p.Pos) == "Vector3" and Odyssey:OdysseyInField(fp, p.Pos, 2) then used[name] = true end
                        end
                    end
                    local field
                    for _, n in ipairs(Odyssey:OdysseyFieldNames()) do if PL.fields[n] and Odyssey:OdysseyFieldOpen(n) and not used[n] then field = n break end end
                    if not field then msg = #mine .. " growing · pick more fields to plant more" return end
                    local kind
                    for _, n in ipairs(PLANTERS) do if PL.types[n] and Odyssey:OdysseyItemCount(n) > 0 then kind = n break end end
                    if not kind then msg = "No planters left of the ones you picked" return end
                    local fp = Odyssey:OdysseyFieldPart(field)
                    Odyssey:OdysseyGoDo("Planters", Odyssey:OdysseyFieldCenter(fp), function()
                        Odyssey:OdysseyUseItem(kind)
                        task.wait(2)
                        return true
                    end)
                    msg = "Planted a " .. kind .. " in " .. field
                    Window:Notify({Type = "Success", Title = "Planters", Content = msg})
                end)
                pcall(function() Odyssey.plantToggle:SetDescription(msg) end)
                local t = os.clock()
                while running and PL.on and os.clock() - t < 15 do task.wait(0.25) end
            end
        end)
    end,
})

