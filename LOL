-- Floating progress bar (top of the screen)
function Odyssey:OdysseyProgressWidget(win, o)
    local lo, hi = (o.Range and o.Range[1]) or 0, (o.Range and o.Range[2]) or 100
    local f = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.side, Size = UDim2.new(0, 320, 0, 40), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 12), Parent = win.Gui})
    Odyssey:OdysseyCorner(f, 6)
    Odyssey:OdysseyStroke(f)
    local t = Odyssey:OdysseyText({Text = tostring(o.Name or ""), Size = 11, Pos = UDim2.new(0, 10, 0, 6), Sz = UDim2.new(1, -60, 0, 14), Parent = f})
    local pct = Odyssey:OdysseyText({Text = "0%", Size = 11, Color = C.accent, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0),
        Pos = UDim2.new(1, -10, 0, 6), Sz = UDim2.new(0, 50, 0, 14), Parent = f})
    local bar = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.dark, Size = UDim2.new(1, -20, 0, 5), Position = UDim2.new(0, 10, 1, -12), Parent = f})
    Odyssey:OdysseyCorner(bar, 3)
    local fill = Odyssey:OdysseyNew("Frame", {BackgroundColor3 = C.accent, Size = UDim2.new(0, 0, 1, 0), Parent = bar})
    Odyssey:OdysseyCorner(fill, 3)
    local w = {}
    function w:Set(x)
        local v = x
        if type(x) == "table" then
            if x.Name then t.Text = tostring(x.Name) end
            v = x.Value
        end
        v = tonumber(v)
        if v then
            local a = hi > lo and math.clamp((v - lo) / (hi - lo), 0, 1) or 0
            fill.Size = UDim2.new(a, 0, 1, 0)
            pct.Text = math.floor(a * 100 + 0.5) .. "%"
        end
    end
    function w:Destroy() f:Destroy() end
    w:Set({Value = o.CurrentValue or lo})
    Odyssey:OdysseyDrag(f, f, nil)
    return w
end

