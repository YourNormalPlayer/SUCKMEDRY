    Odyssey:OdysseyBase(el, row, nil)
    Odyssey:OdysseyIndex(sec, row, o.Name, "")
    return el
end

-- ========== Functions · Tabs ==========

-- Methods every tab (and section) gets
function Odyssey:OdysseyTabApi(page)
    local tab = {Page = page}
    -- tab:SubTab("Field") puts the next sections under one top tab called Field; tab:SubTab(nil) goes back to one top tab per section
    function tab:SubTab(name)
        page.subTab = name
        page.col = 1
        page.section = nil
        page.lastByCol = {}
    end
    function tab:CreateSection(o)
        local name, side = o, nil
        if type(o) == "table" then
            name, side = o.Name, o.Side
            if o.SubTab ~= nil then tab:SubTab(o.SubTab) end
        end
        local col = (side == "Right" and 2) or (side == "Left" and 1) or page.col
        local sec = Odyssey:OdysseySection(page, name, col)
        local api = {}
        for _, m in ipairs({"CreateToggle", "CreateDropdown", "CreateSlider", "CreateButton", "CreateLabel", "CreateParagraph",
            "CreateInput", "CreateBind", "CreateKeybind", "CreateStat", "CreateProgress"}) do
            api[m] = function(_, opts)
                local keep = page.section
                page.section = sec
                local el = tab[m](tab, opts)
                page.section = keep
                return el
            end
        end
        function api:Set(n)
            local head = sec.card.Body.Head
            local l = head:FindFirstChildOfClass("TextLabel")
            if l then l.Text = tostring(n or ""):upper() end
            head.Visible = (n or "") ~= ""
        end
        return api
    end
    function tab:Side(s)
        page.col = (s == "Right") and 2 or 1
        page.section = page.lastByCol[page.col]
    end
    function tab:CreateToggle(o) return Odyssey:OdysseyToggle(page, o or {}) end
    function tab:CreateDropdown(o) return Odyssey:OdysseyDropdown(page, o or {}) end
    function tab:CreateSlider(o) return Odyssey:OdysseySlider(page, o or {}) end
    function tab:CreateButton(o) return Odyssey:OdysseyButton(page, o or {}) end
    function tab:CreateLabel(o) return Odyssey:OdysseyLabel(page, o or {}) end
    function tab:CreateParagraph(o) return Odyssey:OdysseyParagraph(page, o or {}) end
    function tab:CreateInput(o) return Odyssey:OdysseyInput(page, o or {}) end
    function tab:CreateBind(o) return Odyssey:OdysseyBind(page, o or {}) end
    tab.CreateKeybind = tab.CreateBind
    function tab:CreateStat(o) return Odyssey:OdysseyStat(page, o or {}) end
    function tab:CreateProgress(o) return Odyssey:OdysseyProgress(page, o or {}) end
    return tab
end

-- New tab page
function Odyssey:OdysseyPage(win, o, kind)
    local frame = Odyssey:OdysseyNew("ScrollingFrame", {
        Name = "Page_" .. tostring(o.Name),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.border,
        VerticalScrollBarInset = Enum.ScrollBarInset.None,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        Parent = win._content,
    })
    local page = {win = win, frame = frame, kind = kind or "tab", name = o.Name, group = o.Group, order = tonumber(o.Order) or 99,
        idx = #win._pages + 1, col = 1, lastByCol = {}}
    if page.kind == "tab" then
        local colsFrame = Odyssey:OdysseyNew("Frame", {Name = "Columns", BackgroundTransparency = 1, Size = UDim2.new(1, -14, 0, 0),
            Position = UDim2.new(0, 7, 0, 7), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, Parent = frame})
        Odyssey:OdysseyPad(colsFrame, 0, 0, 7, 0)
        local cols = {}
        for i = 1, 2 do
            cols[i] = Odyssey:OdysseyNew("Frame", {Name = "Col" .. i, BackgroundTransparency = 1, Size = UDim2.new(0.5, -3, 0, 0),
                Position = UDim2.new((i - 1) * 0.5, (i - 1) * 3, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = colsFrame})
            local l = Odyssey:OdysseyList(cols[i], 6)
            l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Odyssey:OdysseyFill(win, page) end)
        end
        page.root = {cards = {}, cols = cols, colsFrame = colsFrame}
        table.insert(win._roots, page.root)
        frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() Odyssey:OdysseyFill(win, page) end)
    end
    table.insert(win._pages, page)
    return page
end

